    "discordcdn.com",
    # Видео YouTube здесь НЕТ: оно в BUILTIN_DIRECT_DOMAINS — встроено и не
    # зависит от этого списка/файла (см. комментарий выше). youtube.googleapis.com
    # и youtubei.googleapis.com — в ALWAYS_PROXY_DOMAINS: напрямую недоступны.
]
DIRECT_DOMAINS_FILE = CONF / "direct_domains.txt"
# Ручные оверрайды маршрута домена:
#   {"<домен>": {"path": "proxy"|"direct", "reason": "...", "ts": 1792645769}}
# Ставятся командой `omavpn route set` (и автоматически — аудитом маршрутов).
# Они сильнее всего остального: домен с "proxy" не попадёт в direct-правило,
# даже если zapret-autotune запихал его в direct_domains.txt.
ROUTE_OVERRIDES_FILE = CONF / "route_overrides.json"
ROUTE_PATHS = ("proxy", "direct")

# Один mutex на все действия, которые трогают запущенный VPN: on/off/restart,
# route set/unset. Рестартеров теперь четверо — таймеры аудита маршрутов,
# перепроверка оверрайдов, guard и кнопки виджета — и без общей блокировки два
# `cmd_on` одновременно сносят друг другу процессы (первый stop_proc убивает
# туннель, который только что поднял второй).
CTRL_LOCK = STATE / "ctrl.lock"

# Домен для оверрайда: обычное DNS-имя в нижнем регистре. Шаблоны (`*.x.com`),
# IP, `#комментарии`, пустые метки и кириллица не поддерживаются: sing-box
# сопоставляет domain_suffix, и «почти домен» молча не сработал бы.
DOMAIN_RE = re.compile(r"^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}$")


def warn(msg: str) -> None:
    """Предупреждение в stderr — stdout занят JSON'ом для виджета."""
    print(f"omavpn: {msg}", file=sys.stderr)


def _num(value, default: int = 0, low: int | None = None, high: int | None = None) -> int:
    """Безопасное целое из JSON/настроек — мусор не роняет `status()`.

    Настройки, state.json и probe.json пишут разные процессы (CLI, виджет,
    аудит), и один испорченный файл не должен превращать `--json status` в
    трейсбек: виджет тогда считает, что VPN не установлен. `bool` отбрасываем —
    True это не индекс, а случайное значение. `low`/`high` зажимают диапазон.
    """
    try:
        if isinstance(value, bool):
            raise TypeError
        num = int(float(value))
    except (TypeError, ValueError, OverflowError):
        return default
    if low is not None and num < low:
        return low
    if high is not None and num > high:
        return high
    return num


def norm_domain(value: str) -> str:
    return value.strip().strip(".").lower()


def valid_domain(domain: str) -> bool:
    """Годится ли строка в domain_suffix sing-box — БЕЗ молчаливой починки.

    Проверяется то, что ввёл пользователь: регистр и пробелы по краям прощаем,
    точку в конце FQDN — тоже, но ведущую точку и пустые метки (`..example.com`,
    `a..b`) отклоняем. Раньше `norm_domain` срезал точки и `..example.com`
    превращался в `example.com`: опечатка выглядела как успешная команда, а
    `domain_suffix` в sing-box — не regex, и «почти домен» молча не совпал бы.
    """
    dom = str(domain).strip().lower()
    if not dom or ".." in dom or dom.startswith("."):
        return False
    return bool(DOMAIN_RE.fullmatch(dom.rstrip(".")))


# Глубина вложенности ctrl_lock: cmd_on внутри route_set (перезапуск после
# смены правила) не должен упираться в собственный же лок.
_ctrl_lock = {"depth": 0}

# Пауза между повторами захвата лока для быстрых операций (`--no-restart`).
CTRL_LOCK_RETRY_DELAY = 0.2


@contextlib.contextmanager
def ctrl_lock(retries: int = 0):
    """Эксклюзивный (неблокирующий) лок на управление VPN.

    Неблокирующий намеренно: лучше честно сказать «занято», чем подвесить
    виджет на минуту, пока идёт чужой heal или аудит маршрутов.

    `retries` — короткие повторы для быстрых операций (`route set --no-restart`):
    аудит ставит десяток правил подряд, и падать на «занято» всей пачкой из-за
    чужого секундного лока бессмысленно. Для действий, поднимающих VPN, повторы
    не нужны — там лок держится долго, и ждать его бессмысленно.
    """
    if _ctrl_lock["depth"]:
        _ctrl_lock["depth"] += 1
        try:
            yield
        finally:
            _ctrl_lock["depth"] -= 1
        return
    STATE.mkdir(parents=True, exist_ok=True)
    fd = os.open(CTRL_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    for attempt in range(max(0, int(retries)) + 1):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if attempt >= retries:
                os.close(fd)
                raise RuntimeError("другой процесс управляет VPN (перезапуск, аудит "
                                   "маршрутов или heal) — повторите через несколько секунд")
            time.sleep(CTRL_LOCK_RETRY_DELAY)
    try:
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode())
    except OSError:
        pass
    _ctrl_lock["depth"] = 1
    try:
        yield
    finally:
        _ctrl_lock["depth"] = 0
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def route_overrides() -> dict:
    """Читает оверрайды маршрутов из ~/.config/omavpn/route_overrides.json.

    Битый или нечитаемый файл не повод падать: предупреждаем в stderr и считаем
    список пустым. Иначе один недописанный JSON оставил бы без конфига весь
    маршрут (а виджет — без статуса).
    """
    try:
        raw = ROUTE_OVERRIDES_FILE.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as exc:
        warn(f"не читается {ROUTE_OVERRIDES_FILE}: {exc} — оверрайды игнорирую")
        return {}
    if not raw.strip():
        return {}
    try:
        data = json.loads(raw)
    except ValueError as exc:
        warn(f"битый JSON в {ROUTE_OVERRIDES_FILE} ({exc}) — оверрайды игнорирую")
        return {}
    if not isinstance(data, dict):
        warn(f"{ROUTE_OVERRIDES_FILE}: ожидался объект «домен → оверрайд» — игнорирую")
        return {}
    result: dict = {}
    for key, value in data.items():
        dom = norm_domain(str(key))
        if not dom:
            continue
        if isinstance(value, str):  # короткая форма: {"домен": "proxy"}
            value = {"path": value}
        if not isinstance(value, dict):
            warn(f"{ROUTE_OVERRIDES_FILE}: оверрайд {dom} не объект — пропускаю")
            continue
        path = str(value.get("path") or "").strip().lower()
        if path not in ROUTE_PATHS:
            warn(f"{ROUTE_OVERRIDES_FILE}: у {dom} неизвестный путь {path!r} — пропускаю")
            continue
        try:
            ts = int(value.get("ts") or 0)
        except (TypeError, ValueError):
            ts = 0
        result[dom] = {"path": path, "reason": str(value.get("reason") or "").strip(),
                       "ts": ts}
    return result


def save_route_overrides(data: dict) -> None:
    save_json(ROUTE_OVERRIDES_FILE, data)


def proxy_domains(overrides: dict | None = None) -> list:
    """Домены, которые обязаны идти через VPN (правило ПЕРЕД direct)."""
    over = route_overrides() if overrides is None else overrides
    forced_direct = {dom for dom, ent in over.items() if ent["path"] == "direct"}
    result = [dom for dom in ALWAYS_PROXY_DOMAINS if dom not in forced_direct]
    for dom, ent in over.items():
        if ent["path"] == "proxy" and dom not in result:
            result.append(dom)
    return result


def direct_domains() -> list:
    """Список direct-правила: ALWAYS_DIRECT + встроенные + файл/умолчания + оверрайды.

    Приоритет (он же порядок правил в build_singbox):
    override → ALWAYS_PROXY_DOMAINS → direct_domains.txt → final=proxy.
    Поэтому домены, которым положено идти в туннель, отсюда вычищаются — даже
    если их записал zapret-autotune (этот файл он перезаписывает сам).

    BUILTIN_DIRECT_DOMAINS (видео YouTube) идут ПЕРЕД файлом: автотюн не должен
    уводить видеотрафик в туннель. Снять их оттуда может только оверрайд
    `route set <домен> proxy` — правило proxy стоит первым.
    """
    over = route_overrides()
    proxied = set(proxy_domains(over))
    result: list[str] = []

    def add(dom: str) -> None:
        dom = norm_domain(dom)
        if dom and not dom.startswith("#") and dom not in proxied and dom not in result:
            result.append(dom)

    for dom in ALWAYS_DIRECT_DOMAINS:
        add(dom)
    for dom in BUILTIN_DIRECT_DOMAINS:
        add(dom)
    # Файл читается общим разборщиком: комментарии, пустые строки и мусор.
    for dom in _direct_file_domains()[0]:
        add(dom)
    for dom, ent in over.items():
        if ent["path"] == "direct":
            add(dom)
    return result


def fmt_age(seconds) -> str:
    if seconds is None:
        return "—"
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds} с"
    if seconds < 3600:
        return f"{seconds // 60} мин"
    if seconds < 86400:
        return f"{seconds // 3600} ч"
    return f"{seconds // 86400} д"


def _parse_direct_lines(lines: list) -> list:
    """Домены из direct_domains.txt: `#` — комментарий, в том числе в конце строки.

    Докстринг файла обещал комментарии, а строки читались дословно: `example.com
    # мой домен` и случайный мусор попадали в `domain_suffix` sing-box как есть.
    Теперь строка режется по `#`, пустые пропускаются, а невалидная строка даёт
    предупреждение в stderr (stdout занят JSON для виджета) и не попадает в конфиг.
    """
    out: list[str] = []
    for raw in lines:
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        dom = norm_domain(line)
        if not valid_domain(dom):
            warn(f"{DIRECT_DOMAINS_FILE}: строка {raw.strip()!r} — не домен, пропускаю")
            continue
        if dom not in out:
            out.append(dom)
    return out


def _direct_file_domains() -> tuple[list, bool]:
    """(домены из файла, файл задан пользователем).

    Существующий файл — источник истины, даже если он пустой: именно так
    `zapret-autotune` в режиме `vpn` пишет «всё в туннель» (`set_direct ""`).
    Если подставлять в этом случае DEFAULT, Discord/YouTube уходят напрямую —
    то есть в блокировку, ровно там, где обход не работает. DEFAULT берём
    только когда файла нет вовсе.

    Файл, где есть одни комментарии, тоже считается заданным (второй элемент —
    True), и domains будет пустым: это осознанное решение. Автотюн комментариев
    не пишет, а человек, оставивший в файле заметку и ни одного домена, скорее
    всего не хотел молча вернуть встроенный список — молчание файла честнее
    показывает `omavpn route list` (источник `file`, доменов нет).
    """
    try:
        raw = DIRECT_DOMAINS_FILE.read_text(encoding="utf-8")
    except OSError:
        return list(DEFAULT_DIRECT_DOMAINS), False
    parsed = _parse_direct_lines(raw.splitlines())
    return parsed, bool(raw.strip())


def _rule_hit(dom: str, rule: list):
    """Первое правило группы, которое ловит домен: сначала точное, потом суффикс.

    sing-box сопоставляет domain_suffix — «домен или его поддомен по границе
    метки», поэтому `foo.youtubei.googleapis.com` попадает в правило
    `youtubei.googleapis.com`, а `notyoutubei.googleapis.com` — нет. Раньше здесь
    стоял голый `endswith`, и проверка расходилась с поведением sing-box.
    """
    for entry in rule:
        if dom == entry[0]:
            return entry
    for entry in rule:
        if dom.endswith("." + entry[0]):
            return entry
    return None


def route_entries() -> list:
    """Полная картина маршрутов для `omavpn route list`.

    Путь каждого домена считается **проходом по правилам в их порядке** —
    ровно как это сделает sing-box:
    proxy-правило (override proxy + ALWAYS_PROXY_DOMAINS) → direct-правило
    (ALWAYS_DIRECT + direct_domains.txt + оверрайды direct) → final=proxy.
    Поэтому таблица не может разойтись с конфигом: поддомен `youtubei.
    googleapis.com` показывается как proxy, даже если родитель лежит в
    direct_domains.txt.
    """
    over = route_overrides()
    now = int(time.time())
    file_domains, file_exists = _direct_file_domains()
    forced_direct = {dom for dom, ent in over.items() if ent["path"] == "direct"}
    proxy_over = [(dom, ent) for dom, ent in over.items() if ent["path"] == "proxy"]
    direct_over = [(dom, ent) for dom, ent in over.items() if ent["path"] == "direct"]

    # Каждая группа — одно правило build_singbox: (домен, источник, причина, ts).
    proxy_rule: list = [(dom, "always", "", 0)
                        for dom in ALWAYS_PROXY_DOMAINS if dom not in forced_direct]
    proxy_rule += [(dom, "override", ent["reason"], ent["ts"]) for dom, ent in proxy_over]
    # Оверрайды direct — первыми в группе: путь от этого не меняется, но источник
    # должен быть честным (`override`, а не `default-direct`/`file`), иначе
    # `route list` прячет решение человека за встроенным списком.
    direct_rule: list = [(dom, "override", ent["reason"], ent["ts"])
                         for dom, ent in direct_over]
    direct_rule += [(dom, "always", "", 0) for dom in ALWAYS_DIRECT_DOMAINS]
    # Видео YouTube: встроенный список, приоритетнее direct_domains.txt.
    direct_rule += [(dom, "default-direct", "", 0) for dom in BUILTIN_DIRECT_DOMAINS]
    direct_rule += [(dom, "file" if file_exists else "default", "", 0)
                    for dom in file_domains]
    rules = (("proxy", proxy_rule), ("direct", direct_rule))

    known: list = []
    for _, rule in rules:
        for entry in rule:
            if entry[0] not in known:
                known.append(entry[0])

    rows = []
    for dom in known:
        path, source, reason, ts = "proxy", "final", "", 0
        for group_path, rule in rules:
            hit = _rule_hit(dom, rule)
            if hit:
                path, source, reason, ts = group_path, hit[1], hit[2], int(hit[3] or 0)
                break
        rows.append({"domain": dom, "path": path, "source": source, "reason": reason,
                     "ts": ts, "age": max(0, now - ts) if ts else None})
    return sorted(rows, key=lambda row: (row["path"] != "proxy", row["domain"]))


def route_table_text(rows: list) -> str:
    if not rows:
        return "маршруты не заданы"
    width = max(len(row["domain"]) for row in rows)
    # Ширина колонки источника считается, а не задана числом: `default-direct`
    # длиннее остальных источников и разъезжался с заголовком.
    src_width = max([len("источник")] + [len(row["source"]) for row in rows])
    head = (f"{'домен':<{width}}  {'путь':<6}  {'источник':<{src_width}}  {'возраст':<7}  причина")
    lines = [head, "-" * len(head)]
    for row in rows:
        lines.append(f"{row['domain']:<{width}}  {row['path']:<6}  "
                     f"{row['source']:<{src_width}}  "
                     f"{fmt_age(row['age']):<7}  {row['reason']}")
    return "\n".join(lines)


def _restart_after_route_change() -> tuple[bool, str]:
    """Перезапускает VPN, чтобы новый маршрут вступил в силу.

    Если VPN выключен — ничего не делаем: конфиг соберётся при следующем `on`.
    Возвращает (перезапущено, пояснение).
    """
    if not is_on():
        return False, "VPN выключен — правило применится при следующем подключении"
    cmd_on(None, None, None, quiet=True)
    return True, ""


MAX_ROUTE_REASON = 200


def _route_domain_input(domain: str) -> str:
    """Достаёт домен из того, что человек скопировал в браузере.

    Принимается и чистый домен, и ссылка: `https://x.com/path?q=1`,
    `//user:pass@sub.example.co.uk:8080/a`, `яндекс.рф`. Отбрасываем схему,
    путь/запрос/якорь, логин-пароль и порт — дальше строка проверяется теми же
    `valid_domain()`/`norm_domain()`, поэтому мусор по-прежнему отвергается.
    IPv6 (`[::1]`) намеренно не разбираем: двоеточий больше одного, и до
    валидации он дойдёт как есть — с понятной ошибкой.
    """
    text = str(domain or "").strip()
    # Схема: http://, https:// и protocol-relative //x.com
    text = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.\-]*://", "", text)
    if text.startswith("//"):
        text = text[2:]
    # Путь, query и якорь — всё после первого такого символа не домен.
    text = re.split(r"[/?#]", text, maxsplit=1)[0]
    # user:pass@host — берём хост после последнего «@».
    if "@" in text:
        text = text.rsplit("@", 1)[1]
    # Порт: только цифры после одного двоеточия. `example.com:abc` — не порт,
    # такую опечатку лучше показать ошибкой, а не молча превратить в домен.
    text = re.sub(r":\d{1,5}$", "", text)
    # Кириллический домен → punycode: sing-box понимает только ASCII. Если
    # кодирование не удалось, строку не трогаем — валидация ниже скажет, что
    # именно не так.
    if text and not text.isascii():
        try:
            text = text.encode("idna").decode("ascii")
        except (UnicodeError, ValueError):
            pass
    return text


def _route_domain(domain: str) -> str:
    """Проверенный домен для `route set`/`route unset` — одно поведение у обеих.

    Раньше `route set` домен отвергал, а `route unset` молча нормализовал
    (`..Example.COM ` снимал оверрайд `example.com`), то есть на невалидный ввод
    две команды отвечали по-разному.

    Ссылку из адресной строки браузера тоже принимаем (`_route_domain_input`):
    человек копирует `https://x.com/страница`, а не отдельный хост. Проверка
    после разбора та же, поэтому аудит со своими чистыми доменами ничего не
    замечает.
    """
    text = _route_domain_input(domain)
    if not valid_domain(text):
        raise RuntimeError(
            f"некорректный домен: {str(domain or '').strip()!r} — вставь ссылку или домен, "
            "например https://x.com или x.com")
    return norm_domain(text)


def _route_reason(reason: str) -> str:
    """Причина оверрайда: обрезаем хвост, чтобы не раздувать файл и вывод."""
    text = str(reason or "").strip()
    if len(text) > MAX_ROUTE_REASON:
        warn(f"причина длиннее {MAX_ROUTE_REASON} символов — обрезаю")
        text = text[:MAX_ROUTE_REASON]
    return text


def route_set(domain: str, path: str, reason: str = "", restart: bool = True) -> dict:
    """Ставит оверрайд маршрута домена и (по умолчанию) перезапускает VPN.

    Идемпотентна: если домен уже идёт этим путём, файл не трогается и VPN не
    перезапускается (аудит ставит десяток правил подряд и перезапускает один раз).

    Домен проверяется **до** нормализации: `..example.com` — отказ, а не тихое
    `example.com`. При `--no-restart` лок берётся с короткими повторами: аудит
    ставит правила пачкой, и секундный чужой лок не должен рушить всю пачку.
    """
    dom = _route_domain(domain)
    path = str(path).strip().lower()
    if path not in ROUTE_PATHS:
        raise RuntimeError(f"неизвестный путь: {path!r} (нужно proxy или direct)")
    reason = _route_reason(reason)
    with ctrl_lock(0 if restart else 4):
        over = route_overrides()
        current = over.get(dom) or {}
        previous = str(current.get("path") or "")
        if previous == path:
            return {"ok": True, "domain": dom, "path": path, "previous": previous,
                    "reason": str(current.get("reason") or reason), "changed": False,
                    "restarted": False, "note": "путь не изменился — перезапуск не нужен"}
        over[dom] = {"path": path, "reason": reason, "ts": int(time.time())}
        save_route_overrides(over)
        restarted, note = (False, "без перезапуска (--no-restart)")
        if restart:
            restarted, note = _restart_after_route_change()
    return {"ok": True, "domain": dom, "path": path, "previous": previous,
            "reason": reason, "changed": True, "restarted": restarted, "note": note}


def route_unset(domain: str, restart: bool = True) -> dict:
    """Снимает оверрайд домена (домен возвращается к обычному приоритету правил).

    Домен проверяется так же, как в `route set`: обе команды должны одинаково
    реагировать на `..Example.COM` и прочий мусор.
    """
    dom = _route_domain(domain)
    with ctrl_lock(0 if restart else 4):
        over = route_overrides()
        previous = over.pop(dom, None)
        if previous is not None:
            save_route_overrides(over)
        restarted, note = (False, "")
        if restart and previous is not None:
            restarted, note = _restart_after_route_change()
        elif previous is not None:
            note = "без перезапуска (--no-restart)"
    return {"ok": True, "domain": dom, "removed": previous is not None,
            "previous": (previous or {}).get("path", ""), "restarted": restarted,
            "note": note}

DEFAULT_SETTINGS = {
    "profile_index": 0,
    "node_index": -1,
    "mode": "tun",
    "strict_route": False,
    # Re:filter включён по умолчанию: список заблокированного в РФ и есть то,
    # ради чего туннель держат. Файлы кэша качает `refilter update` (и установщик).
    "refilter": True,
}


# --------------------------------------------------------------------------- #
# утилиты
# --------------------------------------------------------------------------- #

def ensure_dirs() -> None:
    for d in (BIN, CONF, STATE, CACHE):
        d.mkdir(parents=True, exist_ok=True)
    os.chmod(BIN, 0o755)
    for d in (CONF, STATE, CACHE):
        os.chmod(d, 0o700)


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, ValueError, OSError):
        return default


def save_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(data, ensure_ascii=False, indent=2))
    os.replace(tmp, path)
    os.chmod(path, 0o600)


def settings() -> dict:
    """Настройки; битый/чужой JSON не повод падать (иначе падает весь status)."""
    data = load_json(SETTINGS, {})
    s = dict(DEFAULT_SETTINGS)
    if isinstance(data, dict):
        s.update(data)
    else:
        warn(f"{SETTINGS}: ожидался объект настроек — беру умолчания")
    return s


def set_settings(**kw) -> dict:
    s = settings()
    s.update(kw)
    save_json(SETTINGS, s)
    return s


def fail(msg: str, code: int = 1):
    """Ошибка: JSON (при --json) — в stdout, текст — в stderr; rc≠0.

    Потребители (`bypass-status`, виджет, аудит) читают stdout: JSON ошибки в
    stderr они не видели и считали, что команда просто молча ничего не сделала.
    """
    if JSON_OUT:
        print(json.dumps({"ok": False, "error": msg}, ensure_ascii=False))
    else:
        print(msg, file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------------- #
# подписка
# --------------------------------------------------------------------------- #

def subscription_url() -> str:
    """URL подписки: сначала OMAVPN_SUB_URL, затем ~/.config/omavpn/subscription."""
    url = os.environ.get("OMAVPN_SUB_URL", "").strip()
    if url:
        return url
    try:
        return (CONF / "subscription").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def subscription_get() -> dict:
    """Текущий URL и его источник: переменная окружения важнее файла."""
    env = os.environ.get("OMAVPN_SUB_URL", "").strip()
    file_url = ""
    try:
        file_url = SUBSCRIPTION_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        file_url = ""
    return {"ok": True, "url": subscription_url(), "file": str(SUBSCRIPTION_FILE),
            "file_url": file_url, "env": bool(env),
            "source": "env" if env else ("file" if file_url else "")}


def _valid_sub_url(url: str) -> str:
    """Проверенный URL подписки: http(s) и непустой хост.

    Мусор в этом файле ломает не только `update`, но и автозапуск: `on` падает
    на разборе подписки, и VPN не поднимается вовсе. Поэтому проверяем до записи.
    """
    text = str(url or "").strip()
    if not text:
        raise RuntimeError("пустой URL подписки")
    if any(ch.isspace() for ch in text):
        raise RuntimeError("в URL подписки пробел — проверь строку")
    try:
        parts = urllib.parse.urlsplit(text)
        host = parts.hostname
    except ValueError as exc:
        raise RuntimeError(f"URL подписки не разбирается: {exc}") from exc
    if parts.scheme not in ("http", "https"):
        raise RuntimeError("URL подписки должен начинаться с http:// или https:// "
                           f"(сейчас: {parts.scheme or 'без схемы'})")
    if not host:
        raise RuntimeError("в URL подписки нет хоста")
    return text


def _write_subscription(text: str) -> None:
    """Атомарная запись файла подписки (0600): права не должны зависеть от umask."""
    SUBSCRIPTION_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = SUBSCRIPTION_FILE.with_name(SUBSCRIPTION_FILE.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, SUBSCRIPTION_FILE)
    os.chmod(SUBSCRIPTION_FILE, 0o600)


def subscription_set(url: str, restart: bool = True) -> dict:
    """Меняет URL подписки, сразу проверяя его загрузкой.

    Старый URL не теряется: сначала сохраняем новый и пробуем `update_sub()`,
    а при ошибке (опечатка, 404, сеть) возвращаем прежний файл — иначе человек
    остаётся и с нерабочим адресом, и без данных подписки.
    """
    if os.environ.get("OMAVPN_SUB_URL", "").strip():
        raise RuntimeError(
            "URL подписки переопределён переменной OMAVPN_SUB_URL — она важнее файла "
            f"{SUBSCRIPTION_FILE}. Убери переменную и повтори")
    new = _valid_sub_url(url)
    old_exists = SUBSCRIPTION_FILE.exists()
    old_text = ""
    if old_exists:
        try:
            old_text = SUBSCRIPTION_FILE.read_text(encoding="utf-8")
        except OSError as exc:
            raise RuntimeError(f"не читается {SUBSCRIPTION_FILE}: {exc}") from exc
    previous = old_text.strip()
    if new == previous:
        # Тот же адрес: ни сети, ни перезапуска — идемпотентно, как route set.
        return {"ok": True, "url": new, "previous": previous, "changed": False,
                "url_changed": False, "restarted": False}
    _write_subscription(new + "\n")
    try:
        update_sub()
    except Exception:  # noqa: BLE001 — откат при любой ошибке загрузки/разбора
        try:
            if old_exists:
                _write_subscription(old_text if old_text.endswith("\n") or not old_text
                                    else old_text + "\n")
            else:
                SUBSCRIPTION_FILE.unlink(missing_ok=True)
        except OSError as exc:
            warn(f"не удалось вернуть прежний URL подписки: {exc}")
        raise
    restarted = False
    error = ""
    if restart and is_on():
        try:
            cmd_on(None, None, None, quiet=True)
            restarted = True
        except Exception as exc:  # noqa: BLE001
            # Откатывать URL здесь нельзя: новый адрес уже проверен загрузкой и
            # sub.json перезаписан им — откат стёр бы рабочие данные. Проблема
            # только в перезапуске, поэтому говорим о ней прямо.
            error = "адрес сменён, но VPN не перезапустился: " + str(exc)
    payload = {"ok": not error, "url": new, "previous": previous, "changed": True,
               "url_changed": True, "restarted": restarted}
    if error:
        payload["error"] = error
    return payload


# --------------------------------------------------------------------------- #
# парсер share-link подписок (vless / vmess / trojan / shadowsocks / socks)
# --------------------------------------------------------------------------- #

def _b64decode_text(text: str) -> str:
    try:
        return base64.b64decode(text + "=" * (-len(text) % 4)).decode("utf-8", "replace")
    except Exception:  # noqa: BLE001
        return ""


def _default_inbounds() -> list:
    return [
        {"tag": "socks-in", "listen": "127.0.0.1", "port": SOCKS_PORT,
         "protocol": "socks", "settings": {"udp": True}},
        {"tag": "http-in", "listen": "127.0.0.1", "port": HTTP_PORT, "protocol": "http"},
    ]


def _default_outbounds() -> list:
    return [
        {"tag": "direct", "protocol": "freedom"},
        {"tag": "block", "protocol": "blackhole"},
    ]


def _qs(query: str) -> dict:
    return {k: v[0] for k, v in urllib.parse.parse_qs(query, keep_blank_values=True).items()}


def _truthy(value) -> bool:
    return str(value).lower() in ("1", "true", "yes")


def _stream_settings(net, security, p: dict, host: str) -> dict:
    net = (net or "tcp").lower()
    if net == "h2":
        net = "http"
    security = (security or "none").lower()
    sni = p.get("sni") or p.get("peer") or host
    ss: dict = {"network": net, "security": security}
    if security == "tls":
        tls: dict = {"serverName": sni}
        if _truthy(p.get("allowinsecure") or p.get("allowInsecure")):
            tls["allowInsecure"] = True
        if p.get("fp"):
            tls["fingerprint"] = p["fp"]
        if p.get("alpn"):
            tls["alpn"] = [a for a in p["alpn"].split(",") if a]
        ss["tlsSettings"] = tls
    elif security in ("reality", "xtls"):
        rs: dict = {"serverName": sni}
        if p.get("pbk"):
            rs["publicKey"] = p["pbk"]
        if p.get("sid"):
            rs["shortId"] = p["sid"]
        if p.get("fp"):
            rs["fingerprint"] = p["fp"]
        if p.get("spx"):
            rs["spiderX"] = p["spx"]
        ss["security"] = "reality"
        ss["realitySettings"] = rs

    path = p.get("path") or "/"
    hdr_host = p.get("host") or sni
    service = p.get("servicename") or p.get("service") or ""
    if net == "ws":
        ws: dict = {"path": path}
        if hdr_host:
            ws["headers"] = {"Host": hdr_host}
        ss["wsSettings"] = ws
    elif net == "grpc":
        gs: dict = {"serviceName": service}
        if p.get("mode") == "multi":
            gs["multiMode"] = True
        ss["grpcSettings"] = gs
    elif net == "httpupgrade":
        hu: dict = {"path": path}
        if hdr_host:
            hu["host"] = hdr_host
        ss["httpupgradeSettings"] = hu
    elif net == "xhttp":
        xs: dict = {"path": path}
        if hdr_host:
            xs["host"] = hdr_host
        if p.get("mode"):
            xs["mode"] = p["mode"]
        ss["xhttpSettings"] = xs
    elif net == "http":
        hs: dict = {}
        if path:
            hs["path"] = path
        if hdr_host:
            hs["host"] = [hdr_host]
        ss["httpSettings"] = hs
    elif net == "tcp" and p.get("headertype") in ("http", "1"):
        ss["tcpSettings"] = {"header": {"type": "http", "request": {
            "path": [path], "headers": {"Host": [hdr_host]}}}}
    return ss


def _config(remarks: str, outbound: dict) -> dict:
    return {
        "remarks": remarks,
        "inbounds": _default_inbounds(),
        "outbounds": [outbound, *_default_outbounds()],
    }


def _parse_vless(url: str) -> dict:
    u = urllib.parse.urlsplit(url)
    p = _qs(u.query)
    host = u.hostname or ""
    port = u.port or 443
    user = {"id": urllib.parse.unquote(u.username or ""), "encryption": "none"}
    if p.get("flow"):
        user["flow"] = p["flow"]
    out = {
        "tag": "proxy", "protocol": "vless",
        "settings": {"vnext": [{"address": host, "port": port, "users": [user]}]},
        "streamSettings": _stream_settings(p.get("type"), p.get("security"), p, host),
    }
    return _config(urllib.parse.unquote(u.fragment) or f"vless-{host}", out)


def _parse_trojan(url: str) -> dict:
    u = urllib.parse.urlsplit(url)
    p = _qs(u.query)
    host = u.hostname or ""
    port = u.port or 443
    out = {
        "tag": "proxy", "protocol": "trojan",
        "settings": {"servers": [{"address": host, "port": port,
                                  "password": urllib.parse.unquote(u.username or "")}]},
        "streamSettings": _stream_settings(p.get("type"), p.get("security") or "tls", p, host),
    }
    return _config(urllib.parse.unquote(u.fragment) or f"trojan-{host}", out)


def _parse_vmess(url: str) -> dict:
    raw = url[len("vmess://"):].strip()
    try:
        data = json.loads(base64.b64decode(raw + "=" * (-len(raw) % 4)).decode("utf-8", "replace"))
    except Exception as exc:  # noqa: BLE001
        raise ValueError(f"не разобран vmess: {exc}") from exc
    host = str(data.get("add") or "")
    port = int(data.get("port") or 443)
    tls = str(data.get("tls") or "")
    p = {
        "type": str(data.get("net") or "tcp"),
        "path": data.get("path"),
        "host": data.get("host"),
        "sni": data.get("sni") or data.get("host"),
        "headertype": str(data.get("type") or ""),
    }
    out = {
        "tag": "proxy", "protocol": "vmess",
        "settings": {"vnext": [{"address": host, "port": port, "users": [
            {"id": str(data.get("id") or ""), "alterId": int(data.get("aid") or 0),
             "security": str(data.get("scy") or "auto")}]}]},
        "streamSettings": _stream_settings(p["type"], "tls" if tls in ("tls", "true", "1") else "none", p, host),
    }
    return _config(str(data.get("ps") or f"vmess-{host}"), out)


def _parse_ss(url: str) -> dict:
    body = url[len("ss://"):]
    name = ""
    if "#" in body:
        body, frag = body.split("#", 1)
        name = urllib.parse.unquote(frag)
    body = body.split("?", 1)[0]
    if "@" in body:
        userinfo, hostpart = body.rsplit("@", 1)
        decoded = _b64decode_text(userinfo)
        method, password = (decoded if ":" in decoded else urllib.parse.unquote(userinfo)).split(":", 1)
    else:
        decoded = _b64decode_text(body)
        creds, hostpart = decoded.rsplit("@", 1)
        method, password = creds.split(":", 1)
    host, port = hostpart.rsplit(":", 1)
    out = {
        "tag": "proxy", "protocol": "shadowsocks",
        "settings": {"servers": [{"address": host, "port": int(port),
                                  "method": method, "password": password}]},
        "streamSettings": {"network": "tcp", "security": "none"},
    }
    return _config(name or f"ss-{host}", out)


def _parse_socks(url: str) -> dict:
    u = urllib.parse.urlsplit(url)
    host = u.hostname or ""
    port = u.port or 1080
    entry: dict = {"address": host, "port": port}
    user = urllib.parse.unquote(u.username or "")
    if user:
        entry["users"] = [{"user": user, "pass": urllib.parse.unquote(u.password or "")}]
    out = {
        "tag": "proxy", "protocol": "socks",
        "settings": {"servers": [entry]},
        "streamSettings": {"network": "tcp", "security": "none"},
    }
    return _config(urllib.parse.unquote(u.fragment) or f"socks-{host}", out)


_SHARE_PARSERS = {
    "vless": _parse_vless,
    "vmess": _parse_vmess,
    "trojan": _parse_trojan,
    "ss": _parse_ss,
    "shadowsocks": _parse_ss,
    "socks": _parse_socks,
    "socks5": _parse_socks,
}

SHARE_LINK_UNSUPPORTED = {"hysteria2", "hy2", "hysteria", "tuic", "wireguard", "wg"}


def parse_share_links(text: str) -> list:
    """Разбирает подписку из share-ссылок в список Xray-конфигов."""
    configs, unsupported = [], set()
    for line in text.replace("\r", "\n").split("\n"):
        line = line.strip()
        if not line or line.startswith("#") or "://" not in line:
            continue
        scheme = line.split("://", 1)[0].lower()
        if scheme in SHARE_LINK_UNSUPPORTED:
            unsupported.add(scheme)
            continue
        parser = _SHARE_PARSERS.get(scheme)
        if not parser:
            unsupported.add(scheme)
            continue
        configs.append(parser(line))
    if not configs and unsupported:
        raise RuntimeError(
            "не удалось разобрать ссылки; неподдерживаемые схемы: "
            + ", ".join(sorted(unsupported))
        )
    return configs


def fetch_sub() -> list:
    url = subscription_url()
    if not url:
        raise RuntimeError(
            "не задан URL подписки: положи его в ~/.config/omavpn/subscription "
            "или задай переменную OMAVPN_SUB_URL"
        )
    req = urllib.request.Request(
        url,
        headers={"User-Agent": USER_AGENT,
                 "Accept": "application/json, text/plain, */*"},
    )
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
        raw = resp.read()
    txt = raw.decode("utf-8", "replace").strip()

    # 1) Happ-формат: JSON (в т.ч. в base64)
    for candidate in (txt, _b64decode_text(txt)):
        if not candidate:
            continue
        try:
            data = json.loads(candidate)
        except ValueError:
            continue
        if isinstance(data, dict):
            data = data.get("data") or data.get("configs") or [data]
        if (isinstance(data, list) and data and all(isinstance(x, dict) for x in data)
                and any("outbounds" in x for x in data)):
            return data

    # 2) обычные share-ссылки (в т.ч. в base64)
    for candidate in (txt, _b64decode_text(txt)):
        if candidate and "://" in candidate:
            configs = parse_share_links(candidate)
            if configs:
                return configs

    raise RuntimeError("подписка не распознана (ни Happ-JSON, ни share-link)")



def get_configs() -> list:
    cache = load_json(SUBFILE, None)
    if isinstance(cache, dict):
        configs = cache.get("configs")
        if isinstance(configs, list) and configs:
            return configs
    raise RuntimeError("нет данных подписки — выполните `omavpn update`")


def update_sub() -> list:
    """Обновляет кэш подписки; файл переписывается только при изменении.

    `update` зовут по таймеру, а каждая перезапись меняла mtime `sub.json` и
    будила наблюдателей (виджет, сторож, аудит) без причины. Поэтому сравниваем
    с тем, что уже лежит в кэше, и при совпадении содержимого файл не трогаем —
    `updated` в нём остаётся временем последнего ФАКТИЧЕСКОГО изменения подписки
    (статус показывает именно его, а не время последней проверки).
    """
    configs = fetch_sub()
    cached = load_json(SUBFILE, None)
    previous = cached.get("configs") if isinstance(cached, dict) else None
    if previous != configs:
        save_json(SUBFILE, {"updated": time.time(), "configs": configs})
    # Настройки пересохраняем только при фактическом изменении: новый файл или
    # недостающие ключи умолчаний — уже изменение, тогда пишем.
    s = settings()
    current = load_json(SETTINGS, None)
    if not isinstance(current, dict) or current != s:
        save_json(SETTINGS, s)
    return configs


# --------------------------------------------------------------------------- #
# Re:filter — заблокированные в РФ домены и IP
# --------------------------------------------------------------------------- #
# Списки лежат локально бинарными rule-set'ами sing-box: конфиг собирается без
# обращения к сети (иначе GitHub в момент запуска решает, поднимется ли VPN), а
# обновление — отдельная команда и таймер.

REFILTER_FETCH_TIMEOUT = 120        # с на файл: GitHub отдаёт ~0,6 МБ быстро
REFILTER_TAG_DOMAIN = "refilter-domain"
REFILTER_TAG_IP = "refilter-ip"
# Бинурый rule-set sing-box (.srs) всегда начинается с этой сигнатуры. Размера
# мало: обрезанный файл или HTML captive-портала тоже бывают больше 10 КБ, а
# проверка «файл есть» пропускала бы их в конфиг — и VPN не поднимался вовсе.
# Бинарный rule-set sing-box (.srs) начинается с b"SRS" + байт версии формата.
# Проверяем версию «>= 1», а не «ровно 1»: жёсткая сигнатура b"SRS\x01" сломала
# бы скачивание в день, когда формат обновят. Глубокую проверку всё равно делает
# `sing-box rule-set decompile`.
SRS_MAGIC = b"SRS"
SRS_MIN_VERSION = 1
# Какие поля обязаны найтись в наборе: домены — domain/domain_suffix, адреса — ip_cidr.
SRS_KEYS = {"domain": ("domain", "domain_suffix"), "ip": ("ip_cidr",)}


def refilter_enabled() -> bool:
    return _truthy(settings().get("refilter", True))


def _file_bytes(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


def _srs_magic_ok(path: Path) -> bool:
    """Дешёвая проверка: это вообще бинарный rule-set, а не HTML/обрезок."""
    try:
        with path.open("rb") as handle:
            head = handle.read(len(SRS_MAGIC) + 1)
    except OSError:
        return False
    if len(head) != len(SRS_MAGIC) + 1 or not head.startswith(SRS_MAGIC):
        return False
    return head[-1] >= SRS_MIN_VERSION


def _srs_decompile_ok(path: Path, kind: str) -> tuple[bool, str]:
    """Разбирает набор настоящим sing-box. → (годен, ошибка).

    `rule-set decompile` — тот же разбор, которым sing-box читает набор при
    старте, поэтому «decompile прошёл» и означает «VPN с этим файлом поднимется».
    Если бинаря sing-box нет, проверку пропускаем: отсутствие инструмента не
    повод считать скачанный список плохим.
    """
    sb = str(SB_BIN) if SB_BIN.is_file() else (shutil.which("sing-box") or "")
    if not sb:
        return True, ""
    REFILTER_DIR.mkdir(parents=True, exist_ok=True)
    out = REFILTER_DIR / f".check-{kind}.{os.getpid()}.json"
    try:
        proc = subprocess.run([sb, "rule-set", "decompile", str(path), "-o", str(out)],
                              capture_output=True, text=True, timeout=60)
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or f"код {proc.returncode}").strip()
            # sing-box красит FATAL в ANSI-цвета — в панели они выглядели бы
            # мусором вокруг текста ошибки.
            err = re.sub(r"\x1b\[[0-9;]*m", "", err)
            return False, "sing-box не разобрал набор: " + err.splitlines()[0][:140]
        try:
            data = json.loads(out.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            return False, f"разбор набора не удался: {exc}"
        keys = SRS_KEYS[kind]
        rules = data.get("rules") if isinstance(data, dict) else None
        for rule in rules or []:
            if not isinstance(rule, dict):
                continue
            for key in keys:
                value = rule.get(key)
                if isinstance(value, list) and value:
                    return True, ""
        return False, "в наборе нет " + "/".join(keys)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"проверка набора не удалась: {exc}"
    finally:
        with contextlib.suppress(OSError):
            out.unlink(missing_ok=True)


REFILTER_TMP_TTL = 3600     # брошенный `.tmp`/`.check-*` старше часа — мусор


def _refilter_cleanup() -> None:
    """Убирает временные файлы прошлых прогонов.

    Имя содержит pid, поэтому после SIGKILL (таймаут юнита, `reset`) `.tmp` и
    `.check-*.json` остаются навсегда. Свои файлы (текущего pid) не трогаем —
    их держит идущий процесс, чужие удаляем, только если они старше TTL.
    """
    if not REFILTER_DIR.is_dir():
        return
    now = time.time()
    mine = f".{os.getpid()}."
    for path in REFILTER_DIR.iterdir():
        name = path.name
        if not name.startswith("."):
            continue
        if not (name.endswith(".tmp") or name.startswith(".check-")):
            continue
        if mine in name:
            continue
        try:
            if now - path.stat().st_mtime < REFILTER_TMP_TTL:
                continue
            path.unlink()
        except OSError:
            pass


def _sha256(path: Path) -> str:
    """sha256 файла; пустая строка, если его нет/не читается.

    По хешу отличаем «файл перекачали» от «содержимое то же»: без этого каждый
    прогон таймера считался бы изменением и перезапускал туннель зря.
    """
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
    except OSError:
        return ""
    return digest.hexdigest()


def refilter_files(deep: bool = False) -> dict:
    """Что лежит в кэше: путь, размер, годность.

    `ok` — это не только размер: сигнатура SRS проверяется всегда (дёшево), а
    `deep=True` дополнительно разбирает набор настоящим sing-box (~0,4 с на оба
    файла). Глубокий режим — только у `refilter status`: его зовут по открытию
    настроек, а не в цикле, зато битый файл видно до перезапуска VPN.
    """
    out = {}
    for kind, path in (("domain", REFILTER_DOMAIN), ("ip", REFILTER_IP)):
        size = _file_bytes(path)
        minimum = REFILTER_MIN_BYTES[kind]
        ok, why = True, ""
        if size < minimum:
            ok, why = False, (f"нет файла" if size == 0
                              else f"мал ({size} Б < {minimum} Б)")
        elif not _srs_magic_ok(path):
            ok, why = False, "не rule_set sing-box (нет сигнатуры SRS)"
        elif deep:
            ok, why = _srs_decompile_ok(path, kind)
        out[kind] = {"path": str(path), "bytes": size, "ok": ok, "error": why}
    return out


def refilter_status() -> dict:
    """Состояние для CLI/виджета. Не падает: битый meta.json — просто нет даты."""
    files = refilter_files(deep=True)
    meta = load_json(REFILTER_META, {})
    meta = meta if isinstance(meta, dict) else {}
    updated = _num(meta.get("updated"), 0)
    sizes = {kind: info["bytes"] for kind, info in files.items()}
    return {"ok": True,
            "enabled": refilter_enabled(),
            "loaded": all(info["ok"] for info in files.values()),
            "files": files,
            "bytes": sizes,
            "total_bytes": sum(sizes.values()),
            "updated": updated,
            # Готовая строка: формат даты одинаков в панели и в CLI, а руками
            # собирать «25.10 19:00» из timestamp в двух местах — расхождения.
            "updated_text": (time.strftime("%d.%m %H:%M", time.localtime(updated))
                             if updated > 0 else ""),
            "source": dict(REFILTER_URLS),
            "min_bytes": dict(REFILTER_MIN_BYTES),
            "meta": str(REFILTER_META)}


def _refilter_download(kind: str) -> tuple[bool, str]:
    """Скачивает один набор во временный файл. → (изменился, ошибка).

    curl пишет в `.<имя>.tmp` рядом, старый .srs подменяется через os.replace
    только после трёх проверок: размер, сигнатура `SRS\\x01` и разбор настоящим
    `sing-box rule-set decompile` с наличием ожидаемых полей. При обрыве сети,
    404, HTML вместо набора или обрезке в кэше остаётся прежний рабочий файл.
    """
    url = REFILTER_URLS[kind]
    target = REFILTER_DOMAIN if kind == "domain" else REFILTER_IP
    minimum = REFILTER_MIN_BYTES[kind]
    REFILTER_DIR.mkdir(parents=True, exist_ok=True)
    tmp = target.with_name(f".{target.name}.{os.getpid()}.tmp")
    try:
        proc = subprocess.run(
            ["curl", "-fsSL", "--retry", "2", "--connect-timeout", "20",
             "--max-time", str(REFILTER_FETCH_TIMEOUT), "-o", str(tmp), url],
            capture_output=True, text=True)
    except OSError as exc:
        return False, f"{kind}: curl не запустился — {exc}"
    try:
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or f"код {proc.returncode}").strip()
            return False, f"{kind}: {err.splitlines()[0][:160]}"
        size = _file_bytes(tmp)
        if size < minimum:
            return False, (f"{kind}: файл подозрительно мал ({size} Б < {minimum} Б) — "
                           "оставил прежний")
        if not _srs_magic_ok(tmp):
            return False, (f"{kind}: скачался не rule_set sing-box (нет сигнатуры SRS) — "
                           "оставил прежний")
        ok, why = _srs_decompile_ok(tmp, kind)
        if not ok:
            return False, f"{kind}: {why} — оставил прежний"
        # Сравниваем только с ГОДНЫМ текущим файлом: битый не должен выдать
        # «изменений нет» и остаться в кэше навсегда.
        old_hash = _sha256(target) if refilter_files()[kind]["ok"] else ""
        if old_hash and old_hash == _sha256(tmp):
            return False, ""      # содержимое то же — файл не трогаем
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
        return True, ""
    finally:
        with contextlib.suppress(OSError):
            tmp.unlink(missing_ok=True)


def refilter_update(restart: bool = True) -> dict:
    """Обновляет оба набора и (если что-то изменилось и VPN включён) перезапускает его.

    При выключенной настройке ничего не качаем и туннель не трогаем: таймер не
    должен рвать VPN каждый день ради списка, который в конфиг не попадает.

    `restart=False` — для тестов: содержимое кэша меняется, работающий туннель
    продолжает жить со старыми правилами до следующего `on`/перезапуска.
    """
    REFILTER_DIR.mkdir(parents=True, exist_ok=True)
    _refilter_cleanup()
    files = refilter_files()
    bytes_map = {kind: info["bytes"] for kind, info in files.items()}
    if not refilter_enabled():
        return {"ok": True, "enabled": False, "skipped": True, "changed": False,
                "changed_files": [], "restarted": False, "bytes": bytes_map,
                "errors": [], "note": "Re:filter выключен — списки не обновляю"}
    changed_files, errors = [], []
    for kind in ("domain", "ip"):
        changed, err = _refilter_download(kind)
        if changed:
            changed_files.append(kind)
        if err:
            errors.append(err)
    files = refilter_files()
    bytes_map = {kind: info["bytes"] for kind, info in files.items()}
    changed = bool(changed_files)
    old_meta = load_json(REFILTER_META, {})
    old_meta = old_meta if isinstance(old_meta, dict) else {}
    # `updated` — время последнего ИЗМЕНЕНИЯ набора, а не последней проверки:
    # статус должен показывать свежесть списка, а не время запуска таймера.
    updated = time.time() if changed else _num(old_meta.get("updated"), 0)
    if not updated and any(info["ok"] for info in files.values()):
        updated = time.time()     # файлы достались от прошлой версии, даты нет
    try:
        save_json(REFILTER_META, {"updated": updated, "checked": time.time(),
                                  "sizes": bytes_map, "source": dict(REFILTER_URLS)})
    except OSError as exc:
        # Каталог может оказаться недоступным после сброса прав: это не повод
        # терять отчёт о том, что скачалось, — просто предупреждаем.
        warn(f"не удалось записать {REFILTER_META}: {exc}")
    restarted = False
    if changed and restart and is_on():
        try:
            cmd_on(None, None, None, quiet=True)
            restarted = True
        except Exception as exc:  # noqa: BLE001 — файлы уже обновлены, это не откат
            errors.append("VPN не перезапустился: " + str(exc))
    return {"ok": not errors, "enabled": True, "skipped": False, "changed": changed,
            "changed_files": changed_files, "restarted": restarted,
            "bytes": bytes_map, "errors": errors, "updated": updated,
            # Готовая строка ошибки для потребителей: виджет показывает d.error,
            # а не сырой JSON из stdout.
            "error": "; ".join(errors) if errors else ""}


def refilter_set(enabled: bool, restart: bool = True) -> dict:
    """Включает/выключает Re:filter. Сохраняет настройку и перезапускает VPN.

    При включении, если списков ещё нет (или они битые), сразу скачиваем их:
    иначе «включил» означало бы «правила не работают до следующего таймера».
    Сбой загрузки настройку не отменяет — о нём говорит `note`.
    """
    set_settings(refilter=bool(enabled))
    fetched, fetch_errors = [], []
    if enabled and not all(info["ok"] for info in refilter_files().values()):
        for kind in ("domain", "ip"):
            ok, err = _refilter_download(kind)
            if ok:
                fetched.append(kind)
            if err:
                fetch_errors.append(err)
    files = refilter_files()
    loaded = all(info["ok"] for info in files.values())
    notes = []
    if enabled and not loaded:
        notes.append("список не загружен — нажми «Обновить»")
    if fetch_errors:
        notes.append("; ".join(fetch_errors))
    restarted = False
    restart_error = ""
    if restart and is_on():
        try:
            cmd_on(None, None, None, quiet=True)
            restarted = True
        except Exception as exc:  # noqa: BLE001 — настройка уже записана, это отдельный итог
            restart_error = "настройка сохранена, но VPN не перезапустился: " + str(exc)
    elif not restart:
        notes.append("без перезапуска — настройка применится при следующем подключении")
    if restart_error:
        notes.append(restart_error)
    # `note` — человеческая строка для CLI, `error` — она же для потребителей
    # (виджет показывает d.error, а не сырой JSON из stdout).
    text = "; ".join(notes)
    payload = {"ok": not fetch_errors and not restart_error, "enabled": bool(enabled),
               "restarted": restarted, "loaded": loaded, "fetched": fetched,
               "note": text}
    if text:
        payload["error"] = text
    return payload


def refilter_rules() -> tuple[list, list]:
    """rule_set'ы и правило для build_singbox: ([], []) если выключено/нет файлов.

    Берём только реально лежащие на диске наборы: правило со ссылкой на
    отсутствующий тег sing-box отвергает, и VPN не поднимется вовсе. Поэтому
    «включено, но не скачано» — это просто жизнь без правил, а не поломка.
    """
    if not refilter_enabled():
        return [], []
    files = refilter_files()
    sets, tags = [], []
    for kind, tag in (("domain", REFILTER_TAG_DOMAIN), ("ip", REFILTER_TAG_IP)):
        if not files[kind]["ok"]:
            continue
        tags.append(tag)
        sets.append({"tag": tag, "type": "local", "format": "binary",
                     "path": files[kind]["path"]})
    if not tags:
        return [], []
    return sets, [{"rule_set": tags, "outbound": "proxy"}]


# --------------------------------------------------------------------------- #
# разбор профилей и нод
# --------------------------------------------------------------------------- #

def outbounds(cfg: dict) -> list:
    return cfg.get("outbounds", []) or []


def node_outbounds(cfg: dict) -> list:
    return [o for o in outbounds(cfg) if o.get("protocol") in PROXY_PROTOCOLS]


def node_meta(o: dict) -> tuple[str, str, str]:
    """(tag, server, detail)."""
    tag = o.get("tag", "proxy")
    st = o.get("settings", {}) or {}
    address, port = "", ""
    for key in ("vnext", "servers"):
        seq = st.get(key)
        if isinstance(seq, list) and seq:
            address = str(seq[0].get("address") or seq[0].get("server") or "")
            port = str(seq[0].get("port") or "")
            break
    stream = o.get("streamSettings", {}) or {}
    tls = stream.get("realitySettings", {}) or {}
    tls2 = stream.get("tlsSettings", {}) or {}
    detail = (tls.get("serverName") or tls2.get("serverName")
              or (stream.get("xhttpSettings", {}) or {}).get("host") or address)
    if port and not str(detail).endswith(port):
        detail = f"{detail}:{port}"
    return tag, address, str(detail)


def profiles() -> list:
    out = []
    configs = get_configs()
    for i, cfg in enumerate(configs):
        nodes = node_outbounds(cfg)
        out.append({
            "index": i,
            "name": str(cfg.get("remarks") or f"Профиль {i + 1}").strip(),
            "node_count": len(nodes),
        })
    return out


def nodes(profile_index: int) -> list:
    configs = get_configs()
    if profile_index < 0 or profile_index >= len(configs):
        return []
    out = []
    for i, o in enumerate(node_outbounds(configs[profile_index])):
        tag, address, detail = node_meta(o)
        out.append({"index": i, "tag": tag, "address": address, "detail": detail})
    return out


def server_endpoints(profile_index: int) -> tuple[list, list]:
    """(ip_cidr, domains) — куда Xray может дозваниваться напрямую."""
    configs = get_configs()
    if not (0 <= profile_index < len(configs)):
        raise RuntimeError(
            f"профиль #{profile_index} не найден: в подписке профилей {len(configs)} — "
            "список: `omavpn profiles`")
    ips, domains = [], []
    for o in node_outbounds(configs[profile_index]):
        _, address, _ = node_meta(o)
        if not address:
            continue
        try:
            import ipaddress
            ip = ipaddress.ip_address(address)
            ips.append(str(ip) + ("/32" if ip.version == 4 else "/128"))
        except ValueError:
            domains.append(address)
    return sorted(set(ips)), sorted(set(domains))


# --------------------------------------------------------------------------- #
# генерация конфигов
# --------------------------------------------------------------------------- #

def _strip_balancers(cfg: dict) -> None:
    """Убирает `balancers`/`observatory` из конфига Xray.

    Подписка приходит с балансировщиком (`routing.balancers` + `leastPing`) и
    `observatory`, который его обслуживает. Для временного Xray одной ноды это
    лишнее (probe гоняет одну ноду), а в общем конфиге balancerTag без самих
    balancers — невалидная ссылка: xray ругается и правила игнорирует.
    """
    cfg.pop("observatory", None)
    cfg.pop("burstObservatory", None)
    routing = cfg.get("routing")
    if isinstance(routing, dict):
        routing.pop("balancers", None)
        routing.pop("observatoryTag", None)


def _as_selectors(value) -> list[str]:
    """selector/subjectSelector как список строк: в подписках бывает и строка."""
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, (list, tuple)):
        return []
    return [str(v) for v in value if isinstance(v, (str, int)) and str(v).strip()]


def _selector_matches(tag: str, selector: str) -> bool:
    """Попадает ли тег outbound под selector балансировщика/observatory.

    Xray сопоставляет selector с тегами по префиксу (документация,
    BalancerObject.selector: «Each string is used for prefix matching»): selector
    `proxy` цепляет `proxy`, `proxy-2`, … Точное совпадение — частный случай
    префикса. `*` xray не понимает, но генераторы подписок иногда его пишут —
    на этот случай проверяем fnmatch, чтобы не объявить исправный конфиг сломанным.
    """
    if not selector:
        return False
    if tag.startswith(selector):
        return True
    return any(ch in selector for ch in "*?[") and fnmatch.fnmatchcase(tag, selector)


def _balancer_covers_nodes(cfg: dict, node_tags: list[str]) -> bool:
    """Попадает ли хотя бы одна нода под selector балансировщика/observatory.

    Если ни одна не попадает, xray считает набор пустым и уводит ВЕСЬ трафик в
    `fallbackTag` (в подписках это `direct`): VPN «включён», а трафик идёт
    напрямую. Селектора нет вовсе — судить не берёмся, пусть решает xray.

    Сам `fallbackTag` проверяется отдельно (`_fix_balancer_fallback`): селектор
    может покрывать ноды, но пустой/непрогретый набор всё равно ушёл бы в
    fallback, и там не должно быть `direct`.
    """
    if not node_tags:
        return True
    routing = cfg.get("routing") if isinstance(cfg.get("routing"), dict) else {}
    selectors: list[str] = []
    for bal in routing.get("balancers") or []:
        if isinstance(bal, dict):
            selectors += _as_selectors(bal.get("selector"))
    for key in ("observatory", "burstObservatory"):
        obs = cfg.get(key)
        if isinstance(obs, dict):
            selectors += _as_selectors(obs.get("subjectSelector"))
    if not selectors:
        return True
    return any(_selector_matches(tag, sel) for sel in selectors for tag in node_tags)


def _balancer_selects_nodes(bal: dict, node_tags: list[str]) -> bool:
    """Покрывает ли selector ЭТОГО балансировщика хотя бы одну реальную ноду."""
    if not node_tags or not isinstance(bal, dict):
        return False
    selectors = _as_selectors(bal.get("selector"))
    if not selectors:
        return False        # без селектора ничего не утверждаем — не трогаем
    return any(_selector_matches(tag, sel) for sel in selectors for tag in node_tags)


def _fix_balancer_fallback(cfg: dict, node_tags: list[str]) -> list:
    """Заменяет `fallbackTag`, который указывает НЕ на ноду (например `direct`).

    В подписке (`🇪🇺 Автоматический выбор`) `fallbackTag` = `direct`, а
    observatory прогревается не сразу: пока набор нод пуст, xray гонит ВЕСЬ
    трафик напрямую, а статус показывает «VPN подключён». Подставляем первую
    ноду: пусть лучше не отвечает конкретная нода, чем молча мимо туннеля.

    Правим только балансировщики, чей selector покрывает реальные ноды: чужой
    (не про наши outbounds) балансировщик — не наше дело, и подстановка тега
    ноды в него может сломать конфиг.

    Отсутствующий или пустой `fallbackTag` НЕ трогаем: xray такой конфиг
    принимает, и трафик при пустом наборе просто не идёт (ошибка соединения),
    то есть утечки нет. Подставлять туда ноду нельзя — у балансировщиков без
    observatory (профили «Нидерланды»/«США») любой непустой `fallbackTag` ломает
    конфиг: `xray -test` отвечает «not all dependencies are resolved»
    (проверено на живой подписке).
    """
    if not node_tags:
        return []
    first = node_tags[0]
    fixed: list[str] = []
    routing = cfg.get("routing") if isinstance(cfg.get("routing"), dict) else {}
    for bal in routing.get("balancers") or []:
        if not _balancer_selects_nodes(bal, node_tags):
            continue
        current = bal.get("fallbackTag")
        if not current or current in node_tags:
            continue
        bal["fallbackTag"] = first
        fixed.append(str(current))
    return fixed


def build_xray(profile_index: int, node_index: int) -> dict:
    configs = get_configs()
    if not (0 <= profile_index < len(configs)):
        raise RuntimeError(
            f"профиль #{profile_index} не найден: в подписке профилей {len(configs)} — "
            "список: `omavpn profiles`")
    cfg = copy.deepcopy(configs[profile_index])

    for inb in cfg.get("inbounds", []):
        inb["listen"] = "127.0.0.1"
        if inb.get("protocol") == "socks":
            inb["port"] = SOCKS_PORT
        elif inb.get("protocol") == "http":
            inb["port"] = HTTP_PORT

    # Выбор ноды. Индекс зажимаем: он приходит из settings.json, а после `update`
    # нод может стать меньше — IndexError здесь ломал бы каждый следующий запуск.
    nd = nodes(profile_index)
    node_index = _num(node_index, -1)
    if not (0 <= node_index < len(nd)):
        node_index = -1
    routing = cfg.get("routing")
    routing = routing if isinstance(routing, dict) else {}
    balancer_rules = [rule for rule in (routing.get("rules") or [])
                      if isinstance(rule, dict) and "balancerTag" in rule]
    has_balancers = bool(routing.get("balancers"))
    target = nd[node_index]["tag"] if node_index >= 0 else ""
    if not target and balancer_rules and not has_balancers:
        # Правило ссылается на балансировщик, которого в подписке нет: xray такой
        # конфиг не примет, поэтому остаётся только первая нода.
        target = nd[0]["tag"] if nd else ""
    if not target and has_balancers and balancer_rules and \
            not _balancer_covers_nodes(cfg, [n["tag"] for n in nd]):
        # «Авто», но selector балансировщика не совпал ни с одной нодой: xray
        # посчитает набор пустым и уведёт ВЕСЬ трафик в fallbackTag (`direct`),
        # а статус при этом показывал бы running=true — VPN «включён», трафик
        # идёт напрямую. Падаем на первую ноду тем же путём, что и
        # «balancerTag без balancers».
        warn("селектор балансировщика не совпал ни с одной нодой — "
             "режим «Авто» переключаю на первую ноду")
        target = nd[0]["tag"] if nd else ""
    if target:
        # Явный выбор ноды (или сломанный балансировщик): правило с balancerTag
        # переписываем на outboundTag, а сам балансировщик с observatory убираем —
        # без этого xray ругается на balancerTag без balancers.
        for rule in balancer_rules:
            rule.pop("balancerTag", None)
            rule["outboundTag"] = target
        _strip_balancers(cfg)
    elif has_balancers and balancer_rules:
        # «Авто»: балансировщик остаётся (выбор по задержке через observatory),
        # но fallbackTag обязан указывать на ноду. В подписках там `direct`:
        # пока observatory не прогрет, набор нод пуст, и xray молча пускал ВЕСЬ
        # трафик напрямую — виджет при этом показывал «VPN подключён».
        fixed = _fix_balancer_fallback(cfg, [n["tag"] for n in nd])
        if fixed:
            warn("fallbackTag балансировщика указывал не на ноду ("
                 + ", ".join(fixed) + ") — заменяю на первую ноду «"
                 + nd[0]["tag"] + "», иначе при пустом наборе трафик шёл бы "
                 "мимо туннеля")
    # `node_index == -1` — «Авто»: конфиг подписки остаётся как есть, с
    # `balancers` + `observatory` и выбором лучшей ноды по задержке. Раньше
    # балансировщик вырезался всегда и «Авто» молча превращалось в первую ноду,
    # хотя README и панель обещают выбор по задержке. Исключение — селектор,
    # не совпавший ни с одной нодой (см. проверку выше): тогда «Авто» честно
    # падает на первую ноду, а не отдаёт весь трафик в fallbackTag.

    cfg["log"] = {"loglevel": "warning", "error": str(XRAY_LOG), "access": "none"}
    return cfg


def build_singbox(profile_index: int, strict: bool) -> dict:
    ips, domains = server_endpoints(profile_index)
    # Re:filter: заблокированное в РФ добиваем в туннель. Наборы — только если
    # функция включена и файлы уже скачаны (иначе правила просто нет).
    rf_sets, rf_rules = refilter_rules()
    # Адреса серверов подписки и весь tailnet Tailscale не заводим в туннель.
    exclude = [*ips, *TAILSCALE_CIDRS]
    bypass = [{"ip_cidr": TAILSCALE_CIDRS, "outbound": "direct"}]
    if ips:
        bypass.append({"ip_cidr": ips, "outbound": "direct"})
    if domains:
        bypass.append({"domain": domains, "outbound": "direct"})
    # Домены, которым положено в туннель (ALWAYS_PROXY_DOMAINS + оверрайды) —
    # отдельным правилом ПЕРЕД direct: direct_domains.txt перезаписывает
    # zapret-autotune, доверять ему как источнику истины нельзя.
    forced = proxy_domains()
    forced_rule = [{"domain_suffix": forced, "outbound": "proxy"}] if forced else []
    # Домены для российского резолвера — только те, что действительно идут
    # напрямую. Домен с оверрайдом `route set <домен> proxy` выпадает отсюда так
    # же, как из direct-правила: иначе DNS слал бы его в `ru`, а трафик шёл бы
    # через туннель — то есть ровно то, чего человек оверрайдом избегал.
    ru_domains = [dom for dom in ALWAYS_DIRECT_DOMAINS if dom not in set(forced)]
    # Эти домены резолвим российским DNS и при внутреннем резолве самого sing-box
    # (socks5h, домен в запросе): иначе `default_domain_resolver` увёл бы их
    # через туннель мимо dns.rules и вернул зарубежный адрес. Действие `resolve`
    # не финальное — следующее за ним правило direct по домену всё равно
    # срабатывает (проверено запуском).
    ru_resolve = [{"domain_suffix": ru_domains, "action": "resolve",
                   "server": "ru"}] if ru_domains else []
    return {
        "log": {"level": "warn", "timestamp": True},
        "dns": {
            # Два резолвера. `remote` (через туннель) — по умолчанию: DNS
            # провайдера для заблокированных доменов отдаёт недоступные IP, а
            # через туннель приходит «чистый» адрес. `ru` (российский DNS) — для
            # доменов, которые мы НИКОГДА не туннелируем (ALWAYS_DIRECT_DOMAINS):
            # им нужен именно российский адрес, а не зарубежный из туннеля.
            #
            # У `ru` НЕТ `detour`: `detour: direct` sing-box на старте отвергает
            # («detour to an empty direct outbound makes no sense» — у обычного
            # direct нет своих настроек, и обход бессмыслен).
            "servers": [
                {"type": "udp", "tag": "remote", "server": "1.1.1.1", "detour": "proxy"},
                {"type": "udp", "tag": "ru", "server": RU_DNS},
            ],
            # `action: route` — актуальная форма (с 1.11 поле адресата в правиле
            # DNS задаётся действием: dns.rules[].action + server).
            # `ru_domains` — ALWAYS_DIRECT_DOMAINS минус оверрайды `proxy`.
            "rules": ([{"domain_suffix": ru_domains, "action": "route", "server": "ru"}]
                      if ru_domains else []),
            "final": "remote",
            "strategy": "ipv4_only",
        },
        "inbounds": [{
            "type": "tun",
            "tag": "tun-in",
            "interface_name": TUN_IFACE,
            "address": [TUN_ADDR],
            "mtu": 1500,
            "stack": "gvisor",
            "auto_route": True,
            # `_truthy` на входе: значение приходит из settings.json, где после
            # ручной правки может стоять строка — bool("false") == True поднял бы
            # TUN в strict_route против воли человека
            "strict_route": _truthy(strict),
            # Адреса серверов подписки и tailnet Tailscale не заводим в туннель:
            # иначе соединение самого Xray к серверу уходит в TUN и зацикливается,
            # а пакеты к узлам Tailscale перехватываются VPN.
            "route_exclude_address": exclude,
        }],
        "outbounds": [
            {"type": "socks", "tag": "proxy", "server": "127.0.0.1",
             "server_port": SOCKS_PORT, "version": "5"},
            {"type": "direct", "tag": "direct"},
            {"type": "block", "tag": "block"},
        ],
        "route": {
            "auto_detect_interface": True,
            "final": "proxy",
            "default_domain_resolver": {"server": "remote"},
            **({"rule_set": rf_sets} if rf_sets else {}),
            "rules": [
                {"action": "sniff"},
                {"protocol": "dns", "action": "hijack-dns"},
                # Страховка, а не необходимость: адрес самого DNS-сервера `ru`
                # sing-box резолвит/доставляет напрямую и без этого правила
                # (проверено запуском). Правило оставлено на случай, если в
                # будущей версии запрос к резолверу пойдёт по общим правилам —
                # тогда он ушёл бы в туннель (final = proxy) и российский адрес
                # не вернулся бы.
                {"ip_cidr": [f"{RU_DNS}/32"], "outbound": "direct"},
                {"ip_is_private": True, "outbound": "direct"},
                *forced_rule,
                *ru_resolve,
                {"domain_suffix": direct_domains(), "outbound": "direct"},
                {"process_name": TELEGRAM_PROCESSES, "outbound": "direct"},
                *bypass,
                # Процесс Xray (в т.ч. временный из `probe`) ходит к серверам
                # подписки напрямую. Ставим это правило ДО Re:filter: иначе
                # соединение к ноде, чей адрес попал в список, ушло бы в TUN и
                # зациклилось.
                {"process_name": ["xray"], "outbound": "direct"},
                # SMTP — напрямую всегда: почтовый сервер по IP из набора ещё не
                # значит «заблокирован», а через туннель письма обычно не ходят.
                {"port": [25, 465, 587], "outbound": "direct"},
                # Re:filter — после всех direct-исключений: уже настроенные
                # «напрямую» (российские сервисы, YouTube-видео, Discord,
                # direct_domains.txt, оверрайды, SMTP) остаются прямыми, а
                # остальное заблокированное добиваем в туннель.
                *rf_rules,
                {"ip_version": 6, "outbound": "block"},
            ],
        },
    }


def validate(cmd: list, path: Path, timeout: float = 30.0) -> str:
    """Проверка конфига; `timeout` урезается, когда прогон ограничен бюджетом.

    `heal` считает общий дедлайн, и жёсткие 30 с на проверку конфига были
    главным источником перерасхода: ноды перебирались уже «за дедлайном».
    """
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=max(1.0, timeout))
    except (OSError, subprocess.TimeoutExpired) as exc:
        return str(exc)
    if p.returncode != 0:
        return (p.stderr or p.stdout or "ошибка конфигурации").strip()
    return ""


# --------------------------------------------------------------------------- #
# процессы
# --------------------------------------------------------------------------- #

def pid_of(pidfile: Path) -> int:
    try:
        pid = int(pidfile.read_text().strip())
    except (FileNotFoundError, ValueError, OSError):
        return 0
    return pid


def process_alive(pidfile: Path, marker: str) -> bool:
    pid = pid_of(pidfile)
    if pid <= 0 or not Path(f"/proc/{pid}").exists():
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace")
    except OSError:
        return False
    return marker in cmdline


LOG_MAX_BYTES = 2 * 1024 * 1024   # порог обрезки: 2 МБ
LOG_KEEP_LINES = 5000             # столько последних строк оставляем


def trim_log(path: Path, max_bytes: int = LOG_MAX_BYTES,
             keep_lines: int = LOG_KEEP_LINES) -> None:
    """Обрезает разросшийся лог, оставляя последние `keep_lines` строк.

    Логи xray/sing-box никто не ротирует (процессы запускаются через spawn, а не
    systemd), и за недели работы они уходят в десятки мегабайт, а `omavpn logs`
    читал файл целиком. Правка идёт **на месте**, без переименования: процесс
    держит лог открытым в режиме append, и после `os.replace` его записи уходили
    бы в удалённый inode, а новый файл перестал бы расти.
    """
    try:
        if path.stat().st_size <= max_bytes:
            return
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-keep_lines:]
        payload = ("\n".join(lines) + "\n").encode()
        with path.open("r+b") as handle:
            handle.seek(0)
            handle.write(payload)
            handle.truncate()
    except FileNotFoundError:
        return          # лога ещё нет — это норма (первый запуск, log_tail)
    except OSError as exc:
        warn(f"не удалось обрезать {path}: {exc}")


def spawn(cmd: list, logfile: Path, pidfile: Path) -> subprocess.Popen:
    """Запускает процесс и возвращает `Popen` — по нему видно, жив ли он.

    Раньше возвращался только pid, и `on` считал VPN поднятым по открытому порту.
    Порт мог держать старый xray или чужой процесс: новый падал на bind, а
    `on` отвечал `{"ok": true, "running": true}` при мёртвом туннеле. Теперь
    вызывающий проверяет `proc.poll()` в wait_port/wait_iface.
    """
    logfile.parent.mkdir(parents=True, exist_ok=True)
    trim_log(logfile)
    fd = os.open(logfile, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.chmod(logfile, 0o600)
    log = os.fdopen(fd, "ab", buffering=0)
    log.write(f"\n===== {time.strftime('%F %T')} {' '.join(cmd)} =====\n".encode())
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        cwd=str(STATE),
        start_new_session=True,
    )
    # У ребёнка свой дубликат fd: в родителе файл больше не нужен, закрываем.
    log.close()
    # pid пишем атомарно (tmp + replace): половина числа в pid-файле означала бы
    # «процесс чужой» и `off` не смог бы его погасить.
    tmp = pidfile.with_suffix(pidfile.suffix + ".tmp")
    tmp.write_text(str(proc.pid))
    os.chmod(tmp, 0o600)
    os.replace(tmp, pidfile)
    return proc


def stop_proc(pidfile: Path, marker: str, timeout: float = 6.0) -> None:
    pid = pid_of(pidfile)
    if pid <= 0:
        pidfile.unlink(missing_ok=True)
        return
    if process_alive(pidfile, marker):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + timeout
        while time.time() < deadline:
            stat = Path(f"/proc/{pid}/stat")
            if not stat.exists():
                break
            # Зомби (/proc есть, процесс уже мёртв) не даёт выйти из цикла:
            # ожидание съедало полный таймаут на каждом неудачном запуске.
            try:
                raw = stat.read_text()
                if raw.rsplit(")", 1)[-1].split()[0] == "Z":
                    break
            except (OSError, IndexError):
                break
            time.sleep(0.15)
        # Перепроверяем marker, а не только /proc/<pid>: за время ожидания pid
        # мог быть переиспользован чужим процессом, и SIGKILL убил бы его.
        if process_alive(pidfile, marker):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    pidfile.unlink(missing_ok=True)


PORT_SETTLE = 0.4   # пауза, за которую успевший упасть процесс себя выдаст


def _listen_inodes(port: int) -> set:
    """Все inode сокетов, слушающих порт (IPv4 и IPv6, любые адреса).

    Раньше возвращался только первый найденный: если тот же порт слушал кто-то
    ещё на другом адресе (127.0.0.2, ::1), настоящий владелец считался чужим и
    `on` падал с «Xray не открыл порт» при живом xray.
    """
    found: set = set()
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            lines = Path(table).read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            if len(parts) < 10 or parts[3] != "0A":   # 0A — состояние LISTEN
                continue
            try:
                local_port = int(parts[1].rsplit(":", 1)[1], 16)
            except (IndexError, ValueError):
                continue
            if local_port == port:
                found.add(parts[9])
    return found


def _listen_inode(port: int) -> str | None:
    """Первый inode, слушающий порт (совместимость)."""
    inodes = _listen_inodes(port)
    return next(iter(inodes), None)


def _owns_listen_port(pid: int, port: int) -> bool | None:
    """Слушает ли порт именно наш процесс.

    None — определить не удалось (нет /proc/net/tcp или прав): такой случай не
    должен мешать запуску, поэтому вызывающий считает его «не False».
    """
    inodes = _listen_inodes(port)
    if not inodes:
        return None
    targets = {f"socket:[{i}]" for i in inodes}
    try:
        fds = list(Path(f"/proc/{pid}/fd").iterdir())
    except OSError:
        return None
    for fd in fds:
        try:
            if fd.readlink().as_posix() in targets:
                return True
        except OSError:
            continue
    return False


def wait_port(port: int, timeout: float, proc: subprocess.Popen | None = None) -> bool:
    """Ждёт открытия порта; если процесс умер — сразу False.

    Открытый порт сам по себе ничего не доказывает: его мог занять старый xray
    или чужой процесс, а наш падает на bind. Поэтому при переданном `proc`
    дополнительно проверяем, что листенер принадлежит именно ему (по inode
    сокета), и держим settle-паузу: первый успешный коннект случается раньше,
    чем падающий процесс успевает выйти.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        if proc is not None and proc.poll() is not None:
            return False
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            if s.connect_ex(("127.0.0.1", port)) == 0:
                if proc is None:
                    return True
                time.sleep(PORT_SETTLE)
                if proc.poll() is not None:
                    return False
                if _owns_listen_port(proc.pid, port) is not False:
                    return True
                # порт держит кто-то другой — ждём, пока наш процесс займёт его сам
        time.sleep(0.2)
    return False


def wait_iface(iface: str, timeout: float, proc: subprocess.Popen | None = None) -> bool:
    """Ждёт появления интерфейса; если процесс умер — сразу False (см. wait_port)."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if proc is not None and proc.poll() is not None:
            return False
        if Path(f"/sys/class/net/{iface}").exists():
            if proc is None:
                return True
            # интерфейс мог остаться от прошлого запуска — даём процессу время упасть
            time.sleep(PORT_SETTLE)
            return proc.poll() is None
        time.sleep(0.2)
    return False


def log_tail(path: Path, lines: int = 6) -> str:
    """Последние строки лога: читаем хвост файла, а не весь лог целиком."""
    trim_log(path)
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - 256 * 1024))
            data = handle.read().decode("utf-8", errors="replace")
    except OSError:
        return ""
    return " | ".join(l.strip() for l in data.splitlines()[-lines:] if l.strip())


# --------------------------------------------------------------------------- #
# жизненный цикл
# --------------------------------------------------------------------------- #

def _procs_alive() -> tuple[bool, bool]:
    """(xray жив, sing-box жив) — по pid-файлам и маркеру командной строки."""
    return process_alive(XRAY_PID, "xray"), process_alive(SB_PID, "sing-box")


def _runtime_dict() -> dict:
    """state.json как объект. Мусор (строка, список) не должен ронять status."""
    st = load_json(RUNTIME, {})
    return st if isinstance(st, dict) else {}


def _active_mode() -> str:
    """Режим запущенного VPN: из state.json, иначе из настроек."""
    mode = str(_runtime_dict().get("mode") or settings().get("mode") or "tun")
    return mode if mode in ("tun", "proxy") else "tun"


def is_on() -> bool:
    """Работает ли VPN целиком.

    В режиме tun нужны ОБА процесса: раньше хватало любого, и связка «умер xray,
    жив sing-box» считалась включённой — TUN есть, трафик уходит в мёртвый socks,
    а статус зелёный.
    """
    xray_alive, sbox_alive = _procs_alive()
    if _active_mode() == "tun":
        return xray_alive and sbox_alive
    return xray_alive


def is_running_any() -> bool:
    """Жив ли хоть один процесс VPN (пара может быть неполной и требовать heal)."""
    return any(_procs_alive())


def cmd_off(quiet: bool = False) -> dict:
    with ctrl_lock():
        return _cmd_off(quiet)


def _cmd_off(quiet: bool = False) -> dict:
    """Останавливает процессы. Печатает только main (через emit)."""
    stop_proc(SB_PID, "sing-box")
    stop_proc(XRAY_PID, "xray")
    # И только теперь state.json: мусор в файле (`[]`, строка) раньше давал
    # TypeError, `off` возвращал rc=1 и VPN оставался включённым.
    st = _runtime_dict()
    st["running"] = False
    # выключение пользователем — намеренное действие: ошибки прошлого запуска
    # к нему отношения не имеют (иначе сторож решит, что VPN упал сам)
    st["last_error"] = ""
    save_json(RUNTIME, st)
    return {"ok": True, "running": False}


def cmd_on(profile_index: int | None, node_index: int | None, mode: str | None,
           quiet: bool = False) -> dict:
    with ctrl_lock():
        return _cmd_on(profile_index, node_index, mode, quiet)


def check_profile(profile_index) -> int:
    """Индекс профиля с понятной ошибкой и подсказкой (`omavpn profiles`)."""
    pro = profiles()
    idx = _num(profile_index, 0)
    if not (0 <= idx < len(pro)):
        raise RuntimeError(
            f"профиль #{idx} не найден: в подписке профилей {len(pro)} — список: `omavpn profiles`")
    return idx


def settings_profile() -> int:
    """Текущий профиль из настроек, зажатый в диапазон подписки."""
    try:
        pro = profiles()
    except RuntimeError:
        return 0
    idx = _num(settings().get("profile_index"), 0)
    return idx if 0 <= idx < len(pro) else 0


def check_node(profile_index: int, node_index) -> int:
    """Нода: -1 (авто) или существующий индекс; иначе ошибка (`omavpn nodes`)."""
    idx = _num(node_index, -1)
    if idx < 0:
        return -1
    nd = nodes(profile_index)
    if idx >= len(nd):
        raise RuntimeError(
            f"сервер #{idx} не найден: в профиле серверов {len(nd)} — список: `omavpn nodes`")
    return idx


def _cmd_on(profile_index: int | None, node_index: int | None, mode: str | None,
            quiet: bool = False) -> dict:
    """Поднимает VPN. Печатает только main (через emit).

    Профиль и нода проверяются ДО записи настроек: `omavpn node 99` раньше
    сохранял индекс вне диапазона, и после этого падали все запуски (IndexError
    в build_xray), включая guard, автозапуск и heal. Тот же эффект был после
    `update`, когда нод в профиле становилось меньше.
    """
    ensure_dirs()
    s = settings()

    if mode is None:
        mode = str(s.get("mode") or "tun")
    mode = str(mode).strip().lower()
    if mode not in ("tun", "proxy"):
        warn(f"неизвестный режим {mode!r} — беру tun")
        mode = "tun"

    if not XRAY_BIN.exists():
        raise RuntimeError("Xray не установлен — запустите install.sh")
    if mode == "tun" and not SB_BIN.exists():
        raise RuntimeError("sing-box не установлен — запустите install.sh")

    configs = get_configs()

    if profile_index is not None:
        profile_index = check_profile(profile_index)
    else:
        # сохранённый профиль мог исчезнуть после `update` — берём первый
        profile_index = _num(s.get("profile_index"), 0)
        if not (0 <= profile_index < len(configs)):
            warn(f"сохранённый профиль #{profile_index} пропал из подписки — беру первый")
            profile_index = 0
    if not node_outbounds(configs[profile_index]):
        raise RuntimeError(
            f"в профиле #{profile_index} нет серверов — выберите другой: `omavpn profiles`")

    if node_index is not None:
        node_index = check_node(profile_index, node_index)
    else:
        node_index = _num(s.get("node_index"), -1)
        if node_index >= len(nodes(profile_index)):
            warn(f"сохранённый сервер #{node_index} пропал из профиля — беру авто")
            node_index = -1

    xray_cfg = build_xray(profile_index, node_index)
    save_json(XRAY_CFG, xray_cfg)
    err = validate([str(XRAY_BIN), "run", "-c", str(XRAY_CFG), "-test"], XRAY_CFG)
    if err:
        raise RuntimeError(f"конфиг Xray отклонён: {err}")

    sb_cfg = None
    if mode == "tun":
        sb_cfg = build_singbox(profile_index, _truthy(s.get("strict_route", False)))
        save_json(SB_CFG, sb_cfg)
        err = validate([str(SB_BIN), "check", "-c", str(SB_CFG)], SB_CFG)
        if err:
            raise RuntimeError(f"конфиг sing-box отклонён: {err}")

    # Настройки пишем только ПОСЛЕ проверки конфигов. Раньше выбор сохранялся
    # раньше `xray -test`/`sing-box check`, и кривой профиль/нода/режим оставался
    # в файле навсегда: каждый следующий запуск (guard, heal, автозапуск) падал
    # на нём же. Теперь при отказе файл не меняется вовсе — откатывать нечего.
    set_settings(profile_index=profile_index, node_index=node_index, mode=mode)

    _cmd_off(quiet=True)

    last_error = ""
    try:
        xray_proc = spawn([str(XRAY_BIN), "run", "-c", str(XRAY_CFG)], XRAY_LOG, XRAY_PID)
        if not wait_port(SOCKS_PORT, 6, xray_proc):
            # порт мог занять чужой процесс (старый xray, другой клиент) — тогда
            # «Xray не открыл порт» вводит в заблуждение, добавляем подсказку
            hint = ""
            if _listen_inodes(SOCKS_PORT):
                hint = (f" — порт {SOCKS_PORT} слушает посторонний процесс, "
                        "завершите его или освободите порт")
            raise RuntimeError("Xray не открыл SOCKS-порт: " + log_tail(XRAY_LOG) + hint)
        if mode == "tun":
            sb_proc = spawn([str(SB_BIN), "run", "-c", str(SB_CFG)], SB_LOG, SB_PID)
            if not wait_iface(TUN_IFACE, 8, sb_proc):
                raise RuntimeError("TUN не поднялся: " + log_tail(SB_LOG))
    except Exception as exc:  # noqa: BLE001
        last_error = str(exc)
        stop_proc(SB_PID, "sing-box")
        stop_proc(XRAY_PID, "xray")
        # merge, а не замена: иначе теряются last_heal (троттл heal), started_at
        # и mode, которые пишут другие команды.
        st = _runtime_dict()
        st.update({"running": False, "last_error": last_error})
        save_json(RUNTIME, st)
        raise

    st = _runtime_dict()
    st.update({
        "running": True,
        "mode": mode,
        "profile_index": profile_index,
        "node_index": node_index,
        "started_at": time.time(),
        "last_error": "",
    })
    save_json(RUNTIME, st)
    return {"ok": True, "running": True, "mode": mode,
            "profile_index": profile_index, "node_index": node_index,
            "profile_name": profiles()[profile_index]["name"]}


def _validate_choice(profile_index: int, node_index: int, mode: str, strict: bool) -> None:
    """Проверяет конфиги для выбранной пары, ничего не запуская.

    Пишем во временные файлы: живой `xray.json`/`singbox.json` не трогаем — его
    читает работающий процесс, а следующий `on` всё равно перегенерирует.
    Нет бинарей или нет подписки — проверять нечем, молча пропускаем (раньше в
    этом случае настройки просто сохранялись, и ломать такой сценарий нельзя).
    """
    try:
        pro = profiles()
    except (RuntimeError, OSError, ValueError):
        pro = []
    if not pro or not (XRAY_BIN.exists() or SB_BIN.exists()):
        return
    if not (0 <= profile_index < len(pro)):
        # как в `on`: сохранённый профиль мог исчезнуть после `update`
        profile_index = 0
    if XRAY_BIN.exists():
        path = STATE / "check-xray.json"
        err = ""
        try:
            save_json(path, build_xray(profile_index, node_index))
            err = validate([str(XRAY_BIN), "run", "-c", str(path), "-test"], path)
        finally:
            path.unlink(missing_ok=True)
        if err:
            raise RuntimeError(f"конфиг Xray отклонён: {err}")
    if mode == "tun" and SB_BIN.exists():
        path = STATE / "check-singbox.json"
        err = ""
        try:
            save_json(path, build_singbox(profile_index, strict))
            err = validate([str(SB_BIN), "check", "-c", str(path)], path)
        finally:
            path.unlink(missing_ok=True)
        if err:
            raise RuntimeError(f"конфиг sing-box отклонён: {err}")


def choose(profile_index: int | None = None, node_index: int | None = None,
           mode: str | None = None, strict_route: bool | None = None) -> dict:
    """Применяет выбор профиля/ноды/режима/strict_route после проверки конфигов.

    Раньше `omavpn node 3`, `profile 2`, `mode proxy` писали настройки сразу, а
    `xray -test`/`sing-box check` гонялись только в `on`: выбор, на котором
    конфиг не собирается, оставался в файле навсегда, и каждый следующий запуск
    (guard, heal, автозапуск) падал на нём же.

    Теперь: настройки пишутся, затем при включённом VPN — обычный `on` с новыми
    значениями (он проверяет конфиги сам), при выключенном — проверка на
    временной копии. Любая ошибка возвращает прежние настройки, а если VPN был
    включён — best-effort поднимает его обратно на прежнем выборе (неудача
    видна в stderr и в атрибуте `restore_failed` у исключения; исходная ошибка
    остаётся прежней).
    """
    previous = settings()
    changes: dict = {}
    for key, value in (("profile_index", profile_index), ("node_index", node_index),
                       ("mode", mode), ("strict_route", strict_route)):
        if value is not None:
            changes[key] = value
    plan = {**previous, **changes}
    mode_plan = str(plan.get("mode") or "tun")
    if mode_plan not in ("tun", "proxy"):
        mode_plan = "tun"
    written = set_settings(**changes)
    # Состояние VPN до попытки: если выбор не удался, туннель к этому моменту уже
    # погашен (cmd_on при ошибке останавливает процессы), и без восстановления
    # человек остаётся с откаченными настройками и выключенным VPN.
    vpn_was_on = is_on()
    try:
        if vpn_was_on:
            cmd_on(None, None, None, quiet=True)
            return {"ok": True, "restarted": True}
        _validate_choice(_num(plan.get("profile_index"), 0), _num(plan.get("node_index"), -1),
                         mode_plan, _truthy(plan.get("strict_route", False)))
    except BaseException as exc:
        # Кривой выбор не должен «прилипнуть»: возвращаем настройки как было. Но
        # только если файл всё ещё наш: параллельный процесс (guard, аудит) мог
        # записать своё, и его решение затирать нельзя.
        if settings() == written:
            save_json(SETTINGS, previous)
        # Best-effort возврат туннеля на прежнем выборе. Исходную ошибку не
        # маскируем: она уходит наверх как была, а неудача восстановления — в
        # stderr и в атрибут исключения `restore_failed` (вызывающий может
        # показать «VPN остался выключен»).
        restore_failed = False
        if vpn_was_on and not is_on():
            try:
                cmd_on(None, None, None, quiet=True)
            except Exception:  # noqa: BLE001
                restore_failed = True
        if restore_failed:
            warn("настройки возвращены, но VPN вернуть не удалось — "
                 "включите вручную: `omavpn on`")
            try:
                setattr(exc, "restore_failed", True)
            except (AttributeError, TypeError):
                pass
        raise
    return {"ok": True, "restarted": False}


# --------------------------------------------------------------------------- #
# статус
# --------------------------------------------------------------------------- #

def iface_stats() -> tuple[int, int]:
    base = Path(f"/sys/class/net/{TUN_IFACE}/statistics")
    try:
        return int((base / "rx_bytes").read_text()), int((base / "tx_bytes").read_text())
    except (OSError, ValueError):
        return 0, 0


def _wan_iface() -> str:
    """Интерфейс маршрута по умолчанию мимо туннеля ("" — не нашли).

    Нужен, чтобы при поднятом TUN померять «прямой» IP: обычный curl ушёл бы
    в туннель и показал тот же адрес. Читаем /proc/net/route — без ip/nmcli,
    которые могут быть не установлены. Маршрут через TUN пропускаем: у него
    нет шлюза (destination/gateway 00000000), плюс имя интерфейса совпадает.
    """
    try:
        lines = Path("/proc/net/route").read_text().splitlines()[1:]
    except OSError:
        return ""
    for line in lines:
        parts = line.split()
        if len(parts) < 4:
            continue
        iface, dest, gateway, flags = parts[0], parts[1], parts[2], parts[3]
        if iface == TUN_IFACE or dest != "00000000" or gateway == "00000000":
            continue
        try:
            if not int(flags, 16) & 0x1:      # RTF_UP
                continue
        except ValueError:
            continue
        return iface
    return ""


def caps_ok() -> bool:
    """Есть ли у sing-box CAP_NET_ADMIN (иначе TUN потребует root/пароль)."""
    out = _run_out(["getcap", str(SB_BIN)], 5)
    return "cap_net_admin" in out


def _index_valid(value) -> bool:
    """Похоже ли значение из настроек на индекс: int (не bool) или строка с числом."""
    if isinstance(value, bool):
        return False
    if isinstance(value, int):
        return True
    if isinstance(value, str):
        try:
            int(value.strip())
        except ValueError:
            return False
        return True
    return False


def status() -> dict:
    """Состояние для виджета. Не падает никогда: любой мусор → валидный JSON.

    На входе бывают: отрицательный или нечисловой `profile_index`, `node_index`
    строкой, `pid: "abc"` в probe.json, `sub.json` со списком вместо объекта.
    Раньше каждый такой случай давал трейсбек, и виджет решал, что VPN вообще
    не установлен. Теперь всё читается безопасными геттерами.
    """
    ensure_dirs()
    s = settings()
    st = _runtime_dict()
    xray_alive, sbox_alive = _procs_alive()
    mode = str(s.get("mode") or "tun")
    if mode not in ("tun", "proxy"):
        mode = "tun"
    running = is_on()
    try:
        pro = profiles()
    except (RuntimeError, OSError, ValueError):
        pro = []
    pi = _num(s.get("profile_index"), 0)
    errors: list[str] = []
    if not pro:
        pi = 0                      # подписки нет — сравнивать не с чем
    else:
        if not (0 <= pi < len(pro)):
            pi = 0
        # Молчаливый кламп — это ложь в статусе: виджет показывал профиль #0 как
        # выбранный человеком, хотя в настройках стояло 99 или "abc". Теперь
        # причина видна в JSON (`settings_error`) и в тексте статуса.
        raw_pi = s.get("profile_index")
        if not _index_valid(raw_pi):
            errors.append(f"в настройках профиль {raw_pi!r} — не число, использую #{pi}")
        elif _num(raw_pi, -1) != pi:
            errors.append(f"в настройках профиль #{_num(raw_pi, -1)}, "
                          f"доступно {len(pro)} — использую #{pi}")
    ni = _num(s.get("node_index"), -1)
    try:
        nd = nodes(pi) if pro else []
    except (RuntimeError, OSError, ValueError):
        nd = []
    # Та же проверка для ноды: при `node_index: 999` статус показывал «авто» с
    # пустым settings_error, хотя в конфиг попала бы нода #0 (build_xray зажимает
    # индекс). Без подписки сравнивать не с чем — ноды не проверяем.
    if nd:
        raw_ni = s.get("node_index")
        if not _index_valid(raw_ni):
            errors.append(f"в настройках сервер {raw_ni!r} — не число, использую авто")
            ni = -1
        elif ni < -1 or ni >= len(nd):
            errors.append(f"в настройках сервер #{ni}, в профиле доступно "
                          f"{len(nd)} — использую авто")
            ni = -1
    settings_error = "; ".join(errors)
    rx, tx = iface_stats() if running else (0, 0)
    started_at = _num(st.get("started_at"), 0)
    uptime = max(0, int(time.time() - started_at)) if running and started_at > 0 else 0
    installed = XRAY_BIN.exists() and SB_BIN.exists()
    sub = load_json(SUBFILE, {})
    updated = _num(sub.get("updated"), 0) if isinstance(sub, dict) else 0
    last_error = str(st.get("last_error") or "")
    # если другой ошибки нет, показываем хотя бы расхождение настроек: иначе
    # виджет считает, что всё в порядке, и человек не понимает, откуда чужой профиль
    if not last_error and settings_error:
        last_error = settings_error
    return {
        "ok": True,
        "installed": installed,
        "running": running,
        # раздельно: в режиме tun нужны оба, и виджет должен видеть, кто умер
        "xray_alive": xray_alive,
        "sbox_alive": sbox_alive,
        "caps_ok": caps_ok(),
        "mode": mode,
        # через `_truthy`, а не bool(): после ручной правки "false" в settings.json
        # bool("false") == True и strict_route включался сам
        "strict_route": _truthy(s.get("strict_route", False)),
        "profile_index": pi,
        "profile_name": pro[pi]["name"] if pro else "",
        "settings_error": settings_error,
        "node_index": ni,
        "node_name": (nd[ni]["tag"] if 0 <= ni < len(nd) else "auto"),
        "uptime": uptime,
        "rx": rx,
        "tx": tx,
        "socks_port": SOCKS_PORT,
        "http_port": HTTP_PORT,
        "tun_iface": TUN_IFACE,
        "last_error": last_error,
        "updated": updated,
        "profiles": pro,
        "nodes": nd,
        "probe": probe_state(),
    }


def status_text(st: dict) -> str:
    """Короткая человеческая строка `omavpn status` (печатает только main)."""
    if not st.get("installed"):
        return "не установлен: нет бинарей xray/sing-box — запустите install.sh"
    if not st.get("running"):
        reason = str(st.get("last_error") or "")
        return "выключен" + (f" · последняя ошибка: {reason}" if reason else "")
    parts = [
        "подключён",
        f"профиль {st.get('profile_name') or '—'}",
        f"нода {st.get('node_name') or 'auto'}",
        str(st.get("mode") or ""),
        f"аптайм {fmt_age(st.get('uptime'))}",
    ]
    if not st.get("xray_alive", True):
        parts.append("xray не работает")
    if str(st.get("mode")) == "tun" and not st.get("sbox_alive", True):
        parts.append("sing-box не работает — туннеля нет")
    if st.get("settings_error"):
        parts.append(str(st["settings_error"]))
    return " · ".join(part for part in parts if part)


# Проверка выхода VPN. api.ipify.org через проверенные ноды отдаёт 000 (TLS
# unexpected EOF), хотя обычные сайты через те же ноды отвечают 200 — из-за
# этого `check` врал «через VPN ответа нет», и guard/виджет лечили здоровый
# туннель. cdn-cgi/trace — тот же адрес, что у `_proxy_ok` и bypass-status.
CHECK_TRACE_URL = "https://www.cloudflare.com/cdn-cgi/trace"


def _trace_parse(text: str) -> tuple[str, str]:
    """(ip, loc) из ответа cloudflare trace; пустые строки, если полей нет."""
    ip = loc = ""
    for line in (text or "").splitlines():
        line = line.strip()
        if line.startswith("ip="):
            ip = line[3:].strip()
        elif line.startswith("loc="):
            loc = line[4:].strip()
    return ip, loc


def check() -> dict:
    """Внешний IP через туннель (и, best-effort, напрямую — мимо TUN).

    `ok` означает «trace прошёл через SOCKS», а не «IP отличается»: сравнение
    с прямым адресом — приятный бонус, а не доказательство работы VPN. Прямой
    IP при поднятом TUN обычным curl'ом измерить нельзя (он уйдёт в туннель),
    поэтому пробуем только через WAN-интерфейс; не вышло — честно оставляем
    поле пустым и не делаем вид, что «ответа нет».
    """
    if shutil.which("curl") is None:
        return {"ok": False, "error": "curl не найден — внешний IP не проверить"}
    if not is_on():
        # VPN выключен: запрос через SOCKS ничего не докажет, а стоит до 20 с.
        return {"ok": False, "error": "не подключено", "direct_ip": "",
                "note": "VPN выключен — прямой IP не запрашивался"}
    out = _run_out(["curl", "-s", "--max-time", "20", "--socks5-hostname",
                    f"127.0.0.1:{SOCKS_PORT}", CHECK_TRACE_URL], 23)
    proxy_ip, loc = _trace_parse(out)
    res = {"ok": bool(proxy_ip), "proxy_ip": proxy_ip, "loc": loc,
           "endpoint": CHECK_TRACE_URL, "direct_ip": "", "changed": False}
    if not proxy_ip:
        res["error"] = "через VPN ответа нет"
        res["note"] = "trace через SOCKS не получен"
        return res
    wan = _wan_iface()
    if wan:
        direct, _ = _trace_parse(_run_out(
            ["curl", "-s", "--max-time", "8", "--interface", wan, CHECK_TRACE_URL], 12))
        res["direct_ip"] = direct
        res["changed"] = bool(direct) and direct != proxy_ip
    else:
        res["note"] = "прямой IP не измерен: WAN-интерфейс не найден"
    return res


def check_text(res: dict) -> str:
    """Короткая человеческая строка `omavpn check` (печатает только main)."""
    if res.get("error"):
        note = str(res.get("note") or "")
        return str(res["error"]) + (f" · {note}" if note else "")
    loc = f" ({res['loc']})" if res.get("loc") else ""
    line = f"через VPN: {res.get('proxy_ip')}{loc}"
    if res.get("direct_ip"):
        line += (f" · прямой IP: {res['direct_ip']}"
                 + (" · IP изменился" if res.get("changed") else " · IP не изменился"))
    else:
        line += " · прямой IP не измерен"
    if res.get("note"):
        line += f" · {res['note']}"
    return line


def on_text(res: dict) -> str:
    """Человеческая строка `omavpn on`/`toggle` (печатает только main)."""
    name = str(res.get("profile_name") or "")
    mode = str(res.get("mode") or "")
    text = "Подключено" + (f" · {name}" if name else "")
    if mode == "tun":
        text += " · TUN"
    elif mode:
        text += " · SOCKS/HTTP"
    return text


# --------------------------------------------------------------------------- #
# тест серверов (нод) через временный Xray
# --------------------------------------------------------------------------- #

def _free_port(start: int, tries: int = 200) -> int:
    """Первый свободный локальный порт из диапазона.

    Проверка «bind → close» не гарантирует, что порт останется нашим: между
    закрытием сокета и стартом Xray его может занять чужой процесс (TOCTOU).
    Поэтому вызывающий обязан перепроверить занятость прямо перед запуском
    (`_port_busy`) и, если порт увели, сказать об этом внятно, а не гадать по
    логу «xray не поднялся».
    """
    for port in range(start, start + tries):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(("127.0.0.1", port))
            except OSError:
                continue
            return port
    raise RuntimeError("нет свободного локального порта для теста")


def _port_busy(port: int) -> bool:
    """Слушает ли порт кто-то прямо сейчас (повторная проверка после _free_port)."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def probe_running() -> bool:
    """Идёт ли тест серверов прямо сейчас (по файлу прогресса)."""
    data = load_json(PROBE_FILE, {})
    if not isinstance(data, dict) or not data.get("running"):
        return False
    pid = _num(data.get("pid"), 0)
    if pid > 0 and Path(f"/proc/{pid}").exists():
        return True
    # файл только что обновлён, а pid ещё не виден — считаем, что тест идёт
    return (time.time() - _num(data.get("updated"), 0)) < 20


@contextlib.contextmanager
def _probe_lock():
    """Короткий эксклюзивный flock вокруг файла прогресса теста.

    `probe.json` пишут несколько процессов (CLI, виджет, heal), и запись через
    общий tmp-файл `save_json` не защищала от гонки: два прогона успевали
    прочитать «теста нет» и оба начинали писать в один файл — результат одного
    затирал прогресс другого. Лок отдельный (`probe.lock`), а не на самом
    `probe.json`: файл прогресса пересоздаётся через `os.replace`, и flock на
    старом inode перестал бы защищать новый файл.
    """
    CACHE.mkdir(parents=True, exist_ok=True)
    fd = os.open(PROBE_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def _write_probe(state: dict) -> None:
    """Запись файла прогресса БЕЗ лока — только из-под `_probe_lock`/`_save_probe`."""
    state["updated"] = time.time()
    save_json(PROBE_FILE, state)


def _save_probe(state: dict) -> None:
    with _probe_lock():
        _write_probe(state)


def _probe_claim(state: dict) -> bool:
    """Занять файл прогресса: проверка «тест уже идёт» и запись — под одним локом.

    Без этого между `probe_running()` и первой `_save_probe` оставалось окно, в
    которое второй процесс запускал свой тест.
    """
    with _probe_lock():
        if probe_running():
            return False
        _write_probe(state)
        return True


def _port_up(port: int, timeout: float, proc=None) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if proc is not None and proc.poll() is not None:
            return False
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.4)
            try:
                if s.connect_ex(("127.0.0.1", port)) == 0:
                    return True
            except OSError:
                pass
        time.sleep(0.2)
    return False


def _run_out(cmd: list, timeout: float) -> str:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return (p.stdout or "").strip()


def _probe_once(port: int, url: str, timeout: float):
    """Одна проба через локальный SOCKS. None — проба не удалась."""
    out = _run_out(["curl", "-s", "-o", "/dev/null", "--socks5-hostname", f"127.0.0.1:{port}",
                    "-w", "%{http_code} %{time_appconnect} %{time_total}",
                    "--max-time", str(timeout), url], timeout + 3)
    parts = out.split()
    if len(parts) < 3:
        return None
    try:
        code = int(parts[0])
        tls = float(parts[1])
        total = float(parts[2])
    except ValueError:
        return None
    if code == 0:
        return None
    return {"code": code, "tls": tls, "total": total}


def probe_node(profile_index: int, node_index: int, probes: int, url: str,
               timeout: float, budget: float | None = None) -> dict:
    """Поднимает временный Xray с одной нодой и меряет её реальные пробы.

    Каждая проба идёт в собственном каталоге: раньше все писали в общие
    `probe/node.json` и `probe/node.log`, и два одновременных теста (виджет и
    CLI) затирали друг другу конфиг и лог — результат был случайным.

    `budget` — сколько секунд есть на всю ноду (передаёт `heal` из остатка
    общего дедлайна). Бюджет режет и `validate` (до 30 с), и ожидание порта
    (до 8 с), и сами пробы: иначе одна нода съедала до ~40 с сверх дедлайна.
    """
    PROBE_DIR.mkdir(parents=True, exist_ok=True)
    stamp = int(time.time() * 1000) % 10 ** 6
    workdir = PROBE_DIR / f"node-{os.getpid()}-{_num(node_index, 0)}-{stamp}"
    workdir.mkdir(parents=True, exist_ok=True)
    try:
        return _probe_node_in(profile_index, node_index, probes, url, timeout, workdir,
                              budget)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def _probe_node_in(profile_index: int, node_index: int, probes: int, url: str,
                   timeout: float, workdir: Path, budget: float | None = None) -> dict:
    """Тело probe_node: работает в своём временном каталоге `workdir`."""
    nd = nodes(profile_index)[node_index]
    result = {"index": node_index, "tag": nd["tag"], "detail": nd["detail"],
              "address": nd["address"], "dead": True, "note": "", "probes": probes,
              "ok_count": 0, "loss": probes, "med": None, "p90": None, "max": None,
              "tls_med": None, "score": None, "secs": 0.0}
    started = time.time()

    def left() -> float:
        """Сколько осталось от бюджета; без бюджета — не ограничиваем."""
        return float("inf") if budget is None else budget - (time.time() - started)

    port = _free_port(PROBE_PORT_BASE)
    cfg_path = workdir / "node.json"
    log_path = workdir / "node.log"

    cfg = build_xray(profile_index, node_index)
    # подписка может принести balancers/observatory — для одной ноды они лишние
    _strip_balancers(cfg)
    cfg["inbounds"] = [{"tag": "probe-in", "listen": "127.0.0.1", "port": port,
                        "protocol": "socks",
                        "settings": {"udp": False, "auth": "noauth"}}]
    cfg["log"] = {"loglevel": "error", "error": str(log_path), "access": "none"}
    save_json(cfg_path, cfg)

    if left() <= 1.0:
        result["note"] = "бюджет времени исчерпан — этот сервер не проверялся"
        result["secs"] = round(time.time() - started, 1)
        return result

    err = validate([str(XRAY_BIN), "run", "-c", str(cfg_path), "-test"], cfg_path,
                   timeout=min(30.0, left()))
    if err:
        result["note"] = "конфиг отклонён: " + (err.splitlines() or [""])[0][:140]
        result["secs"] = round(time.time() - started, 1)
        return result

    # повторная проверка порта: между _free_port и Popen его мог занять чужой
    # процесс, и тогда пробы ушли бы через чужой прокси (или в никуда)
    if _port_busy(port):
        result["note"] = (f"порт 127.0.0.1:{port} занят другим процессом — "
                          "сервер не проверен, повторите тест")
        result["secs"] = round(time.time() - started, 1)
        return result

    proc = subprocess.Popen([str(XRAY_BIN), "run", "-c", str(cfg_path)],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        if not _port_up(port, min(8.0, left()), proc):
            result["note"] = "Xray не поднялся с этой нодой"
        else:
            totals, tlss, streak = [], [], 0
            for _ in range(max(1, probes)):
                # -1 с на то, чтобы успеть вернуться до дедлайна: у curl внутри
                # ещё свой запас на запуск
                cap = left() - 1.0
                if cap <= 0.5:
                    break
                one = _probe_once(port, url, min(timeout, cap))
                if one is None:
                    streak += 1
                    if streak >= 3:      # нода явно не отвечает — не тянем таймауты
                        break
                    continue
                streak = 0
                totals.append(one["total"])
                if one["tls"]:
                    tlss.append(one["tls"])
            if not totals:
                result["note"] = "нет ответа через ноду"
            else:
                ordered = sorted(totals)
                med = statistics.median(ordered)
                p90 = ordered[min(len(ordered) - 1, int(round(0.9 * (len(ordered) - 1))))]
                loss = max(0, probes - len(ordered))
                result.update({
                    "dead": False,
                    "ok_count": len(ordered),
                    "loss": loss,
                    "med": round(med, 2),
                    "p90": round(p90, 2),
                    "max": round(max(ordered), 2),
                    "tls_med": round(statistics.median(tlss), 2) if tlss else None,
                    # чем меньше, тем лучше: медиана + хвост + штраф за потери
                    "score": round(med * 0.4 + p90 * 0.6 + loss * 1.5, 3),
                })
    finally:
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:  # noqa: BLE001
            try:
                proc.kill()
            except Exception:  # noqa: BLE001
                pass
    result["secs"] = round(time.time() - started, 1)
    return result


def probe_all(profile_index: int | None = None, probes: int = PROBE_DEFAULT_PROBES,
              url: str = PROBE_URL, timeout: float = PROBE_DEFAULT_TIMEOUT,
              node_index: int | None = None) -> dict:
    """Тестирует все серверы профиля. Прогресс — в CACHE/probe.json."""
    s = settings()
    if profile_index is None:
        profile_index = _num(s.get("profile_index"), 0)
    pro = profiles()
    if not (0 <= profile_index < len(pro)):
        raise RuntimeError(f"профиль #{profile_index} не найден — список: `omavpn profiles`")
    nd = nodes(profile_index)
    if node_index is not None:
        if not (0 <= node_index < len(nd)):
            raise RuntimeError(f"сервер #{node_index} не найден в профиле")
        nd = [nd[node_index]]
    if not nd:
        raise RuntimeError("в профиле нет серверов")
    probes = max(1, int(probes))

    ensure_dirs()
    state = {
        "running": True, "pid": os.getpid(), "profile": profile_index,
        "profile_name": pro[profile_index]["name"], "nodes_total": len(nd),
        "nodes_done": 0, "current": "", "current_index": -1,
        "probes": probes, "url": url, "started": time.time(), "finished": 0.0,
        "results": [], "best": None, "error": "",
    }
    if not _probe_claim(state):
        return {"ok": False, "error": "тест серверов уже идёт"}
    try:
        for n in nd:
            state["current"], state["current_index"] = n["tag"], n["index"]
            _save_probe(state)
            state["results"].append(probe_node(profile_index, n["index"], probes, url, timeout))
            state["nodes_done"] = len(state["results"])
            _save_probe(state)
        alive = sorted((r for r in state["results"] if not r["dead"]),
                       key=lambda r: r["score"])
        if alive:
            state["best"] = {"index": alive[0]["index"], "tag": alive[0]["tag"],
                             "med": alive[0]["med"], "score": alive[0]["score"]}
    except Exception as exc:  # noqa: BLE001
        state["error"] = str(exc)
    state["running"] = False
    state["finished"] = time.time()
    state["current"] = ""
    state["pid"] = 0
    _save_probe(state)
    return {"ok": not state["error"], "profile": profile_index, **state}


def probe_state() -> dict:
    """Текущее состояние/результаты теста серверов (для виджета)."""
    data = load_json(PROBE_FILE, {})
    if not isinstance(data, dict):
        return {}
    if data.get("running"):
        pid = _num(data.get("pid"), 0)
        if not (pid > 0 and Path(f"/proc/{pid}").exists()) \
                and (time.time() - _num(data.get("updated"), 0)) > 30:
            data["running"] = False
            data["stale"] = True
    return data


def probe_best(probes_quick: int = 2, timeout_quick: float = 3.5,
               probes_final: int = 6, timeout_final: float = 6.0,
               url: str = PROBE_URL, apply: bool = False,
               keep_profile: bool = False) -> dict:
    """Тест ВСЕХ регионов (профилей) и серверов: выбирает лучшую пару регион+сервер.

    Быстрый проход по всем нодам всех профилей, затем подтверждающая серия
    проб на лучшей ноде. Результат (и прогресс) — в CACHE/probe.json.
    С apply=True лучшая пара применяется в настройках и, если VPN включён,
    немедленно переподключается на неё.

    `keep_profile=True` — автоматический подбор: регион не меняем (его выбирает
    человек), тестируем только ноды текущего профиля и пишем только
    `node_index`. Иначе фоновая «оптимизация» молча переносила бы на другой
    регион, а на ПК это уже привело к смене Швейцарии на «лучший» чужой сервер.
    """
    pro = profiles()
    if not pro:
        raise RuntimeError("в подписке нет профилей")
    probes_quick = max(1, int(probes_quick))
    ensure_dirs()
    cur_pi = _num(settings().get("profile_index"), 0)
    targets = [p for p in pro if p["index"] == cur_pi] if keep_profile else pro
    if not targets:
        targets = pro      # профиль вне диапазона — ведём себя как раньше
    state = {
        "running": True, "pid": os.getpid(), "mode": "best", "phase": "quick",
        "profile": cur_pi, "profile_name": "",
        "profiles_total": len(targets), "profiles_done": 0,
        "nodes_total": sum(int(p["node_count"]) for p in targets), "nodes_done": 0,
        "current": "", "current_index": -1, "current_profile": -1,
        "probes": probes_quick, "url": url, "started": time.time(), "finished": 0.0,
        "results": [], "best": None, "error": "", "keep_profile": keep_profile,
    }
    if not _probe_claim(state):
        return {"ok": False, "error": "тест серверов уже идёт"}
    try:
        quick: list[dict] = []
        for p in targets:
            nd = nodes(p["index"])
            for n in nd:
                state["current"] = p["name"].strip() + " · " + n["tag"]
                state["current_index"] = n["index"]
                state["current_profile"] = p["index"]
                _save_probe(state)
                res = probe_node(p["index"], n["index"], probes_quick, url, timeout_quick)
                res["profile"] = p["index"]
                res["profile_name"] = p["name"].strip()
                quick.append(res)
                state["results"] = quick
                state["nodes_done"] = len(quick)
                _save_probe(state)
            state["profiles_done"] += 1
            _save_probe(state)

        alive = sorted((r for r in quick if not r["dead"]), key=lambda r: r["score"])
        best = None
        if alive:
            state["phase"] = "confirm"
            state["current"] = "подтверждение: " + alive[0]["profile_name"] + " · " + alive[0]["tag"]
            _save_probe(state)
            confirmed = probe_node(alive[0]["profile"], alive[0]["index"],
                                   max(probes_quick, probes_final), url, timeout_final)
            confirmed["profile"] = alive[0]["profile"]
            confirmed["profile_name"] = alive[0]["profile_name"]
            best = confirmed if not confirmed["dead"] else next(
                (r for r in alive[1:] if not r["dead"]), None)
        state["phase"] = "done"
        if best:
            state["best"] = {
                "profile_index": best["profile"], "profile_name": best["profile_name"],
                "index": best["index"], "tag": best["tag"], "detail": best["detail"],
                "med": best["med"], "p90": best["p90"], "score": best["score"],
                "loss": best["loss"], "probes": best["probes"],
            }
            if apply:
                if keep_profile:
                    # Авто-подбор: регион не трогаем, только сервер в нём.
                    set_settings(node_index=best["index"])
                    state["applied"] = True
                    state["reconnected"] = False
                    if is_on():
                        cmd_on(best["profile"], best["index"], None, quiet=True)
                        state["reconnected"] = True
                else:
                    set_settings(profile_index=best["profile"], node_index=best["index"])
                    state["applied"] = True
                    state["reconnected"] = False
                    if is_on():
                        cmd_on(best["profile"], best["index"], None, quiet=True)
                        state["reconnected"] = True
        else:
            state["error"] = "ни одна нода не ответила"
    except Exception as exc:  # noqa: BLE001
        state["error"] = str(exc)
    state["running"] = False
    state["finished"] = time.time()
    state["current"] = ""
    state["pid"] = 0
    _save_probe(state)
    return {"ok": not state["error"], **state}


def _proxy_ok(timeout: float = 8.0) -> bool:
    """Работает ли туннель: HTTP-код через локальный SOCKS."""
    out = _run_out(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time",
                    str(timeout), "--socks5-hostname", f"127.0.0.1:{SOCKS_PORT}",
                    "https://www.cloudflare.com/cdn-cgi/trace"], timeout + 3)
    try:
        return int(out or 0) == 200
    except ValueError:
        return False


HEAL_DEADLINE = 150.0   # бюджет одного прогона heal, с


def heal(min_gap: float = 600.0, probes: int = 3, timeout: float = 4.0,
         deadline: float = HEAL_DEADLINE) -> dict:
    """Самовосстановление VPN: перезапуск, при неудаче — лучшая нода профиля.

    Вызывается из монитора работоспособности (bypass-status --health), поэтому
    ограничен по частоте: не чаще одного раза в min_gap секунд.

    Бюджет и лок: прогон укладывается в `deadline` (по умолчанию 150 с — меньше
    внешних таймаутов 180–240 с), весь цикл идёт под ОДНИМ ctrl_lock, а
    `_mark_heal` пишется в начале ремонта. Раньше лок брался дважды (off и on),
    отметка ставилась только в конце, и по таймауту прогон убивали: троттл не
    записан, следующий тик снова рвал туннель.
    """
    if not is_on() and not is_running_any():
        return {"ok": False, "reason": "vpn_off", "actions": []}
    started = time.time()

    def left() -> float:
        return deadline - (time.time() - started)

    with ctrl_lock():
        st = _runtime_dict()
        last = _num(st.get("last_heal"), 0)
        if time.time() - last < min_gap:
            return {"ok": False, "reason": "throttled", "actions": [],
                    "retry_in": int(min_gap - (time.time() - last))}
        actions: list[str] = []
        if is_on() and _proxy_ok():
            return {"ok": True, "actions": ["туннель в порядке"], "checked": True}
        if not is_on():
            # Полумёртвая пара: SOCKS ещё отвечает (xray жив), но sing-box/TUN уже
            # нет. Раньше здесь стояла одна проверка `_proxy_ok()`, и такой VPN
            # объявлялся здоровым: ремонта не было, а `bypass-status` ставил
            # кулдаун на 45 минут — поломка жила до следующего окна.
            actions.append("часть процессов не жива — перезапуск")
        else:
            actions.append("перезапуск VPN")
        # Отметку ставим ДО дорогой части: прогон могут убить по таймауту, и без
        # неё следующий тик немедленно начнёт всё заново.
        _mark_heal(actions)
        _cmd_off(quiet=True)
        try:
            _cmd_on(None, None, None, quiet=True)
        except Exception as exc:  # noqa: BLE001
            actions.append(f"перезапуск не удался: {exc}")
        if is_on() and _proxy_ok():
            _mark_heal(actions)
            return {"ok": True, "actions": actions}
        # перезапуск не помог — пробуем ноды текущего профиля и переключаемся
        deadline_hit = False
        try:
            s = settings()
            pi = _num(s.get("profile_index"), 0)
            nd = nodes(pi)
            results = []
            for n in nd:
                budget = left()
                if budget <= 0:
                    deadline_hit = True
                    break
                # таймаут одной пробы урезаем под остаток бюджета: иначе пробы
                # 14 нод при внешнем таймауте 180–240 с прогон не заканчивали
                per_probe = max(0.5, min(timeout, (budget - 1.0) / max(1, probes)))
                results.append(probe_node(pi, n["index"], probes, PROBE_URL, per_probe,
                                          budget=budget))
            if left() <= 0:
                deadline_hit = True
            alive = sorted((r for r in results if not r["dead"]), key=lambda r: r["score"])
            if alive:
                set_settings(node_index=alive[0]["index"])
                actions.append("переключение на " + alive[0]["tag"])
                if left() > 0:
                    _cmd_on(None, alive[0]["index"], None, quiet=True)
        except Exception as exc:  # noqa: BLE001
            actions.append(f"перебор нод не удался: {exc}")
        ok = (is_on() and _proxy_ok()) if left() > 0 else False
        actions.append("туннель восстановлен" if ok else "туннель не восстановлен")
        _mark_heal(actions)
        if not ok and deadline_hit:
            # бюджет кончился: честно говорим об этом, а не «не восстановлен»
            actions.append(f"дедлайн {int(deadline)} с — перебор нод прерван")
            return {"ok": False, "reason": "deadline", "actions": actions,
                    "deadline": int(deadline)}
        return {"ok": ok, "actions": actions}


def _mark_heal(actions: list) -> None:
    st = _runtime_dict()
    st["last_heal"] = time.time()
    st["last_heal_actions"] = actions
    save_json(RUNTIME, st)


# --------------------------------------------------------------------------- #
# полный сброс («жёсткий тупняк»)
# --------------------------------------------------------------------------- #
# Всё, что перечислено ниже, — транзиентное состояние: блокировки, pid-файлы и
# кэши проверок. Подписка, настройки, маршруты, direct-списки и наборы Re:filter
# не трогаются: после сброса человек возвращается к тем же правилам, а не к
# чистой установке.
RESET_UNITS = ("omavpn-guard.service", "omavpn-autostart.service",
               "omavpn-route-audit.service", "omavpn-route-recheck.service",
               "omavpn-updates.service")
RESET_STATE_FILES = (CTRL_LOCK, XRAY_PID, SB_PID)
RESET_CACHE_FILES = (PROBE_FILE, PROBE_LOCK,
                     CACHE / "health.json", CACHE / "route-audit-state.json",
                     CACHE / "route-audit-recheck.json", CACHE / "route-audit.lock",
                     CACHE / "yt.json", CACHE / "updates.json",
                     # аудит маршрутов держит свой лок в каталоге bypass-status
                     HOME / ".cache" / "bypass-status" / "route-audit.lock")
# Кого добивать по командной строке. Регулярки, а не подстроки: точки в $HOME
# иначе стали бы «любым символом», и поиск задел бы чужие процессы с похожей
# строкой. `--json` необязателен: виджет и bypass-status зовут CLI именно так
# (`omavpn --json on`), и без этой ветки такие прогоны переживали сброс.
# Сначала CLI-прогоны (иначе убитый `on` успеет поднять процесс заново), потом
# сами бинари.
RESET_CLI_PATTERNS = (r"(^|/)omavpn (--json )?(probe|best)( |$)",
                      r"(^|/)omavpn (--json )?(on|off|restart|toggle|heal|route)( |$)",
                      # надзиратель вне systemd: иначе он тут же поднимет VPN
                      r"(^|/)omavpn-guard( |$)")
# Кто держит ctrl.lock: только эти команды. `status`, `refilter`, `subscription`
# лок не берут, поэтому ждать их (и опрос виджета) не нужно.
RESET_BUSY_PATTERN = (r"(^|/)omavpn (--json )?"
                      r"(on|off|restart|toggle|heal|route|best)( |$)")


def _run_quiet(cmd: list, timeout: float = 20.0) -> None:
    try:
        subprocess.run(cmd, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _pgrep(pattern: str) -> list:
    """PID'ы по regexp командной строки — всегда без собственного pid."""
    try:
        proc = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True,
                              timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    me = os.getpid()
    pids = {int(x) for x in (proc.stdout or "").split() if x.isdigit()}
    pids.discard(me)      # pgrep себя не находит, но полагаться на это не будем
    return sorted(pids)


def _kill_matching(pattern: str) -> list:
    """SIGKILL всем, чья командная строка подходит под regexp. → список PID."""
    killed = []
    for pid in _pgrep(pattern):
        try:
            os.kill(pid, signal.SIGKILL)
            killed.append(pid)
        except OSError:
            pass
    return killed


def _wait_no_foreign(timeout: float) -> bool:
    """Ждёт, пока не останется чужих `omavpn`, держащих ctrl.lock."""
    deadline = time.time() + timeout
    while True:
        if not _pgrep(RESET_BUSY_PATTERN):
            return True
        if time.time() >= deadline:
            return False
        time.sleep(0.5)


def reset(restart: bool = True) -> dict:
    """Сбрасывает всё, что могло зависнуть, и поднимает VPN заново.

    Работает даже когда управление заблокировано: `ctrl.lock` не берём вовсе
    (иначе сброс упирался бы в тот самый зависший процесс, из-за которого его и
    запустили), а файл лока просто удаляем — flock живёт на inode, поэтому новый
    захват после этого проходит.
    """
    ensure_dirs()
    was_on = is_on() or bool(_runtime_dict().get("running"))
    errors: list[str] = []
    removed: list[str] = []

    # 1. Службы, которые могут поднять VPN обратно после наших kill. У всех
    # KillMode=process: `stop` убивает только главный процесс юнита, а дочерние
    # `omavpn on/heal/route` остаются жить в его cgroup — добиваем cgroup целиком
    # (best-effort: юнит мог быть не запущен вовсе).
    for unit in RESET_UNITS:
        try:
            proc = subprocess.run(["systemctl", "--user", "stop", "--no-block", unit],
                                  capture_output=True, text=True, timeout=20)
            if proc.returncode != 0:
                msg = (proc.stderr or proc.stdout or "").strip().splitlines()
                # Не установленный юнит — не ошибка: сброс работает и без служб.
                if msg and "not loaded" not in msg[0] and "not found" not in msg[0]:
                    errors.append(f"{unit}: {msg[0][:160]}")
        except (OSError, subprocess.TimeoutExpired) as exc:
            errors.append(f"{unit}: {exc}")
        _run_quiet(["systemctl", "--user", "kill", "-s", "KILL", "--kill-whom=all",
                    unit], timeout=15)

    # 2. Процессы: сначала CLI-прогоны по регуляркам, затем сами бинари (у
    # временных Xray из probe своих pid-файлов нет), затем штатное завершение.
    for pattern in RESET_CLI_PATTERNS:
        _kill_matching(pattern)
    # Бинари запускаются по абсолютному пути, поэтому анкор ^ и хвост (|$)
    # обязательны: иначе шаблон «…/xray» совпал бы с `less ~/.local/share/
    # omavpn/bin/xray.log` и убил бы чужой редактор.
    for pattern in (rf"^{re.escape(str(BIN / 'sing-box'))}( |$)",
                    rf"^{re.escape(str(BIN / 'xray'))}( |$)"):
        _kill_matching(pattern)
    stop_proc(SB_PID, "sing-box", timeout=3.0)
    stop_proc(XRAY_PID, "xray", timeout=3.0)

    # 3. Транзиентные файлы и каталоги.
    for path in (*RESET_STATE_FILES, *RESET_CACHE_FILES):
        try:
            if path.exists():
                path.unlink()
                removed.append(str(path))
        except OSError as exc:
            errors.append(f"{path}: {exc.strerror or exc}")
    if PROBE_DIR.exists():
        shutil.rmtree(PROBE_DIR, ignore_errors=True)
        removed.append(str(PROBE_DIR))

    # 4. Подъём заново — только если VPN был включён и об этом не просили молчать.
    # Перед этим ждём, чтобы чужие omavpn отпустили лок: иначе `on` сразу получит
    # «другой процесс управляет VPN» и вернёт ложную ошибку.
    restarted = False
    if was_on and restart:
        last = ""
        for attempt in range(3):
            if not _wait_no_foreign(6.0):
                last = "другие процессы omavpn не завершились"
                continue
            try:
                cmd_on(None, None, None, quiet=True)
                restarted = True
                break
            except Exception as exc:  # noqa: BLE001 — сброс уже сделан, это отдельный итог
                last = str(exc)
                time.sleep(1.0 + attempt)
        if not restarted:
            errors.append("VPN не поднялся после сброса: " + (last or "неизвестная ошибка"))
    if not restarted:
        # Процессов нет, а в state.json осталось running=true — иначе сторож
        # решит, что VPN упал сам, и начнёт лечить только что сброшенное.
        st = _runtime_dict()
        st["running"] = False
        if errors:
            st["last_error"] = errors[-1]
        save_json(RUNTIME, st)

    return {"ok": not errors, "was_on": was_on, "restarted": restarted,
            "removed": removed, "errors": errors}


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

JSON_OUT = False
# Был ли `--json` в argv: нужно ещё до `parse_args`, чтобы ошибки разбора тоже
# уходили JSON'ом в stdout (см. `_JsonParser`).
_JSON_ARGV = False


def emit(data, human: str = "") -> None:
    if JSON_OUT:
        print(json.dumps(data, ensure_ascii=False))
    elif human:
        print(human)


def refilter_text(res: dict) -> str:
    """Строка для человека: состояние, объём и дата списка."""
    state = "включён" if res.get("enabled") else "выключен"
    if res.get("loaded"):
        mb = res.get("total_bytes", 0) / 1048576
        load = (f"список загружен ({mb:.1f} МБ)".replace(".", ",")
                + (f" · обновлён {res['updated_text']}" if res.get("updated_text") else ""))
    else:
        load = "список не загружен — `omavpn refilter update`"
    return f"Re:filter: {state} · {load}"


def _add_json(parser: argparse.ArgumentParser) -> argparse.ArgumentParser:
    """`--json` после подкоманды — как у `route list`: omavpn refilter status --json."""
    parser.add_argument("--json", dest="sub_json", action="store_true",
                        help="вывод в JSON (то же, что omavpn --json ...)")
    return parser


class _JsonParser(argparse.ArgumentParser):
    """argparse, который под `--json` отвечает JSON-ошибкой в stdout.

    `parse_args` вызывается до установки `JSON_OUT`, и ошибки разбора (например
    `omavpn --json node abc`) давали rc=2, usage в stderr и ПУСТОЙ stdout:
    потребитель (виджет, аудит) не видел ни JSON, ни причины. Флаг ищем в argv
    заранее — иначе под --json он узнаётся слишком поздно.
    """

    def error(self, message: str):
        if _JSON_ARGV:
            print(json.dumps({"ok": False, "error": f"{self.prog}: {message}"},
                             ensure_ascii=False))
            sys.exit(2)
        super().error(message)


def main(argv: list) -> int:
    global JSON_OUT, _JSON_ARGV
    os.umask(0o077)  # приватные каталоги/файлы состояния и кэша по умолчанию
    _JSON_ARGV = "--json" in argv
    p = _JsonParser(prog="omavpn", description="Xray + TUN клиент для Omarchy")
    p.add_argument("--json", action="store_true", help="вывод в JSON")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("update", help="обновить подписку")
    sub.add_parser("profiles", help="список профилей")
    sub.add_parser("nodes", help="ноды текущего профиля")
    sub.add_parser("status", help="текущий статус")
    sub.add_parser("on", help="подключить")
    sub.add_parser("off", help="отключить")
    sub.add_parser("restart", help="перезапустить")
    sub.add_parser("toggle", help="переключить")
    sub.add_parser("check", help="проверить внешний IP")
    sub.add_parser("logs", help="хвост логов")

    spb = sub.add_parser("probe", help="протестировать серверы профиля (временный Xray + пробы)")
    spb.add_argument("--profile", type=int, default=None, help="индекс профиля (по умолчанию текущий)")
    spb.add_argument("--probes", type=int, default=PROBE_DEFAULT_PROBES, help="проб на сервер")
    spb.add_argument("--url", default=PROBE_URL, help="URL пробы")
    spb.add_argument("--timeout", type=float, default=PROBE_DEFAULT_TIMEOUT,
                     help="таймаут одной пробы, с")
    spb.add_argument("--node", type=int, default=None,
                     help="протестировать только один сервер (индекс из `nodes`)")

    sb = sub.add_parser("best", help="протестировать все регионы и серверы, выбрать лучшую пару")
    sb.add_argument("--apply", action="store_true",
                    help="применить лучшую пару (и переподключиться, если VPN включён)")
    sb.add_argument("--keep-profile", action="store_true",
                    help="не менять регион, только сервер в текущем (авто-подбор)")
    sb.add_argument("--probes-quick", type=int, default=2, help="проб на сервер в быстром проходе")
    sb.add_argument("--timeout-quick", type=float, default=3.5, help="таймаут быстрой пробы, с")
    sb.add_argument("--probes-final", type=int, default=6, help="проб на лучший сервер при подтверждении")
    sb.add_argument("--timeout-final", type=float, default=6.0, help="таймаут подтверждающей пробы, с")
    sb.add_argument("--url", default=PROBE_URL, help="URL пробы")
    sub.add_parser("heal", help="самовосстановление VPN (перезапуск/переключение ноды)")

    sp = sub.add_parser("profile", help="выбрать профиль")
    sp.add_argument("index", type=int)
    sn = sub.add_parser("node", help="выбрать ноду (-1 = авто)")
    sn.add_argument("index", type=int)
    sm = sub.add_parser("mode", help="режим: tun | proxy")
    sm.add_argument("value", choices=["tun", "proxy"])
    ss = sub.add_parser("strict", help="strict_route вкл/выкл")
    ss.add_argument("value", choices=["on", "off"])

    # Re:filter — списки заблокированных в РФ доменов/IP, которые идут в туннель.
    srf = sub.add_parser("refilter", help="Re:filter: заблокированное в РФ — через VPN")
    rfsub = srf.add_subparsers(dest="refilter_cmd")
    _add_json(rfsub.add_parser("status", help="состояние списка и настройки"))
    _add_json(rfsub.add_parser("on", help="включить (заблокированное — через VPN)"))
    _add_json(rfsub.add_parser("off", help="выключить (как до Re:filter)"))
    rfu = _add_json(rfsub.add_parser("update", help="скачать свежие списки"))
    rfu.add_argument("--no-restart", action="store_true",
                     help="не перезапускать VPN после обновления (таймер, тесты)")

    # URL подписки: посмотреть и заменить (старый не теряется при ошибке).
    ssub = sub.add_parser("subscription", help="URL подписки: get | set <url>")
    ssubsub = ssub.add_subparsers(dest="sub_cmd")
    _add_json(ssubsub.add_parser("get", help="текущий URL подписки"))
    sset = _add_json(ssubsub.add_parser("set", help="заменить URL подписки"))
    sset.add_argument("url")
    sset.add_argument("--no-restart", action="store_true",
                      help="не перезапускать VPN (URL применится при следующем on)")

    # Полный сброс: снять блокировки и кэши, поднять VPN заново.
    sreset = _add_json(sub.add_parser("reset", help="полный сброс: остановить всё и поднять VPN"))
    sreset.add_argument("--no-restart", action="store_true",
                        help="не поднимать VPN после сброса")

    # Маршруты доменов: ручные оверрайды direct/proxy поверх direct_domains.txt.
    srt = sub.add_parser("route", help="маршрут домена: оверрайды proxy/direct")
    rsub = srt.add_subparsers(dest="route_cmd")
    rlist = rsub.add_parser("list", help="таблица маршрутов: домен, путь, источник, возраст")
    # --json понимаем и здесь (не только до подкоманды): omavpn route list --json
    rlist.add_argument("--json", dest="route_json", action="store_true",
                       help="вывод в JSON (то же, что omavpn --json route list)")
    rset = rsub.add_parser("set", help="поставить оверрайд маршрута домена")
    rset.add_argument("domain")
    rset.add_argument("path", choices=list(ROUTE_PATHS))
    rset.add_argument("--reason", default="", help="почему так (сохраняется в оверрайде)")
    rset.add_argument("--no-restart", action="store_true",
                      help="не перезапускать VPN (правило применится при следующем on)")
    runset = rsub.add_parser("unset", help="снять оверрайд домена")
    runset.add_argument("domain")
    runset.add_argument("--no-restart", action="store_true",
                        help="не перезапускать VPN")

    args = p.parse_args(argv)
    JSON_OUT = args.json or getattr(args, "route_json", False) \
        or getattr(args, "sub_json", False)

    try:
        if args.cmd == "update":
            # update_sub() меняет только кэш подписки. Если провайдер сменил
            # ключи/адреса, работающий Xray остаётся со старым конфигом: SOCKS
            # жив, но сервер отвергает рукопожатие — и вместе с ним умирает
            # DNS, который sing-box гонит через SOCKS. Поэтому после реального
            # изменения подписки перезапускаем туннель (если он был включён).
            before = load_json(SUBFILE, {})
            old_stamp = before.get("updated") if isinstance(before, dict) else None
            cfg = update_sub()
            after = load_json(SUBFILE, {})
            new_stamp = after.get("updated") if isinstance(after, dict) else None
            changed = new_stamp != old_stamp
            restarted = False
            restart_error = ""
            if changed and (is_on() or bool(_runtime_dict().get("running"))):
                try:
                    cmd_on(None, None, None, quiet=True)
                    restarted = True
                except Exception as exc:  # noqa: BLE001
                    restart_error = str(exc)
            pro = [{"index": i, "name": str(c.get("remarks") or i).strip(),
                    "node_count": len(node_outbounds(c))} for i, c in enumerate(cfg)]
            payload = {"ok": True, "profiles": pro, "changed": changed,
                       "restarted": restarted}
            if restart_error:
                payload["ok"] = False
                payload["error"] = ("подписка обновлена, но VPN не перезапустился: "
                                    + restart_error)
            emit(payload, "\n".join(f"{x['index']}: {x['name']}" for x in pro)
                 + (" · перезапущено" if restarted else ""))
        elif args.cmd == "profiles":
            pro = profiles()
            emit({"ok": True, "profiles": pro},
                 "\n".join(f"{x['index']}: {x['name']} ({x['node_count']})" for x in pro))
        elif args.cmd == "nodes":
            nd = nodes(settings_profile())
            emit({"ok": True, "nodes": nd},
                 "\n".join(f"{x['index']}: {x['tag']} · {x['detail']}" for x in nd))
        elif args.cmd == "status":
            st = status()
            emit(st, status_text(st))
        elif args.cmd == "on":
            res = cmd_on(None, None, None)
            emit(res, on_text(res))
        elif args.cmd == "off":
            emit(cmd_off(), "Отключено")
        elif args.cmd == "restart":
            with ctrl_lock():  # off+on — одна операция, лок на обе половины
                cmd_off(quiet=True)
                res = cmd_on(None, None, None)
            emit(res, "Перезапущено")
        elif args.cmd == "toggle":
            if is_on():
                emit(cmd_off(), "Отключено")
            else:
                res = cmd_on(None, None, None)
                emit(res, on_text(res))
        elif args.cmd == "profile":
            # проверка ДО записи: иначе индекс вне диапазона ломал все запуски
            idx = check_profile(args.index)
            choose(profile_index=idx, node_index=-1)
            emit({"ok": True, "profile_index": idx}, f"Профиль: {idx}")
        elif args.cmd == "node":
            idx = check_node(settings_profile(), args.index)
            choose(node_index=idx)
            emit({"ok": True, "node_index": idx}, f"Нода: {idx}")
        elif args.cmd == "mode":
            choose(mode=args.value)
            emit({"ok": True, "mode": args.value}, f"Режим: {args.value}")
        elif args.cmd == "strict":
            strict_on = args.value == "on"
            choose(strict_route=strict_on)
            emit({"ok": True, "strict_route": strict_on},
                 f"strict_route: {'включён' if strict_on else 'выключен'}")
        elif args.cmd == "check":
            res = check()
            emit(res, check_text(res))
        elif args.cmd == "logs":
            tail = {"xray": log_tail(XRAY_LOG, 40), "sing-box": log_tail(SB_LOG, 40)}
            emit({"ok": True, **tail}, f"xray: {tail['xray']}\n\nsing-box: {tail['sing-box']}")
        elif args.cmd == "refilter":
            if args.refilter_cmd == "status":
                st = refilter_status()
                emit(st, refilter_text(st))
            elif args.refilter_cmd in ("on", "off"):
                on = args.refilter_cmd == "on"
                res = refilter_set(on)
                note = " · перезапущено" if res["restarted"] else \
                    (" · " + res["note"] if res["note"] else "")
                emit(res, f"Re:filter: {'включён' if res['enabled'] else 'выключен'}{note}")
                # Сбой загрузки списка или перезапуска — ненулевой код, как у
                # update/subscription: настройка записана, но не всё сработало.
                return 0 if res["ok"] else 1
            elif args.refilter_cmd == "update":
                res = refilter_update(not args.no_restart)
                if res.get("skipped"):
                    # Выключено — не качали и туннель не трогали. Это не ошибка.
                    text = res.get("note") or "Re:filter выключен — списки не обновляю"
                elif res["changed"]:
                    text = "список обновлён" + (" · перезапущено" if res["restarted"] else "")
                elif res["ok"]:
                    text = "изменений нет"
                else:
                    text = "не обновилось"
                if res["errors"]:
                    text += ": " + "; ".join(res["errors"])
                emit(res, text)
                # Ненулевой код — чтобы таймер и установщик видели сбой сети.
                return 0 if res["ok"] else 1
            else:
                if JSON_OUT:
                    fail("refilter: не указана подкоманда (status | on | off | update)", 2)
                srf.print_help()
                return 0
        elif args.cmd == "subscription":
            if args.sub_cmd == "get":
                res = subscription_get()
                emit(res, res["url"] or "(URL подписки не задан)")
            elif args.sub_cmd == "set":
                res = subscription_set(args.url, not args.no_restart)
                if not res["changed"]:
                    text = f"URL подписки не изменился: {res['url']}"
                elif not res["ok"]:
                    # Адрес уже новый и рабочий — не выдаём это за полный успех.
                    text = res.get("error") or "адрес сменён, VPN не перезапустился"
                else:
                    text = "URL подписки сохранён" + (" · VPN перезапущен" if res["restarted"] else "")
                emit(res, text)
                return 0 if res["ok"] else 1
            else:
                if JSON_OUT:
                    fail("subscription: не указана подкоманда (get | set <url>)", 2)
                ssub.print_help()
                return 0
        elif args.cmd == "reset":
            res = reset(not args.no_restart)
            parts = ["VPN был включён" if res["was_on"] else "VPN был выключен"]
            parts.append("поднят заново" if res["restarted"] else "без подъёма")
            parts.append(f"удалено файлов: {len(res['removed'])}")
            if res["errors"]:
                parts.append("ошибки: " + "; ".join(res["errors"]))
            emit(res, "Сброс: " + " · ".join(parts))
            return 0 if res["ok"] else 1
        elif args.cmd == "route":
            if args.route_cmd == "list":
                rows = route_entries()
                over = route_overrides()
                emit({"ok": True, "file": str(ROUTE_OVERRIDES_FILE),
                      "overrides": [{"domain": dom, **ent} for dom, ent in over.items()],
                      # списки «всегда» нужны аудиту маршрутов: он не имеет права
                      # уводить их на противоположный путь (см. docs/route-audit.md)
                      "always_direct": list(ALWAYS_DIRECT_DOMAINS),
                      "always_proxy": list(ALWAYS_PROXY_DOMAINS),
                      "routes": rows}, route_table_text(rows))
            elif args.route_cmd == "set":
                res = route_set(args.domain, args.path, args.reason, not args.no_restart)
                note = " · перезапущено" if res["restarted"] else " · " + (res["note"] or "без перезапуска")
                emit(res, f"{res['domain']} → {res['path']}{note}")
            elif args.route_cmd == "unset":
                res = route_unset(args.domain, not args.no_restart)
                if not res["removed"]:
                    text = f"{res['domain']}: оверрайда не было"
                else:
                    text = (f"{res['domain']}: снят оверрайд {res['previous']}"
                            + (" · перезапущено" if res["restarted"]
                               else " · " + (res["note"] or "без перезапуска")))
                emit(res, text)
            else:
                # под --json справка в stdout ломала бы разбор JSON у потребителей
                if JSON_OUT:
                    fail("route: не указана подкоманда (list | set | unset)", 2)
                srt.print_help()
                return 0
        elif args.cmd == "best":
            res = probe_best(args.probes_quick, args.timeout_quick, args.probes_final,
                             args.timeout_final, args.url, args.apply, args.keep_profile)
            b = res.get("best") or {}
            if res.get("error") and not b:
                lines = [str(res["error"])]
            else:
                lines = [f"лучший регион: {b.get('profile_name','?')} · сервер #{b.get('index')} "
                         f"{b.get('tag','?')} · med {b.get('med')} с · p90 {b.get('p90')} с"]
                if res.get("applied"):
                    lines.append("применено" + (" и переподключено" if res.get("reconnected") else ""))
            emit(res, "\n".join(lines))
        elif args.cmd == "heal":
            res = heal()
            emit(res, "; ".join(res.get("actions") or [res.get("reason", "нечего лечить")]))
        elif args.cmd == "probe":
            res = probe_all(args.profile, args.probes, args.url, args.timeout, args.node)
            lines = []
            for r in res.get("results", []):
                if r["dead"]:
                    lines.append(f"{r['index']:>2} {r['tag']:<14} DEAD · {r['note'] or 'нет ответа'}")
                else:
                    lines.append(f"{r['index']:>2} {r['tag']:<14} med {r['med']}s  p90 {r['p90']}s  "
                                 f"потери {r['loss']}/{r['probes']}  score {r['score']}")
            if res.get("best"):
                lines.append(f"лучшая: #{res['best']['index']} {res['best']['tag']} "
                             f"({res['best']['med']}s)")
            emit(res, "\n".join(lines) or str(res.get("error") or "тест не выполнен"))
        else:
            # --json без команды: справка в stdout ломала разбор JSON → ошибка + rc=2
            if JSON_OUT:
                fail("не указана команда (см. omavpn --help)", 2)
            p.print_help()
            return 0
    except RuntimeError as exc:
        fail(str(exc))
    except urllib.error.URLError as exc:  # noqa: F821
        fail(f"сеть недоступна: {exc}")
    except Exception as exc:  # noqa: BLE001
        # последняя страховка: под --json потребитель должен получить JSON, а не
        # трейсбек — иначе виджет решает, что VPN не установлен
        fail(f"{type(exc).__name__}: {exc}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
