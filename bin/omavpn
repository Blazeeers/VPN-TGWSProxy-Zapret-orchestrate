# прокси и логин/связь с узлами tailnet не работают.
ALWAYS_DIRECT_DOMAINS = [
    "max.ru",
    # DeepSeek API нужен ассистенту (opencode/websearch): через зарубежный выход
    # VPN он периодически рвётся, а напрямую из РФ работает стабильно. Поэтому
    # он ВСЕГДА идёт мимо туннеля и не может быть выкинут автоподбором zapret.
    "deepseek.com",
    "deepseek.ai",
    "yandex.ru",
    "ya.ru",
    "yandex.com",
    "yandex.net",
    "yandex-team.ru",
    "yastatic.net",
    "tailscale.com",
    "tailscale.io",
    "ts.net",
]

# DNS для «прямых» доменов в TUN-режиме. Все остальные домены резолвятся через
# туннель (`remote`), но для доменов из ALWAYS_DIRECT_DOMAINS зарубежный
# резолвер вреден: max.ru/яндекс должны получать российский адрес, иначе прямой
# путь до них ломается. Проверено 23.10.2026: 77.88.8.8 отдаёт для max.ru
# 155.212.204.5 и отвечает за ~55 мс (через туннель — ~3 с).
RU_DNS = "77.88.8.8"

# Домены, которые ВСЕГДА идут через VPN — даже если zapret-autotune вернул их
# в direct_domains.txt. Причина (проверено 22.10.2026): youtubei.googleapis.com
# блокируется наглухо напрямую (все IP — таймаут 10 с), а zapret его не пробивает,
# потому что домена нет в /opt/zapret/ipset/zapret-hosts-user.txt. Без этого API
# страница YouTube висит по 10 секунд при живом видео. Сам видеопоток
# (googlevideo.com) и картинки (ytimg.com) остаются на обходе — там 24 МБ/с.
# Правило для этих доменов ставится ПЕРЕД direct-правилом, поэтому даже
# перезапись direct_domains.txt их не вытолкнет из туннеля.
ALWAYS_PROXY_DOMAINS = [
    "youtubei.googleapis.com",
    "youtube.googleapis.com",
]

# Видео YouTube: встроенные direct-домены, которые НЕ зависят от
