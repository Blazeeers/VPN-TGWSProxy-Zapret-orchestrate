#!/usr/bin/env python3
"""bypass-status — агрегированный статус всех «обходов» для виджета панели.

Печатает JSON с состоянием: VPN (omavpn/wowvpn), zapret + автотюн,
tg-ws-proxy и direct-список. Зависимостей нет, root не нужен.

    bypass-status            # JSON
    bypass-status --check    # JSON + живые проверки доступности (медленнее)
"""
from __future__ import annotations

import argparse
import concurrent.futures
