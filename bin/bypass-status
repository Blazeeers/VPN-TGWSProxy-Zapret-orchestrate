# давал по два обрыва трафика каждые 10 минут: аудит уводил домен в direct,
# проба умирала, он откатывал — и через десять минут всё повторялось. Теперь
# попытка в каждую сторону не чаще 6 ч × 2^fails (подряд не вышло — ждём
# дольше, до 48 ч), а удачная попытка сбрасывает счётчик.
ROUTE_STATE_GAP = 6 * 3600         # базовый интервал между попытками в одну сторону
ROUTE_STATE_MAX_DOUBLINGS = 3      # 6 ч → 12 → 24 → 48 ч, дальше не растёт

