# --- аудит маршрутов -------------------------------------------------------
# Домен, недоступный текущим маршрутом, переводится на рабочий: override в
# ~/.config/<app>/route_overrides.json (его читает omavpn при сборке sing-box).
ROUTE_AUDIT_MAX_AGE = 30 * 60
ROUTE_AUDIT_LOCK = os.path.join(HOME, ".cache", "bypass-status", "route-audit.lock")
ROUTE_AUDIT_REASON = "аудит: direct не отвечает"
ROUTE_AUDIT_REASON_BACK = "аудит: proxy не отвечает"
# По этому префиксу аудит узнаёт собственные оверрайды: ручные (`omavpn route
# set`) не снимаются перепроверкой и не перебиваются аудитом никогда.
ROUTE_REASON_PREFIX = "аудит"
ROUTE_RECHECK_AGE = 24 * 3600      # оверрайд proxy старше суток перепроверяем
ROUTE_RECHECK_GAP = 20 * 3600      # но сам перепроверочный прогон — не чаще раза в 20 ч
ROUTE_PROBE_TIMEOUT = 10           # больше 10 с на пробу не ждём
ROUTE_SETTLE = 2.0                 # пауза после перезапуска: TUN перечитывает правила
# Кулдаун переключений между прогонами (гистерезис). Без него выключенный обход
# давал по два обрыва трафика каждые 10 минут: аудит уводил домен в direct,
# проба умирала, он откатывал — и через десять минут всё повторялось. Теперь
# попытка в каждую сторону не чаще 6 ч × 2^fails (подряд не вышло — ждём
# дольше, до 48 ч), а удачная попытка сбрасывает счётчик.
ROUTE_STATE_GAP = 6 * 3600         # базовый интервал между попытками в одну сторону
ROUTE_STATE_MAX_DOUBLINGS = 3      # 6 ч → 12 → 24 → 48 ч, дальше не растёт

# Домены, которые живут обходом DPI, а не туннелем. Прямой путь у них есть
# только при работающем zapret с подобранной стратегией: если обход выключен или
# autotune счёл его нерабочим, «direct не отвечает» ничего не значит, и
# переводить туда домен нельзя (это и был блокер 2.2.1). Остальные домены
# (deepseek, telegram) от zapret не зависят — предохранитель к ним не применяем.
BYPASS_DEPENDENT_DOMAINS = (
    "youtube.com",
    "youtu.be",
    "ytimg.com",
    "ggpht.com",
    "googlevideo.com",
    "youtube-nocookie.com",
    "discord.com",
    "discord.gg",
    "discordapp.com",
    "discordapp.net",
)

