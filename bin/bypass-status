def run(cmd: list[str], timeout: float = 8.0) -> str:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (p.stdout or "").strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def resolve_cli() -> tuple[str, str]:
    """(app_name, cli_path). Поддерживает оба имени — omavpn и wowvpn."""
    for env in ("OMAVPN_CLI", "BYPASS_CLI"):
        path = os.environ.get(env)
        if path and os.path.exists(path):
            return os.path.basename(path), path
    for name in APP_CANDIDATES:
        path = shutil.which(name) or os.path.join(HOME, ".local", "bin", name)
        if os.path.exists(path):
            return name, path
    return "", ""


def fmt_uptime(seconds: int) -> str:
    seconds = max(0, int(seconds))
    h, m, s = seconds // 3600, (seconds % 3600) // 60, seconds % 60
    return (f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}")


def wan_iface() -> str:
    for line in run(["ip", "-o", "route", "show", "default"]).splitlines():
        parts = line.split()
        if "dev" in parts:
            dev = parts[parts.index("dev") + 1]
            if "vpn0" in dev or dev.startswith(("tun", "tailscale")):
                continue
            return dev
    return ""


def net_key(iface: str) -> str:
    ssid = run(["iwgetid", "-r", iface]) if iface else ""
    if not ssid:
        name = run(["nmcli", "-t", "-f", "GENERAL.CONNECTION", "device", "show", iface]) if iface else ""
        ssid = name.strip().split(":")[-1] if name else ""
    if ssid:
        key = f"wifi-{ssid}"
    else:
        gw = run(["ip", "route", "show", "default"])
        gw = gw.split("via ")[1].split()[0] if "via " in gw else ""
        mac = run(["ip", "neigh", "show", gw]) if gw else ""
        mac = mac.split("lladdr ")[1].split()[0] if "lladdr " in mac else gw
        key = f"net-{iface or 'unknown'}-{mac or 'unknown'}"
    return "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in key)


def vpn_status(cli: str) -> dict:
    if not cli:
        return {"installed": False, "running": False}
    raw = run([cli, "--json", "status"], timeout=10)
    try:
        d = json.loads(raw)
    except ValueError:
        return {"installed": False, "running": False}
    return {
        "installed": bool(d.get("installed")),
        "running": bool(d.get("running")),
        "caps_ok": d.get("caps_ok"),
        "mode": d.get("mode", ""),
        "profile": d.get("profile_name", ""),
        "node": d.get("node_name", ""),
        "uptime": int(d.get("uptime") or 0),
        "uptime_text": fmt_uptime(d.get("uptime") or 0),
        "rx": int(d.get("rx") or 0),
        "tx": int(d.get("tx") or 0),
        "error": d.get("last_error", ""),
    }


def autotune_retry_seconds() -> int:
    try:
        for line in open("/etc/zapret-autotune.conf", encoding="utf-8"):
            if line.strip().startswith("RETRY_SECONDS="):
                return int((line.split("=", 1)[1].strip() or "1800"))
    except (OSError, ValueError):
        pass
    return 1800


def _cache_text(key: str, suffix: str) -> str:
    try:
        return open(os.path.join(AUTOTUNE_DIR, f"{key}.{suffix}"), encoding="utf-8").read().strip()
    except OSError:
        return ""


def probe_state() -> dict:
    """Состояние фонового подбора (пишет zapret-autotune во время сканирования)."""
    path = os.path.join(AUTOTUNE_DIR, "probe.json")
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if data.get("active") else {}


def zapret_status(iface: str) -> dict:
    key = net_key(iface)
    mode = ""
    try:
        mode = open(os.path.join(AUTOTUNE_DIR, f"{key}.strategy"), encoding="utf-8").read().strip()
    except OSError:
        pass
    st = {
        "service": run(["systemctl", "is-active", "zapret.service"]) or "unknown",
        "autotune": run(["systemctl", "is-active", "zapret-autotune.service"]) or "unknown",
        "timer": run(["systemctl", "is-active", "zapret-autotune.timer"]) or "unknown",
        "iface": iface,
        "network": key,
        "mode": mode,
        "testing": False,
    }
    ps = probe_state()
    if ps:
        st["testing"] = True
        st["tested"] = int(ps.get("index") or 0)
        st["total"] = int(ps.get("total") or 0)
        st["strategy"] = ps.get("strategy", "")
        st["isolated"] = bool(ps.get("isolated"))

    retry = autotune_retry_seconds()
    last = 0
    try:
        last = int(open(os.path.join(AUTOTUNE_DIR, f"{key}.lastscan"), encoding="utf-8").read().strip() or "0")
    except (OSError, ValueError):
        last = 0
    st["retry_seconds"] = retry
    st["retry_in"] = max(0, retry - (int(time.time()) - last)) if last else 0
    st["services"] = _cache_text(key, "services")
    st["direct"] = _cache_text(key, "direct")
    return st


def port_open(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.4)
        return s.connect_ex(("127.0.0.1", port)) == 0


def tgwsproxy_status() -> dict:
    running = bool(run(["pgrep", "-x", "tg-ws-proxy"]))
    conf = os.path.join(HOME, ".config", "TgWsProxy", "config.json")
    port = 1443
    try:
        port = int(json.load(open(conf, encoding="utf-8")).get("port", 1443))
    except (OSError, ValueError):
        pass
    return {"running": running, "port": port, "listening": port_open(port)}


def direct_status(app: str) -> dict:
    path = os.path.join(HOME, ".config", app, "direct_domains.txt") if app else ""
    count, has_file = 0, bool(path and os.path.exists(path))
    if has_file:
        try:
            count = sum(1 for l in open(path, encoding="utf-8") if l.strip() and not l.startswith("#"))
        except OSError:
            pass
    return {"file": path if has_file else "", "count": count}


def _http_code(url: str, timeout: int = 12) -> int:
    out = run(["curl", "-4", "-s", "-L", "-o", "/dev/null", "-w", "%{http_code}",
               "--max-time", str(timeout), url], timeout=timeout + 3)
    try:
        return int(out or 0)
    except ValueError:
        return 0


YTDLP = shutil.which("yt-dlp")
MIN_YT_BYTES = 131072
MIN_YT_KBPS = 100


def youtube_video_check() -> dict:
    """Качает кусок видео с googlevideo.com и меряет скорость — ловит троттлинг.

    Страница может открываться, а видео при этом не грузиться: тогда прямой
    youtube работать «нормально» не считается.
    """
    if YTDLP:
        url = ""
        try:
            proc = subprocess.run(
                [YTDLP, "-q", "--no-warnings", "-f", "worst", "-g",
                 f"https://www.youtube.com/watch?v={YT_TEST_VIDEO}"],
                capture_output=True, text=True, timeout=45)
            lines = (proc.stdout or "").strip().splitlines()
            url = lines[0] if lines else ""
        except (OSError, subprocess.TimeoutExpired):
            url = ""
        if not url:
            return {"ok": False, "error": "yt-dlp не вернул ссылку"}
        out = run(["curl", "-4", "-sL", "--max-time", "25", "-o", "/dev/null",
                   "-r", "0-262143", "-w", "%{http_code} %{size_download} %{time_total}",
                   url], timeout=30)
        parts = out.split()
        if len(parts) != 3:
            return {"ok": False, "error": "googlevideo не ответил"}
        code, size, secs = parts
        size_i = int(float(size))
        secs_f = float(secs) or 0.001
        kbps = round((size_i / 1024) / secs_f)
        ok = code in ("200", "206") and size_i >= MIN_YT_BYTES and kbps >= MIN_YT_KBPS
        return {"ok": ok, "code": code, "bytes": size_i, "secs": round(secs_f, 2),
                "kbps": kbps, "method": "yt-dlp"}
    # без yt-dlp — грубая проверка доступности (без скорости)
    page = _http_code(f"https://www.youtube.com/watch?v={YT_TEST_VIDEO}")
    cdn = _http_code("https://redirector.googlevideo.com/")
    return {"ok": page in (200, 301, 302) and cdn != 0, "page": page, "cdn": cdn,
            "method": "reachability"}


def youtube_status(check_video: bool = True) -> dict:
    page = _http_code("https://www.youtube.com/")
    thumb = _http_code(f"https://i.ytimg.com/vi/{YT_TEST_VIDEO}/hqdefault.jpg")
    video = youtube_video_check() if check_video else {}
    ok = page in (200, 201, 301, 302) and bool(video.get("ok")) if check_video else page in (200, 201, 301, 302)
    return {"checked": time.time(), "page": page, "thumb": thumb, "video": video, "ok": bool(ok)}


def write_json_cache(app: str, name: str, data: dict) -> None:
    if not app:
        return
    path = os.path.join(HOME, ".cache", app, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False)
    os.replace(tmp, path)


def cached_youtube(app: str) -> dict:
    path = os.path.join(HOME, ".cache", app, "yt.json") if app else ""
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if time.time() - float(data.get("checked") or 0) > YOUTUBE_CACHE_AGE:
        return {}
    return data


def scan_running() -> bool:
    """Идёт ли прямо сейчас подбор стратегий zapret."""
    for unit in ("zapret-autotune-rescan.service", "zapret-autotune.service"):
        state = run(["systemctl", "is-active", unit]) or ""
        if state not in ("", "inactive", "failed", "unknown"):
            return True
    return False


def request_rescan() -> dict:
    """Просит zapret-autotune перепроверить стратегии (через systemd path-юнит)."""
    if scan_running():
        return {"ok": False, "reason": "already_running", "message": "перебор уже идёт"}
    os.makedirs(os.path.dirname(RESCAN_REQUEST), exist_ok=True)
    try:
        os.remove(RESCAN_REQUEST)  # чтобы path-юнит точно увидел создание файла
    except OSError:
        pass
    with open(RESCAN_REQUEST, "w", encoding="utf-8") as handle:
        handle.write(str(time.time()))
    return {"ok": True, "request": RESCAN_REQUEST, "message": "перебор запрошен — стратегии тестируются"}


def read_vpn_test(app: str) -> dict:
    """Свежие прогресс/результаты теста серверов VPN (или {})."""
    best = {}
    for name in (app, *PROBE_APPS):
        if not name:
            continue
        try:
            data = json.load(open(os.path.join(HOME, ".cache", name, "probe.json"), encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and float(data.get("updated") or 0) > float(best.get("updated") or 0):
            best = data
    if not best:
        return {}
    if best.get("running"):
        pid = int(best.get("pid") or 0)
        if not (pid > 0 and os.path.exists(f"/proc/{pid}")) \
                and (time.time() - float(best.get("updated") or 0)) > 30:
            best["running"] = False
            best["stale"] = True
    elif time.time() - float(best.get("finished") or best.get("updated") or 0) > PROBE_MAX_AGE:
        return {}
    return best


def start_vpn_test(cli: str) -> dict:
    """Запускает тест серверов (omavpn probe) фоном; прогресс читается из кэша."""
    if not cli:
        return {"ok": False, "error": "VPN CLI не найден"}
    state = read_vpn_test(os.path.basename(cli))
    if state.get("running"):
        return {"ok": False, "reason": "already_running", "message": "тест серверов уже идёт"}
    return _spawn_probe(cli, ["probe"],
                        "тест серверов запущен — пробы идут в фоне")


def start_optimize(cli: str) -> dict:
    """Тест всех регионов и серверов → применить лучшую пару (фоном)."""
    if not cli:
        return {"ok": False, "error": "VPN CLI не найден"}
    state = read_vpn_test(os.path.basename(cli))
    if state.get("running"):
        return {"ok": False, "reason": "already_running", "message": "тест серверов уже идёт"}
    return _spawn_probe(cli, ["best", "--apply"],
                        "подбираю лучший регион и сервер — пробы идут в фоне")


def _spawn_probe(cli: str, args: list, message: str) -> dict:
    app = os.path.basename(cli)
    log = os.path.join(HOME, ".cache", app, "probe.out")
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        handle = open(log, "ab")
    except OSError as exc:
        return {"ok": False, "error": f"нет доступа к {log}: {exc}"}
    try:
        subprocess.Popen([cli, "--json", *args], stdin=subprocess.DEVNULL,
                         stdout=handle, stderr=handle, start_new_session=True)
    except OSError as exc:
        return {"ok": False, "error": f"не удалось запустить тест: {exc}"}
    finally:
        handle.close()
    return {"ok": True, "started": True, "message": message}


def live_checks() -> dict:
    def code(url: str) -> int:
        out = run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "12", url], timeout=15)
        try:
            return int(out or 0)
        except ValueError:
            return 0

    return {
        "yandex": code("https://yandex.ru/"),
        "telegram_api": code("https://api.telegram.org/"),
        "youtube": code("https://www.youtube.com/"),
        "discord": code("https://discord.com/"),
    }


# --------------------------------------------------------------------------- #
# комплексная проверка текущей конфигурации (монитор работоспособности)
# --------------------------------------------------------------------------- #

def _http(url: str, timeout: float = 10.0, proxy: str = "") -> tuple[int, float, str]:
    """(код, секунды, тело[для коротких ответов]). proxy — http://host:port."""
    cmd = ["curl", "-4", "-s", "-L", "-w", "\n%{http_code} %{time_total}", "--max-time", str(timeout)]
    if proxy:
        cmd += ["--proxy", proxy]
    cmd.append(url)
    out = run(cmd, timeout=timeout + 3)
    if not out:
        return 0, 0.0, ""
    body, _, tail = out.rpartition("\n")
    parts = tail.split()
    try:
        code = int(parts[0])
        secs = float(parts[1]) if len(parts) > 1 else 0.0
    except (ValueError, IndexError):
        return 0, 0.0, ""
    return code, round(secs, 2), body.strip()[:400]


def _ok_code(code: int) -> bool:
    return 200 <= code < 400


def _proxy_port(app: str) -> int:
    return 10809 if app == "omavpn" else 10809


def health_items(app: str, cli: str) -> tuple[list, dict]:
    """Все проверки «как есть сейчас» (VPN + zapret + сервисы)."""
    items: list[dict] = []
    data: dict = {}
    v = vpn_status(cli)
    data["vpn"] = v

    # --- VPN: туннель реально работает? -------------------------------------
    if not v.get("running"):
        items.append({"id": "vpn", "name": "VPN", "state": "idle",
                      "detail": "выключен — трафик идёт напрямую"})
        data["exit_ip"] = ""
    else:
        trace_code, trace_secs, body = _http("https://www.cloudflare.com/cdn-cgi/trace", 8)
        exit_ip = ""
        for line in body.splitlines():
            if line.startswith("ip="):
                exit_ip = line[3:].strip()
        socks_ok = False
        socks = run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "8",
                     "--socks5-hostname", "127.0.0.1:10808",
                     "https://www.cloudflare.com/cdn-cgi/trace"], timeout=11)
        try:
            socks_ok = int(socks or 0) == 200
        except ValueError:
            socks_ok = False
        data["exit_ip"] = exit_ip or ("нет выхода" if not _ok_code(trace_code) else "")
        data["socks_ok"] = socks_ok
        if socks_ok and _ok_code(trace_code):
            items.append({"id": "vpn", "name": "VPN", "state": "ok",
                          "detail": (v.get("profile") or "") + " · " + (v.get("node") or "авто")
                                    + " · выход " + (exit_ip or "?")})
        else:
            items.append({"id": "vpn", "name": "VPN", "state": "bad",
                          "detail": "подключение есть, но трафик не идёт"
                                    + ("" if socks_ok else " (SOCKS молчит)")})

    # --- zapret: служба и обход DPI -----------------------------------------
    z = zapret_status(wan_iface())
    data["zapret"] = z
    if z.get("testing"):
        items.append({"id": "zapret", "name": "zapret", "state": "warn",
                      "detail": "идёт подбор стратегии"})
    elif z.get("mode") == "off":
        items.append({"id": "zapret", "name": "zapret", "state": "ok",
                      "detail": "сеть чистая, обход не нужен"})
    elif z.get("service") != "active":
        items.append({"id": "zapret", "name": "zapret", "state": "bad",
                      "detail": "служба zapret не работает"})
    else:
        mode = z.get("mode") or "?"
        items.append({"id": "zapret", "name": "zapret", "state": "ok",
                      "detail": "стратегия #" + str(mode) + " · служба активна"})

    # --- YouTube: страница + видео (троттлинг) ------------------------------
    yt = youtube_status(check_video=True)
    data["youtube"] = yt
    ytv = yt.get("video") or {}
    if yt.get("ok"):
        extra = ""
        if ytv.get("kbps"):
            extra = " · видео " + str(round(ytv["kbps"] / 1024, 1)) + " МБ/с"
        items.append({"id": "youtube", "name": "YouTube", "state": "ok",
                      "detail": "страница и видео открываются" + extra})
    elif _ok_code(int(yt.get("page") or 0)):
        items.append({"id": "youtube", "name": "YouTube", "state": "bad",
                      "detail": "страница открывается, видео не грузится"
                                + (": " + str(ytv.get("error")) if ytv.get("error") else "")})
    else:
        items.append({"id": "youtube", "name": "YouTube", "state": "bad",
                      "detail": "не открывается (HTTP " + str(yt.get("page")) + ")"})

    # --- Discord: страница, шлюз, CDN ---------------------------------------
    d_page, _, _ = _http("https://discord.com/", 10)
    d_gw, gw_secs, _ = _http(DISCORD_GATEWAY, 10)
    d_cdn, _, _ = _http("https://cdn.discordapp.com/", 10)
    discord_ok = _ok_code(d_page) and _ok_code(d_gw)
    data["discord"] = {"page": d_page, "gateway": d_gw, "cdn": d_cdn, "secs": gw_secs}
    if discord_ok:
        items.append({"id": "discord", "name": "Discord", "state": "ok",
                      "detail": "страница и шлюз отвечают · " + str(gw_secs) + " с"})
    else:
        items.append({"id": "discord", "name": "Discord", "state": "bad",
                      "detail": "страница " + str(d_page) + ", шлюз " + str(d_gw)})

    # --- DeepSeek API (нужен ассистенту) ------------------------------------
    ds_code, ds_secs, _ = _http(DEEPSEEK_URL, 12)
    data["deepseek"] = {"code": ds_code, "secs": ds_secs}
    if ds_code:
        items.append({"id": "deepseek", "name": "DeepSeek API", "state": "ok",
                      "detail": "HTTP " + str(ds_code) + " · " + str(ds_secs) + " с"})
    else:
        items.append({"id": "deepseek", "name": "DeepSeek API", "state": "bad",
                      "detail": "нет ответа — ассистент не сможет работать"})

    # --- Telegram API (через HTTP-прокси VPN, если он включён) --------------
    proxy = f"http://127.0.0.1:{_proxy_port(app)}" if v.get("running") else ""
    tg_code, _, _ = _http("https://api.telegram.org/", 10, proxy)
    data["telegram"] = {"code": tg_code, "proxy": bool(proxy)}
    if tg_code:
        tg_state, tg_detail = "ok", "HTTP " + str(tg_code) + (" · через прокси VPN" if proxy else "")
    elif v.get("running"):
        tg_state, tg_detail = "bad", "нет ответа через прокси VPN"
    else:
        # без VPN Bot API в РФ и не должен открываться — это не поломка
        tg_state, tg_detail = "idle", "нет ответа (нужен VPN — включится при подключении)"
    items.append({"id": "telegram", "name": "Telegram API",
                  "state": tg_state, "detail": tg_detail})

    # --- tg-ws-proxy --------------------------------------------------------
    tg = tgwsproxy_status()
    data["tgwsproxy"] = tg
    items.append({"id": "tgwsproxy", "name": "tg-ws-proxy",
                  "state": "ok" if tg.get("listening") else "bad",
                  "detail": ("порт " + str(tg.get("port")) + " слушает") if tg.get("listening")
                            else "не слушает"})
    return items, data


def run_health(heal_vpn: bool = True) -> dict:
    """Комплексный тест текущей конфигурации + попытка самовосстановления VPN."""
    if os.path.exists(HEALTH_LOCK):
        try:
            if time.time() - os.path.getmtime(HEALTH_LOCK) < 180:
                return {"ok": False, "reason": "already_running"}
        except OSError:
            pass
    os.makedirs(os.path.dirname(HEALTH_LOCK), exist_ok=True)
    try:
        open(HEALTH_LOCK, "w").write(str(os.getpid()))
    except OSError:
        pass
    started = time.time()
    app, cli = resolve_cli()
    result: dict = {"ok": True, "checked": 0}
    try:
        items, data = health_items(app, cli)
        heal_info = {}
        # VPN подключён, но не работает → пробуем вылечить (с ограничением частоты)
        vpn_item = next((i for i in items if i["id"] == "vpn"), None)
        if heal_vpn and cli and vpn_item and vpn_item["state"] == "bad":
            try:
                raw = run([cli, "--json", "heal"], timeout=180)
                heal_info = json.loads(raw) if raw else {}
            except ValueError:
                heal_info = {}
            if heal_info.get("ok"):
                items, data = health_items(app, cli)
        bad = [i["name"] for i in items if i["state"] == "bad"]
        warn = [i["name"] for i in items if i["state"] == "warn"]
        # state "idle" — не поломка (VPN намеренно выключен), в вердикт не идёт
        verdict = "bad" if bad else ("warn" if warn else "ok")
        if verdict == "ok":
            summary = "всё работает: " + ", ".join(i["name"] for i in items)
        elif verdict == "warn":
            summary = "работает, но есть замечания · " + ", ".join(warn)
        else:
            summary = "не работает: " + ", ".join(bad)
        result = {
            "ok": verdict != "bad",
            "checked": time.time(),
            "verdict": verdict,
            "summary": summary,
            "items": items,
            "heal": heal_info,
            "secs": round(time.time() - started, 1),
            **{k: v for k, v in data.items() if k in ("exit_ip", "socks_ok")},
        }
    except Exception as exc:  # noqa: BLE001
        result = {"ok": False, "checked": time.time(), "verdict": "bad",
                  "summary": "проверка прервалась: " + str(exc), "items": [], "error": str(exc)}
    finally:
        try:
            os.remove(HEALTH_LOCK)
        except OSError:
            pass
    if app:
        write_json_cache(app, "health.json", result)
    return result


def cached_health(app: str) -> dict:
    path = os.path.join(HOME, ".cache", app, "health.json") if app else ""
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    data["age"] = int(time.time() - float(data.get("checked") or 0))
    data["stale"] = data["age"] > HEALTH_MAX_AGE
    return data


def cli_json(cli: str, *args) -> dict:
    raw = run([cli, "--json", *args], timeout=15)
    try:
        return json.loads(raw)
    except ValueError:
        return {}


# --------------------------------------------------------------------------- #
# аудит маршрутов: домен, недоступный текущим путём, уходит на рабочий
# --------------------------------------------------------------------------- #

def audit_lock(path: str) -> tuple[int, str]:
    """Эксклюзивный flock на прогон аудита. (fd, "") либо (-1, причина).

    Именно flock, а не файл с pid/mtime: старую схему («лок устарел, если
    старше 600 с») ломает любой долгий прогон — второй процесс забирал лок, а
    потом `finally` первого снимал уже чужой. С flock лок держится, пока жив
    процесс, и снимается ядром даже при его падении.
    """
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError as exc:
        return -1, "не открыть лок " + path + ": " + str(exc)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return -1, "busy"
    try:
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode())
    except OSError:
        pass
    return fd, ""


def audit_unlock(fd: int) -> None:
    if fd is None or fd < 0:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def socks_port(app: str) -> int:
    """Порт локального SOCKS из xray.json (inbounds), а не из константы."""
    path = os.path.join(HOME, ".local", "state", app, "xray.json") if app else ""
    try:
        cfg = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return 0
    for inb in cfg.get("inbounds") or []:
        if not isinstance(inb, dict) or inb.get("protocol") != "socks":
            continue
        try:
            port = int(inb.get("port") or 0)
        except (TypeError, ValueError):
            continue
        if port:
            return port
    return 0


def _cli_route_rules(cli: str) -> tuple[list, list, list]:
    """(правила, «только напрямую», «только через VPN») из `route list --json`.

    Путь считает сам CLI — единая логика приоритета, без дублирования. Списки
    «всегда» нужны аудиту: домен из ALWAYS_DIRECT нельзя уводить в туннель
    (ему нужен российский IP), а из ALWAYS_PROXY — выпускать напрямую.
    """
    if not cli:
        return [], [], []
    data = cli_json(cli, "route", "list")
    routes = data.get("routes")
    if not isinstance(routes, list) or not routes:
        return [], [], []
    proxy, direct = [], []
    for row in routes:
        if not isinstance(row, dict) or not row.get("domain"):
            continue
        (proxy if row.get("path") == "proxy" else direct).append(str(row["domain"]))
    rules = []
    if proxy:
        rules.append(("proxy", proxy))       # правило proxy стоит перед direct
    if direct:
        rules.append(("direct", direct))
    always_direct = [str(d) for d in (data.get("always_direct") or []) if d]
    always_proxy = [str(d) for d in (data.get("always_proxy") or []) if d]
    if not always_direct and not always_proxy:
        # CLI без списков «always»: берём их из источника строк таблицы
        for row in routes:
            if not isinstance(row, dict) or row.get("source") != "always" or not row.get("domain"):
                continue
            (always_proxy if row.get("path") == "proxy" else always_direct).append(str(row["domain"]))
    return rules, always_direct, always_proxy


def _cfg_route_rules(app: str) -> list:
    """Запасной путь: правила прямо из singbox.json, в их порядке.

    Нужен, если установленный omavpn старее и подкоманды `route` ещё нет.
    """
    path = os.path.join(HOME, ".local", "state", app, "singbox.json") if app else ""
    try:
        cfg = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return []
    rules = []
    for rule in (cfg.get("route") or {}).get("rules") or []:
        if not isinstance(rule, dict) or rule.get("outbound") not in ("proxy", "direct"):
            continue
        doms = rule.get("domain_suffix") or rule.get("domain") or []
        if isinstance(doms, str):
            doms = [doms]
        doms = [str(d) for d in doms if d]
        if doms:
            rules.append((str(rule["outbound"]), doms))
    return rules


def route_context(app: str, cli: str) -> dict:
    """Правила в порядке sing-box + списки «всегда» + признак живого CLI."""
    rules, always_direct, always_proxy = _cli_route_rules(cli)
    if not rules:
        rules = _cfg_route_rules(app)
    return {"rules": rules, "always_direct": always_direct, "always_proxy": always_proxy}


def _domain_hit(dom: str, cand: str) -> bool:
    """Совпадение домена с правилом так, как это делает sing-box.

    `domain_suffix` — «домен или его поддомен **по границе метки**», поэтому
    `notyoutube.com` под правило `youtube.com` не попадает. Голый `endswith`
    давал ложное совпадение и расходился с конфигом (проверено `rule-set match`).
    """
    return bool(cand) and (dom == cand or dom.endswith("." + cand))


def route_path(domain: str, rules: list) -> str:
    """Текущий путь домена: proxy / direct / default (final=proxy).

    Сравнение — по суффиксу с границей метки, как domain_suffix в sing-box;
    правила просматриваются сверху вниз, первое совпадение и решает.
    """
    dom = (domain or "").strip().lower()
    for path, domains in rules:
        for cand in domains:
            if _domain_hit(dom, cand.strip().lower()):
                return path
    return "default"


def in_list(domain: str, domains: list) -> bool:
    """Попадает ли домен в список по тем же правилам суффикса, что и sing-box."""
    dom = (domain or "").strip().lower()
    return any(_domain_hit(dom, str(cand).strip().lower()) for cand in domains)


def _run_bytes(cmd: list[str], timeout: float) -> tuple[int, str]:
    """Как run(), но читает вывод байтами: тело ответа может быть двоичным (JPEG)."""
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return p.returncode, (p.stdout or b"").decode("utf-8", "replace")


def http_probe(url: str, socks: int = 0, timeout: float = ROUTE_PROBE_TIMEOUT) -> dict:
    """GET-проба. socks>0 — через локальный SOCKS (путь VPN)."""
    cmd = ["curl", "-4", "-s", "-L", "--max-time", str(timeout),
           "-w", "\n%{http_code}\t%{content_type}\t%{size_download}\t%{time_total}"]
    if socks:
        cmd += ["--socks5-hostname", f"127.0.0.1:{socks}"]
    cmd.append(url)
    rc, raw = _run_bytes(cmd, timeout=timeout + 3)
    body, _, tail = raw.rpartition("\n")
    fields = tail.split("\t")
    code, ctype, size, secs = 0, "", 0, 0.0
    try:
        code = int(fields[0])
        ctype = fields[1] if len(fields) > 1 else ""
        size = int(float(fields[2])) if len(fields) > 2 else 0
        secs = float(fields[3]) if len(fields) > 3 else 0.0
    except (ValueError, IndexError):
        code = 0
    return {"code": code, "ctype": ctype, "size": size, "secs": round(secs, 2),
            "body": body[:200000], "rc": rc}


def probe_verdict(probe: dict, res: dict) -> tuple[bool, str]:
    """(успех, пояснение) для одной пробы."""
    code = int(res.get("code") or 0)
    if code == 0:
        return False, "нет ответа (таймаут/обрыв)"
    kind = probe.get("expect")
    if kind == "answer":
        return True, "HTTP " + str(code) + " · " + str(res.get("secs")) + " с"
    if kind == "codes":
        ok = code in probe["codes"]
        want = "/".join(str(c) for c in probe["codes"])
        return ok, "HTTP " + str(code) + ("" if ok else " (ждали " + want + ")")
    if kind == "below500":
        return code < 500, "HTTP " + str(code)
    if kind == "page":
        ok = code == 200 and probe.get("needle", "").lower() in res.get("body", "").lower()
        return ok, "HTTP " + str(code) + ("" if ok else " (в теле нет «" + probe.get("needle", "") + "»)")
    return False, "неизвестный тип проверки"


def probe_for(domain: str) -> dict:
    for probe in ROUTE_PROBES:
        if probe["domain"] == domain:
            return probe
    # домен без заранее описанной пробы: успех — любой HTTP-ответ
    return {"domain": domain, "url": "https://" + domain + "/", "expect": "answer"}


def cli_json_slow(cli: str, *args, timeout: float = 150) -> dict:
    """Вызов CLI, который может перезапускать VPN (`route set/unset`)."""
    raw = run([cli, "--json", *args], timeout=timeout)
    try:
        return json.loads(raw)
    except ValueError:
        return {}


def route_audit_path(app: str) -> str:
    return os.path.join(HOME, ".config", app, "route_overrides.json") if app else ""


def read_route_overrides(app: str) -> dict:
    path = route_audit_path(app)
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {str(k): v for k, v in data.items() if isinstance(v, dict)}


def _audit_summary(probes: list, actions: list) -> str:
    """Строка для виджета: что проверили, что исправили, что откатили, что лежит."""
    fixed = [a for a in actions if a.get("ok")]
    rolled = [a for a in actions if a.get("rollback")]
    bad = [p["domain"] for p in probes if not p.get("after")]
    parts = []
    if probes:
        parts.append("проверено " + str(len(probes)))
    if fixed:
        parts.append("исправлено " + str(len(fixed)))
    if rolled:
        parts.append("откатил: " + ", ".join(str(a.get("domain")) for a in rolled))
    if bad:
        parts.append("не отвечают: " + ", ".join(bad))
    return "; ".join(parts) if parts else "маршруты в порядке"


def _probe_once(probe: dict, socks: int = 0) -> tuple[bool, dict, str]:
    """Проба с подтверждением: (успех, результат, пояснение).

    Одиночный обрыв на живой сети — не повод менять маршрут, поэтому провал
    обязательно проверяется второй попыткой.
    """
    timeout = float(probe.get("timeout", ROUTE_PROBE_TIMEOUT))
    res = http_probe(probe["url"], socks=socks, timeout=timeout)
    ok, detail = probe_verdict(probe, res)
    if ok:
        return True, res, detail
    again = http_probe(probe["url"], socks=socks, timeout=timeout)
    ok2, detail2 = probe_verdict(probe, again)
    if ok2:
        return True, again, detail2 + " (со второй попытки)"
    return False, again, detail2 + " (две попытки)"


def _vpn_socks(app: str) -> int:
    """Порт локального SOCKS, если VPN действительно поднят. Иначе 0.

    Проверяем не только конфиг, но и живой порт: при выключенном VPN проба
    «через VPN» всегда упрётся в мёртвый порт, и аудит начал бы переключать
    маршруты из-за собственной ошибки.
    """
    socks = socks_port(app)
    return socks if socks and port_open(socks) else 0


def bypass_viable() -> tuple[bool, str]:
    """Существует ли сейчас прямой путь в обход TUN: (годен, причина отказа).

    «Direct не отвечает» бывает по трём разным причинам: (а) домен реально
    заблокирован, (б) обход выключен или autotune не подобрал стратегию,
    (в) обход есть, но не пробивает. Менять маршрут имеет смысл только в первом
    случае: пока zapret стоит, прямого пути для доменов из
    BYPASS_DEPENDENT_DOMAINS просто нет, и переключение туда лишь оборвёт живой
    трафик — дважды (туда и обратно), каждые десять минут.

    Root не нужен: `systemctl is-active` и чтение стратегии из
    /var/lib/zapret-autotune/<key>.strategy (0444) доступны пользователю.
    """
    st = zapret_status(wan_iface())
    service = str(st.get("service") or "").strip() or "unknown"
    mode = str(st.get("mode") or "").strip().lower()
    if service != "active":
        return False, "zapret: " + service
    if mode == "vpn":
        return False, "autotune счёл обход нерабочим"
    return True, ""


def route_state_path(app: str) -> str:
    return os.path.join(HOME, ".cache", app, "route-audit-state.json") if app else ""


def read_route_state(app: str) -> dict:
    """Память между прогонами: когда и сколько раз переключали домен в каждую сторону.

    Формат: {"<домен>": {"direct": ts, "direct_fails": n,
                         "proxy": ts,  "proxy_fails": n}}
    Нужна, потому что прогон живёт 20–60 с: без файла аудит каждые 10 минут
    заново «пробует» один и тот же мёртвый путь.
    """
    path = route_state_path(app)
    if not path:
        return {}
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    clean: dict = {}
    for dom, ent in data.items():
        if not isinstance(ent, dict):
            continue
        row = {}
        for key in ("direct", "proxy"):
            try:
                row[key] = max(0, int(ent.get(key) or 0))
            except (TypeError, ValueError):
                row[key] = 0
            try:
                row[key + "_fails"] = max(0, int(ent.get(key + "_fails") or 0))
            except (TypeError, ValueError):
                row[key + "_fails"] = 0
        clean[str(dom)] = row
    return clean


def save_route_state(app: str, state: dict) -> None:
    if app and state:
        write_json_cache(app, "route-audit-state.json", state)


def route_cooldown(state: dict, dom: str, path: str) -> float:
    """Сколько секунд ещё нельзя переключать домен в сторону `path` (0 — можно)."""
    ent = state.get(dom) or {}
    try:
        ts = float(ent.get(path) or 0)
        fails = int(ent.get(path + "_fails") or 0)
    except (TypeError, ValueError):
        return 0.0
    if not ts:
        return 0.0
    gap = ROUTE_STATE_GAP * (2 ** min(max(fails, 0), ROUTE_STATE_MAX_DOUBLINGS))
    return max(0.0, ts + gap - time.time())


def route_state_mark(state: dict, dom: str, path: str, ok: bool) -> None:
    """Отметить попытку переключения: удачная сбрасывает счётчик, неудачная копит."""
    ent = state.setdefault(dom, {})
    ent[path] = int(time.time())
    try:
        fails = int(ent.get(path + "_fails") or 0)
    except (TypeError, ValueError):
        fails = 0
    ent[path + "_fails"] = 0 if ok else fails + 1


def _fmt_cooldown(seconds: float) -> str:
    minutes = int(seconds // 60) + (1 if seconds % 60 else 0)
    if minutes < 60:
        return str(max(1, minutes)) + " мин"
    hours = minutes / 60
    return (f"{hours:.1f}".rstrip("0").rstrip(".")) + " ч"


def _own_override(overrides: dict, dom: str) -> bool:
    """Можно ли трогать маршрут домена: True, если человек его не закреплял.

    Проверяются все ключи, которые ловят домен по правилам sing-box (точный и
    суффиксные). Иначе ручной `route set googlevideo.com direct` не защищал
    `redirector.googlevideo.com`: точного ключа нет, аудит ставил оверрайд на
    поддомен, а proxy-правило в конфиге ловит его по суффиксу первым — и ручное
    решение переставало действовать.
    """
    for key, ent in overrides.items():
        cand = str(key).strip().lower()
        if not (dom == cand or dom.endswith("." + cand)):
            continue
        if not str(ent.get("reason") or "").startswith(ROUTE_REASON_PREFIX):
            return False
    return True


def _route_switch(cli: str, dom: str, path: str, reason: str) -> dict:
    """Ставит оверрайд без перезапуска VPN: рестарт делается один на пачку."""
    return cli_json_slow(cli, "route", "set", dom, path, "--reason", reason, "--no-restart")


def _route_restore(cli: str, dom: str, previous: dict) -> dict:
    """Возвращает домен к состоянию до прогона (был оверрайд — вернуть его)."""
    if previous and str(previous.get("path") or "") in ("proxy", "direct"):
        return cli_json_slow(cli, "route", "set", dom, str(previous["path"]),
                             "--reason", str(previous.get("reason") or ""), "--no-restart")
    return cli_json_slow(cli, "route", "unset", dom, "--no-restart")


def _restart_vpn(cli: str) -> tuple[bool, str]:
    """Один перезапуск VPN на весь пакет уже записанных правил.

    Таймаут 150 с, а не 240: за прогон рестартов бывает до трёх, и юнит
    (`TimeoutStartSec=1200`) не должен убивать аудит между переключением и
    откатом — иначе домен останется на пути, который не проверен.
    """
    res = cli_json_slow(cli, "restart", timeout=150)
    if res.get("ok"):
        return True, ""
    return False, str(res.get("error") or "нет ответа CLI")


def run_route_audit() -> dict:
    """Двусторонний аудит маршрутов.

    Смотрит в обе стороны: домен, которому плохо на текущем пути, проверяется
    на противоположном.

      * путь direct и проба провалилась → проверяем через SOCKS; хорошо —
        ставим оверрайд proxy;
      * путь proxy (или final=proxy) и проба провалилась → переводим в direct,
        перезапускаем, проверяем; плохо и там — возвращаем как было.

    Второе направление — ответ на случай 22.10.2026, когда `zapret-autotune`
    перевёл сеть в режим vpn и видеотрафик googlevideo ушёл в туннель, где не
    работает (видео `code=000`, страница при этом 200).

    Два предохранителя, без которых второе направление опаснее болезни:

      * **прямого пути может не быть вовсе.** Домены из BYPASS_DEPENDENT_DOMAINS
        живут обходом DPI. Если zapret не active или autotune счёл обход
        нерабочим (стратегия сети = `vpn`), «direct не отвечает» ничего не
        значит — переводить туда домен нельзя, в detail пишется причина;
      * **память между прогонами** (`~/.cache/<cli>/route-audit-state.json`).
        Попытка в одну сторону — не чаще 6 ч × 2^fails (до 48 ч), удачная
        сбрасывает счётчик. Иначе выключенный обход давал по два обрыва трафика
        каждые 10 минут: перевёл → проба мертва → откатил.

    Границы: домены из ALWAYS_DIRECT в туннель не переводим (им нужен РФ-IP),
    из ALWAYS_PROXY — не выпускаем напрямую; ручные оверрайды (включая
    суффиксные ключи) не трогаем; за прогон домен переключается максимум один
    раз в одну сторону плюс, при неудаче, один откат. Сначала все пробы (ничего
    не меняя), потом оверрайды пачкой `--no-restart`, потом один
    `omavpn restart` на пачку и одна перепроверка.
    """
    fd, why = audit_lock(ROUTE_AUDIT_LOCK)
    if why:
        if why == "busy":
            return {"ok": False, "reason": "already_running", "checked": time.time()}
        return {"ok": False, "reason": "lock_error", "error": why, "checked": time.time()}
    started = time.time()
    app, cli = resolve_cli()
    state: dict = {}
    result: dict = {"ok": False, "checked": time.time(), "probes": [], "actions": []}
    try:
        ctx = route_context(app, cli)
        rules = ctx["rules"]
        socks = _vpn_socks(app)
        overrides = read_route_overrides(app)
        state = read_route_state(app)
        probes: list[dict] = []
        actions: list[dict] = []
        forward: list[dict] = []   # прямому пути плохо → пробуем туннель
        reverse: list[dict] = []   # туннелю плохо → пробуем напрямую
        bypass_cache: dict = {}

        def bypass_state() -> tuple[bool, str]:
            """Состояние обхода один раз на прогон: systemctl + iwgetid не бесплатны."""
            if "value" not in bypass_cache:
                bypass_cache["value"] = bypass_viable()
            return bypass_cache["value"]

        # --- фаза 1: только пробы, ничего не меняем -------------------------
        for probe in ROUTE_PROBES:
            dom = probe["domain"]
            path = route_path(dom, rules)
            ok, res, detail = _probe_once(probe)
            item = {"domain": dom, "path": path, "before": ok, "after": ok, "action": "",
                    "detail": detail, "code": res["code"], "secs": res["secs"]}
            probes.append(item)
            if ok:
                continue
            job = {"probe": probe, "item": item, "from": path,
                   "previous": overrides.get(dom) or {}}
            if not _own_override(overrides, dom):
                item["detail"] = detail + "; ручной оверрайд — не трогаю"
            elif path == "direct":
                if in_list(dom, ctx["always_direct"]):
                    item["detail"] = (detail
                                      + "; помечен «только напрямую» — не переключаю")
                elif not socks:
                    item["detail"] = (detail + "; путь VPN проверить нечем "
                                      "(VPN выключен или в xray.json нет SOCKS)")
                elif not cli:
                    item["detail"] = detail + "; VPN CLI не найден — переключить нечем"
                else:
                    vpn_ok, _, vpn_detail = _probe_once(probe, socks=socks)
                    if vpn_ok:
                        item["detail"] = "direct: " + detail + "; vpn: " + vpn_detail
                        forward.append(job)
                    else:
                        item["detail"] = ("direct: " + detail + "; vpn: " + vpn_detail
                                          + "; недоступен обоими путями — не переключаю")
            else:  # proxy или final=proxy
                if in_list(dom, ctx["always_proxy"]):
                    item["detail"] = (detail
                                      + "; помечен «только через VPN» — в direct не перевожу")
                elif not socks:
                    item["detail"] = detail + "; VPN выключен — путь direct так не проверить"
                elif not cli:
                    item["detail"] = detail + "; VPN CLI не найден — переключить нечем"
                else:
                    viable, why_not = bypass_state()
                    if not viable and in_list(dom, BYPASS_DEPENDENT_DOMAINS):
                        item["detail"] = (detail + "; обход выключен (" + why_not + ") — "
                                          "прямой путь для этого домена сейчас мёртв, "
                                          "оставляю в VPN")
                    else:
                        item["detail"] = detail + "; проверяю напрямую"
                        reverse.append(job)

        # --- фаза 2: direct → proxy, один перезапуск на всю пачку ----------
        if forward:
            applied = []
            for job in forward:
                dom = job["probe"]["domain"]
                wait = route_cooldown(state, dom, "proxy")
                if wait > 0:
                    job["item"]["detail"] += ("; в туннель не переключаю: пробовали недавно, "
                                              "следующая попытка через " + _fmt_cooldown(wait))
                    continue
                res = _route_switch(cli, dom, "proxy", ROUTE_AUDIT_REASON)
                if not res.get("ok"):
                    job["item"]["detail"] += ("; не удалось поставить оверрайд: "
                                              + str(res.get("error") or "нет ответа CLI"))
                    continue
                job["item"]["path"] = "proxy"
                applied.append(job)
            restarted, why_restart = _restart_vpn(cli) if applied else (False, "")
            if not restarted:
                for job in applied:
                    job["item"]["detail"] += ("; VPN не перезапустился: " + why_restart
                                              + " — правило применится позже")
            else:
                time.sleep(ROUTE_SETTLE)
            for job in applied:
                dom = job["probe"]["domain"]
                after_ok, after_res, after_detail = _probe_once(job["probe"])
                job["item"].update({
                    "after": after_ok, "action": "proxy",
                    "code": after_res["code"], "secs": after_res["secs"],
                    "detail": job["item"]["detail"] + "; после переключения: " + after_detail,
                })
                if not restarted:
                    # вердикта нет: правило не применилось. Это не повод считать
                    # попытку неудачной — иначе сломавшийся один раз рестарт
                    # отложил бы лечение домена на 12 часов.
                    continue
                route_state_mark(state, dom, "proxy", after_ok)
                if after_ok:
                    actions.append({"domain": dom, "from": job["from"], "to": "proxy",
                                    "reason": ROUTE_AUDIT_REASON, "ok": True})

        # --- фаза 3: proxy → direct (обратное направление) ------------------
        if reverse:
            applied = []
            for job in reverse:
                dom = job["probe"]["domain"]
                wait = route_cooldown(state, dom, "direct")
                if wait > 0:
                    job["item"]["detail"] += ("; в direct не переключаю: пробовали недавно, "
                                              "следующая попытка через " + _fmt_cooldown(wait))
                    continue
                res = _route_switch(cli, dom, "direct", ROUTE_AUDIT_REASON_BACK)
                if not res.get("ok"):
                    job["item"]["detail"] += ("; не удалось поставить оверрайд: "
                                              + str(res.get("error") or "нет ответа CLI"))
                    continue
                applied.append(job)
            restarted, why_restart = _restart_vpn(cli) if applied else (False, "")
            if not restarted:
                # без перезапуска правило не применилось — проверять нечего
                for job in applied:
                    dom = job["probe"]["domain"]
                    _route_restore(cli, dom, job["previous"])
                    job["item"].update({
                        "after": False, "path": job["from"],
                        "detail": job["item"]["detail"] + "; VPN не перезапустился: "
                                  + why_restart + " — оставил как было",
                    })
            else:
                time.sleep(ROUTE_SETTLE)
                bad = []
                for job in applied:
                    dom = job["probe"]["domain"]
                    after_ok, after_res, after_detail = _probe_once(job["probe"])
                    job["item"].update({
                        "after": after_ok, "code": after_res["code"],
                        "secs": after_res["secs"],
                        "detail": job["item"]["detail"] + "; direct: " + after_detail,
                    })
                    if after_ok:
                        job["item"].update({"path": "direct", "action": "direct"})
                        route_state_mark(state, dom, "direct", True)
                        actions.append({"domain": dom, "from": job["from"], "to": "direct",
                                        "reason": ROUTE_AUDIT_REASON_BACK, "ok": True})
                    else:
                        bad.append(job)
                if bad:
                    for job in bad:
                        dom = job["probe"]["domain"]
                        _route_restore(cli, dom, job["previous"])
                        # откат = неудачная попытка в direct: следующий раз не
                        # раньше 12 ч, потом 24 и 48 — трафик не рвём зря
                        route_state_mark(state, dom, "direct", False)
                        job["item"].update({
                            "path": job["from"], "action": "rollback",
                            "detail": job["item"]["detail"]
                                      + "; вернул прежний путь — не отвечает ни там, ни там",
                        })
                        actions.append({"domain": dom, "from": "direct",
                                        "to": job["from"],
                                        "reason": "аудит: proxy и direct не отвечают",
                                        "ok": False, "rollback": True})
                    _restart_vpn(cli)  # откат тоже надо применить

        ok = all(p["after"] for p in probes)
        fixed = any(a.get("ok") for a in actions)
        result = {
            "ok": ok,
            "checked": time.time(),
            "verdict": "fixed" if fixed else ("ok" if ok else "bad"),
            "summary": _audit_summary(probes, actions),
            "count": len(probes),
            "fixed": len([a for a in actions if a.get("ok")]),
            "socks_port": socks,
            "probes": probes,
            "actions": actions,
            "secs": round(time.time() - started, 1),
        }
    except Exception as exc:  # noqa: BLE001
        result = {"ok": False, "checked": time.time(), "verdict": "bad",
                  "summary": "аудит маршрутов прервался: " + str(exc),
                  "probes": [], "actions": [], "error": str(exc),
                  "secs": round(time.time() - started, 1)}
    finally:
        audit_unlock(fd)
        # Состояние пишем один раз в конце (и при падении тоже): кулдаун должен
        # пережить прогон, иначе следующий через 10 минут снова дёрнет трафик.
        save_route_state(app, state)
    if app:
        write_json_cache(app, "route-audit.json", result)
    return result


def run_route_recheck(force: bool = False) -> dict:
    """Раз в сутки: снять оверрайды аудита старше суток и проверить direct заново.

    Блокировки снимают, и zapret учат новые домены — тогда домен пора вернуть
    на прямой путь. Если direct снова не отвечает, оверрайд возвращается.

    Трогаем **только свои** оверрайды (причина начинается с «аудит»): ручной
    `omavpn route set` — решение человека, и перепроверка его не снимает.
    """
    fd, why = audit_lock(ROUTE_AUDIT_LOCK)
    if why:
        if why == "busy":
            return {"ok": False, "reason": "already_running", "checked": time.time()}
        return {"ok": False, "reason": "lock_error", "error": why, "checked": time.time()}
    started = time.time()
    app, cli = resolve_cli()
    result: dict = {"ok": False, "checked": time.time(), "probes": [], "actions": []}
    try:
        state_path = os.path.join(HOME, ".cache", app, "route-audit-recheck.json") if app else ""
        last = 0.0
        if state_path:
            try:
                last = float(json.load(open(state_path, encoding="utf-8")).get("checked") or 0)
            except (OSError, ValueError):
                last = 0.0
        if not force and last and (time.time() - last) < ROUTE_RECHECK_GAP:
            result = {"ok": True, "checked": time.time(), "skipped": "недавно проверяли",
                      "next_in": int(ROUTE_RECHECK_GAP - (time.time() - last)),
                      "probes": [], "actions": [],
                      "secs": round(time.time() - started, 1)}
            return result

        overrides = read_route_overrides(app)
        now = time.time()
        candidates = []
        for dom, ent in overrides.items():
            if str(ent.get("path") or "") != "proxy":
                continue
            if not str(ent.get("reason") or "").startswith(ROUTE_REASON_PREFIX):
                continue          # ручной оверрайд — не трогаем никогда
            try:
                ts = float(ent.get("ts") or 0)
            except (TypeError, ValueError):
                ts = 0.0
            if now - ts > ROUTE_RECHECK_AGE:
                candidates.append(dom)

        if not candidates:
            result = {"ok": True, "checked": time.time(), "verdict": "ok",
                      "summary": "перепроверять нечего", "probes": [], "actions": [],
                      "secs": round(time.time() - started, 1)}
        elif not cli:
            result = {"ok": False, "checked": time.time(), "verdict": "bad",
                      "summary": "VPN CLI не найден — перепроверка невозможна",
                      "probes": [], "actions": [],
                      "secs": round(time.time() - started, 1)}
        else:
            socks = _vpn_socks(app)
            probes: list[dict] = []
            actions: list[dict] = []
            stripped: list[dict] = []
            for dom in candidates:
                item = {"domain": dom, "path": "proxy", "before": True, "after": True,
                        "action": "", "detail": "был override proxy"}
                probes.append(item)
                res = cli_json_slow(cli, "route", "unset", dom, "--no-restart")
                if not res.get("ok"):
                    item["detail"] = ("не удалось снять оверрайд: "
                                      + str(res.get("error") or "нет ответа CLI"))
                    continue
                stripped.append({"domain": dom, "item": item})
            # Один перезапуск на всю пачку снятых оверрайдов. Без живого туннеля
            # перезапускать нечего и нельзя: `omavpn restart` поднял бы VPN,
            # который человек выключил.
            restarted, why_restart = False, ""
            if stripped and socks:
                restarted, why_restart = _restart_vpn(cli)
                if restarted:
                    time.sleep(ROUTE_SETTLE)
                else:
                    for job in stripped:
                        job["item"]["detail"] += "; VPN не перезапустился: " + why_restart
            restored: list[str] = []
            if stripped and socks and not restarted:
                # Правило не применилось: проба «напрямую» показала бы старый
                # маршрут, и оверрайд снялся бы по ложному «direct снова
                # работает». Возвращаем как было и не трогаем до следующего раза.
                for job in stripped:
                    dom = job["domain"]
                    _route_switch(cli, dom, "proxy", "аудит: direct всё ещё не отвечает")
                    job["item"].update({
                        "path": "proxy", "after": True, "action": "keep",
                        "detail": job["item"]["detail"]
                                  + "; direct не проверяю: правило не применилось — "
                                    "оверрайд оставлен",
                    })
                    actions.append({"domain": dom, "from": "proxy", "to": "proxy",
                                    "reason": "VPN не перезапустился", "ok": False})
            else:
                for job in stripped:
                    dom = job["domain"]
                    item = job["item"]
                    probe = probe_for(dom)
                    direct_ok, res, direct_detail = _probe_once(probe)
                    item.update({"code": res["code"], "secs": res["secs"]})
                    if direct_ok:
                        item.update({"path": "direct", "after": True, "action": "direct",
                                     "detail": "direct снова работает (" + direct_detail
                                               + ") — оверрайд снят"})
                        actions.append({"domain": dom, "from": "proxy", "to": "direct",
                                        "reason": "direct отвечает", "ok": True})
                        continue
                    if in_list(dom, BYPASS_DEPENDENT_DOMAINS):
                        viable, why_not = bypass_viable()
                        if not viable:
                            direct_detail += (" (обход выключен: " + why_not
                                              + " — прямой путь может ожить после включения zapret)")
                    proxy_ok, proxy_detail = False, "нет SOCKS в xray.json"
                    if socks:
                        proxy_ok, _, proxy_detail = _probe_once(probe, socks=socks)
                    restore = _route_switch(cli, dom, "proxy", "аудит: direct всё ещё не отвечает")
                    if restore.get("ok"):
                        restored.append(dom)
                    item.update({"path": "proxy", "after": proxy_ok, "action": "restore",
                                 "detail": ("direct: " + direct_detail + "; vpn: " + proxy_detail
                                            + ("; оверрайд возвращён" if restore.get("ok")
                                               else "; оверрайд вернуть не удалось: "
                                                  + str(restore.get("error") or "нет ответа CLI")))})
                    actions.append({"domain": dom, "from": "direct", "to": "proxy",
                                    "reason": "direct всё ещё не отвечает",
                                    "ok": bool(restore.get("ok")) and proxy_ok})
                if restored and socks:
                    _restart_vpn(cli)  # вернуть правила в силу
            ok = all(p["after"] for p in probes)
            result = {
                "ok": ok,
                "checked": time.time(),
                "verdict": "fixed" if any(a.get("ok") for a in actions)
                           else ("ok" if ok else "bad"),
                "summary": _audit_summary(probes, actions),
                "count": len(probes),
                "fixed": len([a for a in actions if a.get("ok")]),
                "probes": probes,
                "actions": actions,
                "secs": round(time.time() - started, 1),
            }
    except Exception as exc:  # noqa: BLE001
        result = {"ok": False, "checked": time.time(), "verdict": "bad",
                  "summary": "перепроверка маршрутов прервалась: " + str(exc),
                  "probes": [], "actions": [], "error": str(exc),
                  "secs": round(time.time() - started, 1)}
    finally:
        audit_unlock(fd)
    if app:
        write_json_cache(app, "route-audit-recheck.json", result)
    return result


def cached_route_audit(app: str) -> dict:
    path = os.path.join(HOME, ".cache", app, "route-audit.json") if app else ""
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    data["age"] = int(time.time() - float(data.get("checked") or 0))
    data["stale"] = data["age"] > ROUTE_AUDIT_MAX_AGE
    return data


def read_sub(app: str) -> list:
    path = os.path.join(HOME, ".cache", app, "sub.json") if app else ""
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return []
    if isinstance(data, dict):
        return data.get("configs") or []
    return data or []


def extract_nodes(configs: list, profile_index: int) -> list:
    if not (0 <= profile_index < len(configs)):
        return []
    out = []
    for o in configs[profile_index].get("outbounds", []) or []:
        if o.get("protocol") not in PROXY_PROTOCOLS:
            continue
        st = o.get("settings", {}) or {}
        address, port = "", 0
        for key in ("vnext", "servers"):
            seq = st.get(key)
            if isinstance(seq, list) and seq:
                address = str(seq[0].get("address") or seq[0].get("server") or "")
                port = int(seq[0].get("port") or 0)
                break
        stream = o.get("streamSettings", {}) or {}
        detail = ((stream.get("realitySettings", {}) or {}).get("serverName")
                  or (stream.get("tlsSettings", {}) or {}).get("serverName")
                  or (stream.get("xhttpSettings", {}) or {}).get("host")
                  or address)
        out.append({"index": len(out), "tag": o.get("tag", "proxy"),
                    "address": address, "port": port, "detail": str(detail)})
    return out


def tcp_ping(host: str, port: int, timeout: float = 1.5, tries: int = 2):
    if not host or not port:
        return None
    best = None
    for _ in range(tries):
        try:
            start = time.perf_counter()
            with socket.create_connection((host, port), timeout=timeout):
                dt = (time.perf_counter() - start) * 1000
            best = dt if best is None else min(best, dt)
        except OSError:
            continue
    return round(best) if best is not None else None


def vpn_info(app: str, cli: str) -> dict:
    if not cli:
        return {"ok": False, "error": "VPN CLI не найден"}
    profiles = cli_json(cli, "profiles").get("profiles") or []
    st = cli_json(cli, "status")
    profile_index = int(st.get("profile_index") or 0)
    nodes = extract_nodes(read_sub(app), profile_index)
    if nodes:
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            pings = list(pool.map(lambda n: tcp_ping(n["address"], n["port"]), nodes))
        for node, ping in zip(nodes, pings):
            node["ping_ms"] = ping
    else:
        nodes = cli_json(cli, "nodes").get("nodes") or []
        for node in nodes:
            node.setdefault("ping_ms", None)
    return {"ok": True, "app": app, "cli": cli,
            "profile_index": profile_index,
            "node_index": int(st.get("node_index") if st.get("node_index") is not None else -1),
            "profiles": profiles, "nodes": nodes,
            "updated": time.time()}


def _gh_latest_tag(repo: str) -> str:
    out = run(["curl", "-s", "--max-time", "15", "-H", "Accept: application/vnd.github+json",
               f"https://api.github.com/repos/{repo}/releases/latest"], timeout=20)
    try:
        return str(json.loads(out).get("tag_name") or "").lstrip("v")
    except ValueError:
        return ""


def _ver_tuple(value: str):
    parts = re.findall(r"\d+", value or "")
    return tuple(int(p) for p in parts[:4]) if parts else ()


def installed_zapret_version() -> str:
    out = run(["pacman", "-Q", "zapret-git"]) or run(["pacman", "-Q", "zapret"])
    fields = out.split()
    return fields[1] if len(fields) > 1 else ""


def installed_tgws_version() -> str:
    try:
        return open(TGWS_VERSION_FILE, encoding="utf-8").read().strip()
    except OSError:
        return ""


def _aur_version(pkg: str) -> str:
    url = f"https://aur.archlinux.org/rpc/v5/info?arg%5B%5D={pkg}"
    out = run(["curl", "-s", "--max-time", "15", url], timeout=20)
    try:
        results = json.loads(out).get("results") or []
        return str(results[0].get("Version") or "") if results else ""
    except (ValueError, IndexError):
        return ""


def _max_ver(*versions: str) -> str:
    best = ""
    for value in versions:
        if value and _ver_tuple(value) > _ver_tuple(best):
            best = value
    return best


def check_updates() -> dict:
    def newer(installed, latest):
        return bool(installed and latest and _ver_tuple(latest) > _ver_tuple(installed))

    zap_installed = installed_zapret_version()
    zap_aur = _aur_version("zapret-git")
    zap_gh = _gh_latest_tag(ZAPRET_REPOS[0])
    zap_latest = _max_ver(zap_aur, zap_gh)
    tg_installed = installed_tgws_version()
    tg_latest = _gh_latest_tag(TGWS_REPO)
    return {
        "checked": time.time(),
        "zapret": {"installed": zap_installed, "latest": zap_latest, "aur": zap_aur,
                   "github": zap_gh, "update": newer(zap_installed, zap_latest)},
        "tgwsproxy": {"installed": tg_installed, "latest": tg_latest, "update": newer(tg_installed, tg_latest)},
    }


def write_updates(app: str, data: dict) -> None:
    if not app:
        return
    path = os.path.join(HOME, ".cache", app, "updates.json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False)
    os.replace(tmp, path)


def cached_updates(app: str) -> dict:
    path = os.path.join(HOME, ".cache", app, "updates.json") if app else ""
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if time.time() - float(data.get("checked") or 0) > UPDATES_MAX_AGE:
        return {}
    return data


def run_rc(cmd: list[str], timeout: float = 900.0) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def _gh_release_asset(repo: str, asset_name: str) -> dict:
    out = run(["curl", "-s", "--max-time", "20", "-H", "Accept: application/vnd.github+json",
               f"https://api.github.com/repos/{repo}/releases/latest"], timeout=25)
    try:
        data = json.loads(out)
    except ValueError:
        return {}
    for asset in data.get("assets") or []:
        if asset.get("name") == asset_name:
            return {"tag": str(data.get("tag_name") or "").lstrip("v"),
                    "url": asset.get("browser_download_url") or "",
                    "digest": str(asset.get("digest") or "")}
    return {}


def _sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _launch_in_terminal(command: str) -> bool:
    term = shutil.which("omarchy-launch-terminal")
    if not term:
        return False
    try:
        subprocess.Popen([term, "bash", "-lc", command], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except OSError:
        return False


def update_tgwsproxy() -> dict:
    """Обновляет tg-ws-proxy из последнего релиза GitHub (sha256-дайджест из API)."""
    asset_name = "TgWsProxy_linux_amd64"
    meta = _gh_release_asset(TGWS_REPO, asset_name)
    if not meta or not meta.get("url"):
        return {"ok": False, "error": "не удалось получить релиз с GitHub"}
    digest = str(meta.get("digest") or "").removeprefix("sha256:")
    if not digest:
        return {"ok": False, "error": "в релизе нет sha256-дайджеста — обнови вручную"}
    version = meta["tag"]
    tmp = os.path.join(HOME, ".cache", "tgwsproxy", f"{asset_name}-{version}.tmp")
    os.makedirs(os.path.dirname(tmp), exist_ok=True)
    rc, _ = run_rc(["curl", "-fL", "--retry", "3", "-sS", "-o", tmp, meta["url"]], timeout=900)
    if rc != 0 or not os.path.exists(tmp):
        return {"ok": False, "error": "не удалось скачать релиз"}
    if _sha256_file(tmp) != digest:
        os.remove(tmp)
        return {"ok": False, "error": "sha256 не совпал — обновление отменено"}
    binary = os.path.join(HOME, ".local", "bin", "tg-ws-proxy")
    os.makedirs(os.path.dirname(binary), exist_ok=True)
    was_running = bool(run(["pgrep", "-x", "tg-ws-proxy"]))
    if os.path.exists(binary):
        shutil.copy2(binary, binary + ".bak")
    os.replace(tmp, binary)
    os.chmod(binary, 0o755)
    version_file = os.path.join(HOME, ".local", "share", "tgwsproxy", "version")
    os.makedirs(os.path.dirname(version_file), exist_ok=True)
    with open(version_file, "w", encoding="utf-8") as handle:
        handle.write(version + "\n")
    if was_running:
        run(["pkill", "-x", "tg-ws-proxy"])
        time.sleep(0.7)
        subprocess.Popen([binary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    return {"ok": True, "version": version, "restarted": was_running}


def update_zapret() -> dict:
    """zapret — системный пакет: repo через pkexec, AUR/фолбэк через yay в терминале."""
    pkg = "zapret-git" if run(["pacman", "-Q", "zapret-git"]) else "zapret"
    term_cmd = f"yay -S --noconfirm --needed {pkg}; echo; read -rp 'Готово, нажми Enter…'"
    if run(["pacman", "-Si", pkg]):
        pkexec = shutil.which("pkexec")
        if pkexec:
            rc, _ = run_rc([pkexec, "pacman", "-S", "--noconfirm", "--needed", pkg], timeout=1800)
            if rc == 0:
                return {"ok": True, "package": pkg}
        if _launch_in_terminal(term_cmd):
            return {"ok": True, "deferred": True, "package": pkg,
                    "message": f"обновление {pkg} открыто в терминале — введи пароль"}
        return {"ok": False, "error": f"обнови {pkg} вручную: yay -S {pkg}"}
    if _launch_in_terminal(term_cmd):
        return {"ok": True, "deferred": True, "package": pkg,
                "message": f"обновление {pkg} открыто в терминале — введи пароль"}
    return {"ok": False, "error": f"обнови {pkg} вручную: yay -S {pkg}"}


def update_components(app: str) -> dict:
    """Обновляет компоненты с доступными обновлениями (клик по строке «Обновления»)."""
    data = check_updates()
    results: list[dict] = []
    messages: list[str] = []
    if (data.get("tgwsproxy") or {}).get("update"):
        res = update_tgwsproxy()
        res["component"] = "tg-ws-proxy"
        results.append(res)
        if res.get("ok"):
            messages.append("tg-ws-proxy обновлён до " + str(res.get("version"))
                            + (" (перезапущен)" if res.get("restarted") else ""))
        else:
            messages.append("tg-ws-proxy: " + str(res.get("error")))
    if (data.get("zapret") or {}).get("update"):
        res = update_zapret()
        res["component"] = "zapret"
        results.append(res)
        if res.get("message"):
            messages.append(str(res["message"]))
        elif res.get("ok"):
            messages.append("zapret обновлён")
        else:
            messages.append("zapret: " + str(res.get("error")))
    write_updates(app, check_updates())
    if not results:
        return {"ok": True, "results": [], "messages": ["обновлений нет"]}
    return {"ok": all(r.get("ok") for r in results), "results": results,
            "messages": messages or ["готово"]}


def collect(check: bool) -> dict:
    app, cli = resolve_cli()
    iface = wan_iface()
    data = {
        "ok": True,
        "app": app,
        "cli": cli,
        "vpn": vpn_status(cli),
        "zapret": zapret_status(iface),
        "tgwsproxy": tgwsproxy_status(),
        "direct": direct_status(app),
        "updates": cached_updates(app),
        "youtube": cached_youtube(app),
        "health": cached_health(app),
        "route_audit": cached_route_audit(app),
        "vpn_test": read_vpn_test(app),
    }
    if check:
        data["checks"] = live_checks()
    return data


def main() -> int:
    ap = argparse.ArgumentParser(prog="bypass-status", description="Статус всех обходов (JSON)")
    ap.add_argument("--json", action="store_true", help="JSON (по умолчанию)")
    ap.add_argument("--check", action="store_true", help="живые проверки доступности")
    ap.add_argument("--vpn", action="store_true", help="профили/серверы подписки + TCP-пинг")
    ap.add_argument("--updates", action="store_true", help="проверить обновления zapret/tg-ws-proxy")
    ap.add_argument("--update-components", action="store_true",
                    help="скачать и установить доступные обновления (zapret/tg-ws-proxy)")
    ap.add_argument("--yt", action="store_true", help="проверить YouTube (страница + видео с googlevideo)")
    ap.add_argument("--rescan-request", action="store_true", help="запросить перебор стратегий zapret")
    ap.add_argument("--vpn-test", action="store_true",
                    help="запустить тест серверов VPN (omavpn probe) фоном")
    ap.add_argument("--optimize", action="store_true",
                    help="подобрать лучший регион и сервер (omavpn best --apply) фоном")
    ap.add_argument("--health", action="store_true",
                    help="комплексный тест текущей конфигурации (+ самовосстановление VPN)")
    ap.add_argument("--health-json", action="store_true",
                    help="комплексный тест без самовосстановления")
    ap.add_argument("--route-audit", action="store_true",
                    help="аудит маршрутов: нерабочий домен перевести на рабочий путь")
    ap.add_argument("--route-audit-recheck", action="store_true",
                    help="перепроверить оверрайды старше суток (вернуть домен на direct)")
    args = ap.parse_args()
    if args.vpn:
        app, cli = resolve_cli()
        print(json.dumps(vpn_info(app, cli), ensure_ascii=False))
        return 0
    if args.updates:
        app, _ = resolve_cli()
        data = check_updates()
        write_updates(app, data)
        print(json.dumps(data, ensure_ascii=False))
        return 0
    if args.update_components:
        app, _ = resolve_cli()
        print(json.dumps(update_components(app), ensure_ascii=False))
        return 0
    if args.yt:
        app, _ = resolve_cli()
        data = youtube_status()
        write_json_cache(app, "yt.json", data)
        print(json.dumps(data, ensure_ascii=False))
        return 0
    if args.rescan_request:
        print(json.dumps(request_rescan(), ensure_ascii=False))
        return 0
    if args.vpn_test:
        _, cli = resolve_cli()
        print(json.dumps(start_vpn_test(cli), ensure_ascii=False))
        return 0
    if args.optimize:
        _, cli = resolve_cli()
        print(json.dumps(start_optimize(cli), ensure_ascii=False))
        return 0
    if args.health or args.health_json:
        print(json.dumps(run_health(heal_vpn=not args.health_json), ensure_ascii=False))
        return 0
    if args.route_audit:
        print(json.dumps(run_route_audit(), ensure_ascii=False))
        return 0
    if args.route_audit_recheck:
        print(json.dumps(run_route_recheck(), ensure_ascii=False))
        return 0
    print(json.dumps(collect(args.check), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
