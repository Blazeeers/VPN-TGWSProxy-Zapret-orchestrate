#!/usr/bin/env bash
# omavpn-guard — надзиратель за обходами.
#
# Что должно работать само:
#   * YouTube, Discord — через обход (zapret), а не через VPN; в VPN только если
#     обход в этой сети не справляется;
#   * Telegram — через локальный tg-ws-proxy; в VPN только если прокси не тянет
#     (и для Bot API, который напрямую из РФ не работает);
#   * всё остальное (заблокированные сайты) — через VPN, он включён постоянно.
#
# Разделение ролей:
#   * zapret-autotune (root, таймер) — арбитр пути для YouTube/Discord: подбирает
#     стратегию, держит direct_domains.txt и решает по каждой сети, работает ли
#     обход. Решение — /var/lib/zapret-autotune/wifi-<ключ>.strategy (число = zapret,
#     "vpn" = нужен VPN).
#   * omavpn-guard (этот скрипт) — надзор: проверяет сервисы, поднимает упавший
#     VPN, чинит профиль sing-box, перезапускает tg-ws-proxy, перебирает ноды,
#     просит autotune перепровериться, и лишь в крайнем случае сам трогает путь.
#
# Режимы:
#   omavpn-guard              проверка и лечение (таймер)
#   omavpn-guard --autostart  поднять VPN при входе, если был включён
#   omavpn-guard --status     короткий JSON для отладки (без блокировки)

set -uo pipefail

HOME_DIR="${HOME:?}"
OMAVPN="$HOME_DIR/.local/bin/omavpn"
STATE_DIR="$HOME_DIR/.local/state/omavpn-guard"
LOG="$STATE_DIR/guard.log"
LOCK="$STATE_DIR/guard.lock"
INTENT_FILE="$STATE_DIR/intent"
STREAK_FILE="$STATE_DIR/fail_streak"
NEXT_TRY_FILE="$STATE_DIR/next_try"
LAST_SWITCH="$STATE_DIR/last_switch"
SWITCH_HISTORY="$STATE_DIR/switch_history"
LAST_NET_FILE="$STATE_DIR/last_net"
VPN_STATE="$HOME_DIR/.local/state/omavpn/state.json"
VPN_SETTINGS="$HOME_DIR/.config/omavpn/settings.json"
SINGBOX_CFG="$HOME_DIR/.local/state/omavpn/singbox.json"
DIRECT_FILE="$HOME_DIR/.config/omavpn/direct_domains.txt"
SB_BIN="$HOME_DIR/.local/share/omavpn/bin/sing-box"
AUTOTUNE_DIR="/var/lib/zapret-autotune"
RESCAN_REQUEST="$HOME_DIR/.cache/zapret-autotune/rescan.request"
TG_UNIT='app-tg\x2dws\x2dproxy@autostart.service'

COOLDOWN=900        # ручное вмешательство в путь не чаще раза в 15 минут
MAX_BACKOFF=3600    # потолок паузы после серии неудач
TUN_WAIT=25         # сколько ждать интерфейс после запуска
# Живой перебор стратегий длится 5:46–7:21 (29 кандидатов × 2 сервиса), поэтому
# 600 с не хватало: guard решал, что «перебор не завершился», и лез в путь руками.
RESCAN_WAIT=1200    # сколько ждать, пока autotune переберёт стратегии
# `omavpn heal` перебирает все ноды профиля (14 шт., до ~400 с); при 240 с его
# убивали на середине, троттл не записывался и следующий тик начинал заново.
HEAL_TIMEOUT=420
MAX_NODES=5         # сколько нод перебрать за один прогон
CURL_T=8            # таймаут одной HTTP-проверки, с (в --status урезается)

YT_DOMAINS="youtube.com
youtu.be
ytimg.com
ggpht.com
googlevideo.com
youtube-nocookie.com
youtubekids.com
youtubegaming.com
youtubeeducation.com
youtubemusic.com
ytstatic.com
youtube.googleapis.com
youtubei.googleapis.com"

mkdir -p -m 700 "$STATE_DIR" 2>/dev/null || { echo "omavpn-guard: нет каталога состояния" >&2; exit 1; }
chmod 700 "$STATE_DIR" 2>/dev/null || true
umask 077

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || return 0
    local n
    n=$(wc -l <"$LOG" 2>/dev/null || echo 0)
    if [ "${n:-0}" -gt 800 ]; then
        tail -n 400 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
    fi
}

# Уведомление пользователю. Одинаковый текст — не чаще раза в час.
notify() {
    local msg="$1" last_file="$STATE_DIR/last_notify" last_msg last_ts
    last_msg=$(head -1 "$last_file" 2>/dev/null)
    last_ts=$(sed -n '2p' "$last_file" 2>/dev/null || echo 0)
    if [ "$msg" = "$last_msg" ] && [ $(( $(now) - ${last_ts:-0} )) -lt 3600 ]; then
        return 0
    fi
    printf '%s\n%s\n' "$msg" "$(now)" >"$last_file" 2>/dev/null
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Обходы" -u normal "Обходы" "$msg" >/dev/null 2>&1
}

now() { date +%s; }

# --- состояние -------------------------------------------------------------

tun_up() { ip link show omavpn0 >/dev/null 2>&1; }

runtime_field() {
    [ -f "$VPN_STATE" ] || { echo ""; return; }
    jq -r ".$1 // empty" "$VPN_STATE" 2>/dev/null
}

# Режим VPN: tun (по умолчанию) или proxy. Читаем state.json, а до первого
# запуска — настройки omavpn: в proxy TUN не поднимается вообще, и всё, что
# считает «VPN = omavpn0», в этом режиме врёт.
vpn_mode() {
    local m
    m=$(runtime_field mode)
    [ -n "$m" ] || m=$(jq -r '.mode // empty' "$VPN_SETTINGS" 2>/dev/null)
    case "$m" in
        proxy) echo proxy ;;
        *)     echo tun ;;
    esac
}

# Живой ли xray. В режиме proxy VPN держится только на нём (sing-box не нужен).
xray_up() {
    command -v pgrep >/dev/null 2>&1 || return 0
    pgrep -x xray >/dev/null 2>&1
}

# Жив ли VPN. В режиме tun признак — интерфейс omavpn0 (флаг running в
# state.json ставится при запуске и сам не снимается, поэтому падение туннеля по
# нему не видно). В режиме proxy TUN нет по определению: там живой VPN — это
# записанный running=true и живой процесс xray. Раньше живость проверялась
# только по `ip link show omavpn0`, и guard каждые 10 минут зря делал
# `omavpn on` (off+on — реальный обрыв) и слал «туннель не поднялся».
vpn_alive() {
    tun_up && return 0
    [ "$(vpn_mode)" = "proxy" ] || return 1
    [ "$(runtime_field running)" = "true" ] || return 1
    xray_up
}

wait_vpn() {
    local i
    for i in $(seq 1 "$TUN_WAIT"); do
        vpn_alive && return 0
        sleep 1
    done
    return 1
}

# intent: включён ли VPN по воле пользователя.
# omavpn пишет running=false и при ошибке запуска, и в переходные моменты,
# поэтому живой VPN = «включён», а непустой last_error = «упало, не выключали».
intent_read() {
    local err prev
    if [ ! -f "$VPN_STATE" ]; then
        cat "$INTENT_FILE" 2>/dev/null || echo on
        return
    fi
    err=$(runtime_field last_error)
    prev=$(cat "$INTENT_FILE" 2>/dev/null || echo "on")

    if vpn_alive; then
        echo on
        return
    fi
    # Процесс умер, но VPN не выключали: `running=true` остаётся только после
    # `omavpn on`, а намеренный `off` пишет `running=false`. Без этой проверки
    # в режиме proxy падение xray выглядело бы как «пользователь выключил VPN».
    if [ "$(runtime_field running)" = "true" ]; then
        echo "$prev"
        return
    fi
    if [ -n "$err" ]; then
        echo "$prev"
        return
    fi
    echo off
}

intent_update() {
    local want
    want=$(intent_read)
    printf '%s\n' "$want" >"$INTENT_FILE" 2>/dev/null
    echo "$want"
}

# Состояние прав sing-box: ok | nobin (нет бинаря) | nocaps (нет cap_net_admin).
# Разные причины — разные сообщения: «нет бинаря» лечится переустановкой, а не
# setcap, и раньше оба случая валили guard целиком.
caps_state() {
    [ -x "$SB_BIN" ] || { echo nobin; return; }
    # без getcap (нет libcap) не можем судить — не блокируем работу
    command -v getcap >/dev/null 2>&1 || { echo ok; return; }
    if getcap "$SB_BIN" 2>/dev/null | grep -q cap_net_admin; then
        echo ok
    else
        echo nocaps
    fi
}

caps_ok() { [ "$(caps_state)" = "ok" ]; }

# Нужен ли TUN для текущего режима. В proxy sing-box не запускается вовсе,
# поэтому отсутствие caps там не поломка: раньше guard из-за него не лечил даже
# Telegram (прокси caps не нужны).
tun_needed() { [ "$(vpn_mode)" != "proxy" ]; }

# Установлен ли tg-ws-proxy вообще. Если компонента нет, Telegram не считаем
# сломанным (иначе guard будет зря включать VPN и слать тревоги).
tg_installed() {
    command -v tg-ws-proxy >/dev/null 2>&1 && return 0
    systemctl --user cat "$TG_UNIT" >/dev/null 2>&1
}

# Есть ли домены сервиса в direct-списке (= идут мимо VPN).
service_in_direct() {
    local list="$1" dom
    [ -f "$SINGBOX_CFG" ] || return 1
    while IFS= read -r dom; do
        [ -n "$dom" ] || continue
        if python3 - "$SINGBOX_CFG" "$dom" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    dom = sys.argv[2]
    for rule in d.get("route", {}).get("rules", []):
        if rule.get("outbound") != "direct":
            continue
        doms = rule.get("domain_suffix") or rule.get("domain") or []
        if dom in doms:
            sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(2)
PY
        then
            return 0
        fi
    done <<<"$list"
    return 1
}

json_field() { # $1 JSON, $2 имя поля -> значение или пусто
    # has(), а не `// empty`: `//` считает false отсутствующим значением, и
    # changed=false неотличим от «поля нет».
    printf '%s' "$1" | jq -r --arg f "$2" \
        'if type == "object" and has($f) then (.[$f] | tostring) else empty end' 2>/dev/null
}

json_actions() { # $1 JSON -> действия одной строкой
    printf '%s' "$1" | jq -r '((.actions // []) | join("; "))' 2>/dev/null
}

# Путь домена по правилам omavpn: `route list` проходит их в том же порядке, что
# и sing-box (override/always-proxy → direct-правило → final=proxy), поэтому
# ответ совпадает с конфигом. Правка direct_domains.txt тут ничего не решает:
# видео YouTube подмешивается встроенным BUILTIN_DIRECT_DOMAINS, стоит в
# direct-правиле ПЕРЕД файлом, и раньше guard «переводил YouTube на VPN»
# правкой файла, которая ни на что не влияла.
route_path_of() { # $1 домен -> direct|proxy|"" (спросить не удалось)
    local out
    out=$(timeout 20 "$OMAVPN" --json route list 2>/dev/null) || return 0
    printf '%s' "$out" | jq -r --arg d "$1" \
        'first(.routes[]? | select(.domain == $d) | .path) // empty' 2>/dev/null || true
}

path_now() {
    local p
    p=$(route_path_of youtube.com)
    [ -n "$p" ] && { echo "$p"; return; }
    # omavpn не ответил — грубая оценка по собранному конфигу sing-box
    if service_in_direct "$YT_DOMAINS"; then echo "direct"; return; fi
    [ -f "$SINGBOX_CFG" ] && echo "vpn" || echo unknown
}

# --- сеть и autotune -------------------------------------------------------

current_ssid() {
    nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1 | sed 's/\\:/:/g'
}

# Логика ключа сети повторяет netkey() из zapret-autotune один в один,
# иначе на кабеле и на нестандартных сетях решение autotune не читается.
wan_iface() {
    ip -o route show default 2>/dev/null | awk '{
        d="";
        for (i=1;i<=NF;i++) if ($i=="dev") d=$(i+1);
        if (d!="" && d!="omavpn0" && d!="tailscale0" && d !~ /^tun/) { print d; exit }
    }'
}

net_key() {
    local iface ssid gw mac key
    iface=$(wan_iface)
    [ -n "$iface" ] || iface="unknown"
    ssid=""
    case "$iface" in
        wl*|wlan*|wlp*) ssid=$(iwgetid -r "$iface" 2>/dev/null || true) ;;
    esac
    [ -n "$ssid" ] || ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$iface" 2>/dev/null | cut -d: -f2-)
    if [ -n "$ssid" ] && [ "$iface" != "unknown" ]; then
        key="wifi-$ssid"
    else
        gw=$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')
        mac=$(ip neigh show "$gw" 2>/dev/null | awk '/lladdr/{print $5; exit}')
        key="net-$iface-${mac:-$gw}"
    fi
    printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_'
}

autotune_mode() {
    local key f v
    key=$(net_key)
    [ -n "$key" ] || { echo unknown; return; }
    f="$AUTOTUNE_DIR/$key.strategy"
    if [ -r "$f" ]; then
        v=$(head -c 32 "$f" 2>/dev/null | tr -d '[:space:]')
        [ -n "$v" ] && { echo "$v"; return; }
    fi
    echo unknown
}

autotune_lastscan() {
    local key f
    key=$(net_key)
    [ -n "$key" ] || { echo 0; return; }
    f="$AUTOTUNE_DIR/$key.lastscan"
    cat "$f" 2>/dev/null | tr -d '[:space:]' || echo 0
}

zapret_active() { systemctl is-active --quiet zapret.service 2>/dev/null; }

# Идёт ли перебор стратегий прямо сейчас (автотюн ходит под своим flock).
autotune_running() { systemctl is-active --quiet zapret-autotune.service 2>/dev/null; }

request_rescan() {
    # Свой перебор уже идёт — второй запрос только сбил бы его и добавил
    # guard'у ложное «перебор не начался».
    if autotune_running; then
        log "autotune уже перебирает стратегии — жду его результат"
        return 0
    fi
    mkdir -p "$(dirname "$RESCAN_REQUEST")" 2>/dev/null
    rm -f "$RESCAN_REQUEST" 2>/dev/null
    printf '%s\n' "$(now)" >"$RESCAN_REQUEST" 2>/dev/null || return 1
    log "запросил перебор стратегий zapret"
    return 0
}

wait_rescan_result() {
    local before deadline retried=0
    before=$(autotune_lastscan)
    deadline=$(( $(now) + RESCAN_WAIT ))
    while [ "$(now)" -lt "$deadline" ]; do
        sleep 20
        if [ "$(autotune_lastscan)" != "$before" ] && [ "$(autotune_lastscan)" != "0" ]; then
            log "autotune закончил перебор (режим $(autotune_mode))"
            sleep 3
            health_ok_quiet && return 0
            return 1
        fi
        if [ "$retried" = "0" ] && [ "$(now)" -gt $(( deadline - RESCAN_WAIT + 90 )) ]; then
            retried=1
            log "перебор не начался — повторяю запрос"
            request_rescan >/dev/null 2>&1
        fi
    done
    log "перебор не завершился за $((RESCAN_WAIT / 60)) мин"
    return 1
}

# --- проверки сервисов -----------------------------------------------------
# Каждая проверка пробуется дважды: одиночный обрыв curl не должен выглядеть
# сломанным сервисом — после него guard 10 минут перебирает стратегии и включает
# VPN, который человек только что выключил.

http_code() { # $1 url -> HTTP-код (000 — не ответил)
    local code="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        code=$(curl -4 -s -o /dev/null -w '%{http_code}' --max-time "$CURL_T" "$1" 2>/dev/null)
        [ -n "$code" ] && [ "$code" != "000" ] && break
        [ "$i" -lt "$tries" ] && sleep 1
    done
    printf '%s' "${code:-000}"
}

http_body() { # $1 url, $2 лимит байт; 1 — тело не пришло
    local body="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        body=$(curl -4 -s --max-time "$CURL_T" "$1" 2>/dev/null | head -c "${2:-150000}")
        [ -n "$body" ] && { printf '%s' "$body"; return 0; }
        [ "$i" -lt "$tries" ] && sleep 1
    done
    return 1
}

http_meta() { # $1 url -> "код content-type размер"
    local out="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        out=$(curl -4 -s -o /dev/null -w '%{http_code} %{content_type} %{size_download}' \
            --max-time "$CURL_T" "$1" 2>/dev/null)
        case "${out%% *}" in 2??|3??) break ;; esac
        [ "$i" -lt "$tries" ] && sleep 1
    done
    printf '%s' "$out"
}

svc_youtube_ok() {
    local code ctype size body img rest
    code=$(http_code https://www.youtube.com/)
    [ "$code" = "200" ] || return 1
    body=$(http_body https://www.youtube.com/) || return 1
    grep -qiE 'ytimg|youtube' <<<"$body" || return 1
    # CDN превью — generate_204 на самом i.ytimg.com. Раньше здесь стоял жёсткий
    # id видео (dQw4w9WgXcQ/hqdefault.jpg): если видео удалят, guard считал бы
    # YouTube сломанным по кругу и лечил несуществующую поломку. generate_204
    # от конкретного видео не зависит и проверяет то же самое: DNS + TLS + ответ CDN.
    code=$(http_code https://i.ytimg.com/generate_204)
    { [ "$code" = "204" ] || [ "$code" = "200" ]; } || return 1
    # ...и что картинки реально отдаются картинками (favicon — вечный image/*).
    img=$(http_meta https://www.youtube.com/favicon.ico)
    code=${img%% *}
    rest=${img#* }
    ctype=${rest%% *}
    size=${rest##* }
    [ "$code" = "200" ] && [ "${size:-0}" -gt 500 ] 2>/dev/null && [[ "${ctype:-}" == image/* ]] || return 1
    code=$(http_code https://redirector.googlevideo.com/generate_204)
    { [ "$code" = "204" ] || [ "$code" = "200" ]; } || return 1
    # Служебный API YouTube (youtubei.googleapis.com) блокируют наглухо: страница
    # и картинки открываются, а плеер висит по 10 с на каждом запросе. Успех —
    # любой HTTP-ответ (TLS-соединение и ответ состоялись): 405/400 норма,
    # 000 — таймаут/обрыв. Домен всегда идёт через VPN (ALWAYS_PROXY_DOMAINS),
    # поэтому проверять его напрямую бессмысленно: при выключенном VPN и в
    # режиме «proxy» (без TUN) он недоступен по определению — и guard каждые
    # 10 минут «лечил» бы несуществующую поломку (rescan zapret + включение VPN).
    vpn_alive || return 0
    code=$(http_code https://youtubei.googleapis.com/youtubei/v1/player)
    [ -n "$code" ] && [ "$code" != "000" ]
}

svc_discord_ok() {
    [ "$(http_code https://discord.com/api/v9/gateway)" = "200" ] || return 1
    [ "$(http_code https://discord.com/)" = "200" ]
}

svc_telegram_ok() {
    local code
    systemctl --user is-active --quiet "$TG_UNIT" 2>/dev/null || return 1
    code=$(http_code https://api.telegram.org/)
    [ "$code" = "200" ] || [ "$code" = "302" ] || return 1
    [ "$(http_code https://web.telegram.org/)" = "200" ]
}

# Список сломанных сервисов через пробел.
broken_services_quiet() {
    local broken=""
    svc_youtube_ok || broken="$broken youtube"
    svc_discord_ok || broken="$broken discord"
    if tg_installed; then
        svc_telegram_ok || broken="$broken telegram"
    fi
    echo "${broken# }"
}

health_ok_quiet() { [ -z "$(broken_services_quiet)" ]; }

# --- профиль omavpn --------------------------------------------------------
# Миграция установок до 2.1.0: в старых версиях TUN поднимался с mtu 9000 и
# стеком mixed, из-за чего рвалось ~20% TLS-соединений к YouTube, а mixed
# ломал туннель целиком. Здесь правим установленный CLI один раз.
# Когда 2.1.0 разойдётся, блок можно удалить (2.2.0).

ensure_profile() {
    local cnt changed=0
    cnt=$(grep -c '"mtu": 9000' "$OMAVPN" 2>/dev/null); cnt=${cnt:-0}
    if [ "${cnt:-0}" -eq 1 ]; then
        cp -p "$OMAVPN" "$OMAVPN.bak-guard" 2>/dev/null
        sed -i 's/"mtu": 9000/"mtu": 1500/' "$OMAVPN" && changed=1
    fi
    cnt=$(grep -c '"stack": "mixed"' "$OMAVPN" 2>/dev/null); cnt=${cnt:-0}
    if [ "${cnt:-0}" -eq 1 ]; then
        cp -p "$OMAVPN" "$OMAVPN.bak-guard" 2>/dev/null
        sed -i 's/"stack": "mixed"/"stack": "gvisor"/' "$OMAVPN" && changed=1
    fi
    if [ "$changed" = "1" ]; then
        # py_compile пишет __pycache__ в ~/.local/bin даже с -B (это лишь запрет
        # импорта байткода, а не компиляции). Проверяем синтаксис компиляцией в
        # памяти: ни следа на диске.
        if python3 -c 'import sys; f = sys.argv[1]; compile(open(f, encoding="utf-8").read(), f, "exec")' \
            "$OMAVPN" 2>/dev/null; then
            log "профиль omavpn поправлен (mtu 1500 / stack gvisor)"
        else
            log "ОШИБКА: правка профиля сломала синтаксис — откатываю"
            [ -f "$OMAVPN.bak-guard" ] && cp -p "$OMAVPN.bak-guard" "$OMAVPN"
            return 1
        fi
        return 0
    fi
    return 2
}

# --- VPN -------------------------------------------------------------------

vpn_up() {
    vpn_alive && return 0
    timeout 90 "$OMAVPN" on >/dev/null 2>&1
    wait_vpn
}

vpn_restart() {
    timeout 90 "$OMAVPN" restart >/dev/null 2>&1
    wait_vpn || vpn_up
}

vpn_consistent() {
    vpn_alive || return 0
    xray_up
}

# Статус omavpn — один раз на прогон. `omavpn --json status` прогоняет все
# проверки сервисов и складывает их результаты в probe.results (десятки КБ), а
# try_nodes запрашивал его дважды подряд: два тяжёлых прогона на тик и два разных
# снимка (orig из одного, node_count из другого). Кэш — в переменной, поэтому
# функция обязана вызываться в текущей оболочке, а не в $(…).
VPN_STATUS_JSON=""
VPN_STATUS_LOADED=0
vpn_status_load() {
    [ "$VPN_STATUS_LOADED" = 1 ] && return 0
    VPN_STATUS_JSON=$(timeout 20 "$OMAVPN" --json status 2>/dev/null)
    VPN_STATUS_LOADED=1
    return 0
}

try_nodes() {
    local orig node_count node tries=0
    vpn_status_load
    orig=$(printf '%s' "$VPN_STATUS_JSON" | jq -r '.node_index // -1' 2>/dev/null)
    node_count=$(printf '%s' "$VPN_STATUS_JSON" | jq -r '.nodes | length' 2>/dev/null)
    [ -n "$orig" ] || orig=-1
    [ -n "$node_count" ] || node_count=0
    [ "$node_count" -gt 0 ] || return 1

    for node in $(seq 0 $(( node_count - 1 ))); do
        [ "$node" = "$orig" ] && continue
        tries=$((tries + 1))
        [ "$tries" -gt "$MAX_NODES" ] && break
        log "пробую ноду $node"
        timeout 90 "$OMAVPN" node "$node" >/dev/null 2>&1
        wait_vpn || vpn_up
        if health_ok_quiet; then
            log "помогла нода $node"
            return 0
        fi
    done

    if [ "${orig:--1}" != "-1" ] && [ "${orig:-0}" -ge 0 ] 2>/dev/null; then
        timeout 90 "$OMAVPN" node "$orig" >/dev/null 2>&1
        wait_vpn || vpn_up
        log "вернул прежнюю ноду $orig"
    fi
    return 1
}

# --- крайняя мера: ручная смена пути ---------------------------------------

switches_last_hour() {
    local cutoff cnt ts
    cutoff=$(( $(now) - 3600 ))
    cnt=0
    [ -f "$SWITCH_HISTORY" ] || { echo 0; return; }
    while read -r ts; do
        [ -n "$ts" ] || continue
        [ "$ts" -ge "$cutoff" ] 2>/dev/null && cnt=$((cnt + 1))
    done <"$SWITCH_HISTORY"
    echo "$cnt"
}

note_switch() {
    date +%s >>"$SWITCH_HISTORY" 2>/dev/null
    tail -n 20 "$SWITCH_HISTORY" >"$SWITCH_HISTORY.tmp" 2>/dev/null && mv "$SWITCH_HISTORY.tmp" "$SWITCH_HISTORY" 2>/dev/null
    # метка последней ручной смены пути: раньше её ставил только set_path, и
    # после перехода на `omavpn route set` кулдаун COOLDOWN перестал работать
    date +%s >"$LAST_SWITCH" 2>/dev/null
}

can_switch() {
    [ -f "$LAST_SWITCH" ] || return 0
    local last
    last=$(cat "$LAST_SWITCH" 2>/dev/null)
    last=${last:-0}
    case "$last" in *[!0-9]*|"") last=0 ;; esac
    [ $(( $(now) - last )) -ge "$COOLDOWN" ]
}

direct_file_settled() {
    [ -f "$DIRECT_FILE" ] || return 0
    local age
    age=$(( $(now) - $(stat -c %Y "$DIRECT_FILE" 2>/dev/null || echo 0) ))
    [ "$age" -ge 60 ]
}

# route_force <домен> <proxy|direct> <причина>
# Крайняя мера — оверрайд маршрута через сам omavpn, а не правка
# direct_domains.txt: видео YouTube подмешивается встроенным
# BUILTIN_DIRECT_DOMAINS, который стоит в direct-правиле ПЕРЕД файлом, поэтому
# правка файла ни на что не влияла и `path_now` продолжал говорить «direct».
# Оверрайд proxy ставится в правило proxy — оно первое, и его ничего не перебивает.
# Возврат: 0 — путь изменён, 2 — уже такой, 1 — ошибка.
route_force() {
    local dom="$1" path="$2" reason="$3" out rc changed
    out=$(timeout 60 "$OMAVPN" --json route set "$dom" "$path" \
        --reason "$reason" --no-restart 2>/dev/null)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "route set $dom $path: ошибка (код $rc)"
        return 1
    fi
    changed=$(json_field "$out" changed)
    case "$changed" in
        true)  return 0 ;;
        false) return 2 ;;
        *)     log "route set $dom $path: непонятный ответ omavpn"
               return 1 ;;
    esac
}

# --- лечение ---------------------------------------------------------------

restart_tg() {
    log "перезапускаю tg-ws-proxy"
    systemctl --user restart "$TG_UNIT" >/dev/null 2>&1
    sleep 5
    svc_telegram_ok
}

# Разбор ответа `omavpn --json heal`. Раньше вывод уходил в /dev/null, и шаг
# «heal не помог» одинаково выглядел и при reason=throttled (VPN не трогали —
# не чаще раза в 10 минут), и при dead-ноде: guard шёл дальше по лечению,
# считая, что мера применена и не сработала.
heal_vpn() {
    local out rc reason
    out=$(timeout "$HEAL_TIMEOUT" "$OMAVPN" --json heal 2>/dev/null)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "omavpn heal: код $rc (таймаут — $HEAL_TIMEOUT с)"
        return 1
    fi
    reason=$(json_field "$out" reason)
    case "$reason" in
        "")        log "omavpn heal выполнен: $(json_actions "$out")" ;;
        throttled) log "omavpn heal на паузе (не чаще раза в 10 мин) — иду дальше"; return 1 ;;
        vpn_off)   log "omavpn heal: VPN выключен и не запущен"; return 1 ;;
        deadline)  log "omavpn heal упёрся в дедлайн перебора нод: $(json_actions "$out")"; return 1 ;;
        *)         log "omavpn heal: причина «$reason» $(json_actions "$out")" ;;
    esac
    return 0
}

heal() {
    local mode broken svc fixed=0 path_vpn

    mode=$(autotune_mode)
    path_vpn=$(vpn_mode)
    log "лечение: путь $(path_now), режим VPN $path_vpn, autotune=$mode, zapret=$(zapret_active && echo on || echo off)"

    if ! vpn_alive; then
        if vpn_up; then log "VPN поднят"; else log "VPN не поднимается"; return 1; fi
    fi

    broken=$(broken_services_quiet)
    [ -n "$broken" ] || { log "всё уже работает"; return 0; }

    # Telegram — своя логика: локальный прокси, VPN только как последнее средство
    if [[ " $broken " == *" telegram "* ]]; then
        if restart_tg; then
            broken=$(broken_services_quiet)
            log "помог перезапуск tg-ws-proxy${broken:+, осталось: $broken}"
            [ -z "$broken" ] && return 0
        else
            log "tg-ws-proxy не ожил — проверю через VPN"
            vpn_up
        fi
    fi

    # Общие меры для YouTube/Discord
    if [[ " $broken " == *" youtube "* || " $broken " == *" discord "* ]]; then
        heal_vpn
        wait_vpn
        if health_ok_quiet; then log "помогло: omavpn heal"; return 0; fi

        if [ "$mode" = "vpn" ]; then
            log "autotune считает, что нужен VPN — перебираю ноды"
            try_nodes && return 0
        else
            log "autotune в режиме стратегии $mode — прошу перебор"
            if request_rescan; then
                wait_rescan_result && { log "помог перебор стратегий"; return 0; }
            fi
            log "перебор не помог — пробую VPN"
            if vpn_up && try_nodes; then return 0; fi
        fi

        # Крайняя мера: увести сломанный сервис в VPN оверрайдом маршрута.
        if [ "$(switches_last_hour)" -ge 3 ]; then
            log "путь переключался 3+ раза за час — не воюю с autotune"
        elif ! can_switch; then
            log "ручная смена пути на кулдауне"
        elif ! direct_file_settled; then
            log "autotune только что писал direct_domains — не вмешиваюсь"
        else
            for svc in $broken; do
                case "$svc" in
                    youtube)
                        # переводим только если домен реально на direct, иначе
                        # оверрайд вернул бы 2 и «переведён» было бы ложью
                        if [ "$(route_path_of youtube.com)" = "direct" ]; then
                            route_force youtube.com proxy "аудит: guard — обход не тянет"
                            case $? in
                                0) note_switch; fixed=1
                                   log "YouTube переведён на VPN (route override)" ;;
                                2) log "YouTube уже идёт через VPN — переключать нечего" ;;
                                *) : ;;
                            esac
                        fi
                        ;;
                    discord)
                        if [ "$(route_path_of discord.com)" = "direct" ]; then
                            route_force discord.com proxy "аудит: guard — обход не тянет"
                            case $? in
                                0) note_switch; fixed=1
                                   log "Discord переведён на VPN (route override)" ;;
                                2) log "Discord уже идёт через VPN — переключать нечего" ;;
                                *) : ;;
                            esac
                        fi
                        ;;
                esac
            done
            if [ "$fixed" = "1" ]; then
                # оверрайды ставились с --no-restart: один перезапуск на пачку
                vpn_restart
                health_ok_quiet && return 0
            fi
        fi
    fi

    log "лечение не помогло: $(broken_services_quiet)"
    return 1
}

# --- бэкофф ----------------------------------------------------------------

streak() {
    local s
    s=$(cat "$STREAK_FILE" 2>/dev/null || echo 0)
    case "$s" in *[!0-9]*|"") echo 0 ;; *) echo "$s" ;; esac
}

in_backoff() {
    [ -f "$NEXT_TRY_FILE" ] || return 1
    local next_try
    next_try=$(cat "$NEXT_TRY_FILE" 2>/dev/null || echo 0)
    [ "$(now)" -lt "${next_try:-0}" ]
}

mark_fail() {
    local s delay
    s=$(( $(streak) + 1 ))
    [ "$s" -gt 10 ] && s=10
    printf '%s\n' "$s" >"$STREAK_FILE"
    if [ "$s" -ge 3 ]; then
        delay=$(( 900 * (1 << (s - 3)) ))
        [ "$delay" -gt "$MAX_BACKOFF" ] && delay=$MAX_BACKOFF
        printf '%s\n' "$(( $(now) + delay ))" >"$NEXT_TRY_FILE"
        log "неудач подряд: $s — пауза $((delay / 60)) мин"
        [ "$s" -eq 3 ] && notify "Обходы не работают: $(broken_services_quiet). Автолечение не помогло."
    fi
}

mark_ok() {
    printf '0\n' >"$STREAK_FILE"
    rm -f "$NEXT_TRY_FILE"
}

reset_on_net_change() {
    local key prev
    key=$(net_key)
    prev=$(cat "$LAST_NET_FILE" 2>/dev/null || echo "")
    if [ "$key" != "$prev" ]; then
        printf '%s\n' "$key" >"$LAST_NET_FILE" 2>/dev/null
        if [ -n "$prev" ]; then
            rm -f "$NEXT_TRY_FILE" 2>/dev/null
            printf '0\n' >"$STREAK_FILE" 2>/dev/null
            log "сеть сменилась ($prev → $key) — счётчик неудач сброшен"
        fi
    fi
}

# --- режимы ----------------------------------------------------------------

cmd_autostart() {
    local want
    want=$(intent_read)
    if [ "$want" = "on" ] && ! vpn_alive; then
        log "автозапуск: VPN был включён — поднимаю"
        vpn_up || { log "автозапуск: поднять VPN не удалось"; notify "VPN не поднялся при входе"; }
    fi
    # caps нужны только TUN: в режиме proxy sing-box не запускается, и ругаться
    # «VPN не поднимется без пароля» там не за что.
    if tun_needed; then
        case "$(caps_state)" in
            nocaps)
                log "ВНИМАНИЕ: у sing-box нет cap_net_admin"
                notify "У sing-box нет cap_net_admin: VPN не поднимется без пароля" ;;
            nobin)
                log "ВНИМАНИЕ: нет $SB_BIN — TUN поднимать нечем"
                notify "Нет sing-box ($SB_BIN): VPN не поднимется" ;;
        esac
    fi
}

cmd_status() {
    # --status зовут для отладки, а не для лечения: одна попытка на запрос и
    # таймаут 4 с (было 8 с и без повторов — ответ шёл около минуты).
    CURL_T=4
    HTTP_TRIES=1
    printf '{"vpn_alive":%s,"tun_up":%s,"mode":"%s","intent":"%s","path":"%s","autotune":"%s","zapret":%s,"caps_ok":%s,"caps":"%s","streak":%s,"broken":"%s"}\n' \
        "$(vpn_alive && echo true || echo false)" \
        "$(tun_up && echo true || echo false)" \
        "$(vpn_mode)" \
        "$(intent_read)" \
        "$(path_now)" \
        "$(autotune_mode)" \
        "$(zapret_active && echo true || echo false)" \
        "$(caps_ok && echo true || echo false)" \
        "$(caps_state)" \
        "$(streak)" \
        "$(broken_services_quiet)"
}

cmd_check() {
    local want broken caps

    reset_on_net_change
    want=$(intent_update)

    # caps нужны только для TUN. В режиме proxy их отсутствие — не поломка:
    # Telegram (локальный прокси) и VPN через socks работают и без них, а раньше
    # guard из-за отсутствия caps не лечил вообще ничего.
    caps=$(caps_state)
    if [ "$caps" != "ok" ] && tun_needed; then
        case "$caps" in
            nobin)
                log "нет $SB_BIN — TUN поднять нечем (переустанови omavpn)"
                notify "VPN не поднимется: не найден sing-box" ;;
            *)
                log "нет cap_net_admin у sing-box — нужен sudo setcap, лечить нечем"
                notify "VPN не может подняться: у sing-box нет cap_net_admin" ;;
        esac
        return 1
    fi

    if in_backoff && ! { [ "$want" = "on" ] && ! vpn_alive; }; then
        log "пауза после неудач — пропускаю до $(date -d "@$(cat "$NEXT_TRY_FILE")" '+%F %T' 2>/dev/null)"
        return 0
    fi

    if [ "$want" = "on" ]; then
        if ensure_profile; then vpn_restart; fi
        if ! vpn_consistent; then
            log "VPN числится живым, но xray мёртв — перезапускаю"
            vpn_restart
        fi
        if ! vpn_alive; then
            log "VPN должен быть включён, но не отвечает (режим $(vpn_mode)) — поднимаю"
            vpn_up || log "VPN не поднялся"
        fi
    fi

    broken=$(broken_services_quiet)
    if [ -z "$broken" ]; then
        mark_ok
        log "всё в порядке (путь $(path_now), autotune $(autotune_mode), режим $(vpn_mode))"
        return 0
    fi

    if [ "$want" = "off" ] && ! vpn_alive; then
        # VPN выключен пользователем: сначала чиним каждый сервис по его природе,
        # VPN — только если обход действительно не тянет.
        log "VPN выключен, не работают:$broken — чиню без VPN"
        if [[ " $broken " == *" telegram "* ]] && restart_tg; then
            broken=$(broken_services_quiet)
            [ -z "$broken" ] && { mark_ok; log "Telegram поднялся перезапуском прокси"; return 0; }
        fi
        if [[ " $broken " == *" youtube "* || " $broken " == *" discord "* ]]; then
            if request_rescan && wait_rescan_result; then
                mark_ok
                log "обход починился без VPN"
                return 0
            fi
        fi
        # Перед включением VPN проверяем ещё раз: за время перебора (до 20 мин)
        # сеть могла ожить сама, и поднимать туннель вопреки выключению не за что.
        broken=$(broken_services_quiet)
        if [ -z "$broken" ]; then
            mark_ok
            log "сервисы заработали сами — VPN не трогаю"
            return 0
        fi
        log "обход не тянет (не работают:$broken) — поднимаю VPN"
        if vpn_up && health_ok_quiet; then
            mark_ok
            notify "Обход в этой сети не справляется, включил VPN"
            return 0
        fi
        mark_fail
        return 1
    fi

    if heal; then
        mark_ok
        return 0
    fi

    mark_fail
    return 1
}

# --- точка входа -----------------------------------------------------------

if [ "${1:-}" = "--status" ]; then
    cmd_status
    exit 0
fi

exec 9>"$LOCK"
if [ "${1:-}" = "--autostart" ]; then
    flock -w 120 9 || { log "автозапуск: не дождался блокировки"; exit 0; }
else
    if ! flock -n 9; then
        log "пропуск: идёт другой прогон"
        exit 0
    fi
fi

case "${1:-}" in
    --autostart) cmd_autostart ;;
    *)           cmd_check ;;
esac
