#!/usr/bin/env bash
# omavpn-guard — надзиратель за обходами.
#
# Что должно работать само:
#   * YouTube, Discord — через обход (zapret), а не через VPN; в VPN только если
#     обход в этой сети не справляется;
#   * Telegram — через локальный tg-ws-proxy; в VPN только если прокси не тянет
#     (и для Bot API, который напрямую из РФ не работает);
#   * всё остальное (заблокированные сайты) — через VPN, он включён постоянно.
#
# Разделение ролей:
#   * zapret-autotune (root, таймер) — арбитр пути для YouTube/Discord: подбирает
#     стратегию, держит direct_domains.txt и решает по каждой сети, работает ли
#     обход. Решение — /var/lib/zapret-autotune/wifi-<ключ>.strategy (число = zapret,
#     "vpn" = нужен VPN).
#   * omavpn-guard (этот скрипт) — надзор: проверяет сервисы, поднимает упавший
#     VPN, чинит профиль sing-box, перезапускает tg-ws-proxy, перебирает ноды,
#     просит autotune перепровериться, и лишь в крайнем случае сам трогает путь.
#
# Режимы:
#   omavpn-guard              проверка и лечение (таймер)
#   omavpn-guard --autostart  поднять VPN при входе, если был включён
#   omavpn-guard --status     короткий JSON для отладки (без блокировки)

set -uo pipefail

HOME_DIR="${HOME:?}"
OMAVPN="$HOME_DIR/.local/bin/omavpn"
STATE_DIR="$HOME_DIR/.local/state/omavpn-guard"
LOG="$STATE_DIR/guard.log"
LOCK="$STATE_DIR/guard.lock"
INTENT_FILE="$STATE_DIR/intent"
STREAK_FILE="$STATE_DIR/fail_streak"
NEXT_TRY_FILE="$STATE_DIR/next_try"
LAST_SWITCH="$STATE_DIR/last_switch"
SWITCH_HISTORY="$STATE_DIR/switch_history"
LAST_NET_FILE="$STATE_DIR/last_net"
VPN_STATE="$HOME_DIR/.local/state/omavpn/state.json"
XRAY_PID_FILE="$HOME_DIR/.local/state/omavpn/xray.pid"
VPN_SETTINGS="$HOME_DIR/.config/omavpn/settings.json"
SINGBOX_CFG="$HOME_DIR/.local/state/omavpn/singbox.json"
SINGBOX_LOG="$HOME_DIR/.local/state/omavpn/singbox.log"
# Порт SOCKS туннельного xray — тот же, что SOCKS_PORT в omavpn. Через него
# проверяем реальный выход: сам по себе поднятый omavpn0 ничего не доказывает.
VPN_SOCKS_PORT=10808
VPN_PROBE_URL="https://www.cloudflare.com/cdn-cgi/trace"
VPN_PROBE_T=5       # таймаут SOCKS-пробы, с
VPN_PROBE_TTL=20    # кэш результата пробы: vpn_alive зовётся в циклах wait_vpn
DIRECT_FILE="$HOME_DIR/.config/omavpn/direct_domains.txt"
SB_BIN="$HOME_DIR/.local/share/omavpn/bin/sing-box"
AUTOTUNE_DIR="/var/lib/zapret-autotune"
RESCAN_REQUEST="$HOME_DIR/.cache/zapret-autotune/rescan.request"
# Юнит tg-ws-proxy менялся: в 1.11.4 появился системный tg-ws-proxy.service,
# до этого был автозапуск из .desktop. Смотрим оба, иначе после обновления
# компонента guard считает Telegram сломанным и лечит его по кругу.
TG_UNITS=('tg-ws-proxy.service' 'app-tg\x2dws\x2dproxy@autostart.service')
tg_unit() {
    local u
    for u in "${TG_UNITS[@]}"; do
        systemctl --user cat "$u" >/dev/null 2>&1 && { printf '%s' "$u"; return 0; }
    done
    printf '%s' "${TG_UNITS[1]}"
}

COOLDOWN=900        # ручное вмешательство в путь не чаще раза в 15 минут
MAX_BACKOFF=3600    # потолок паузы после серии неудач
TUN_WAIT=25         # сколько ждать интерфейс после запуска
# Живой перебор стратегий длится 5:46–7:21 (28 кандидатов × 2 сервиса), поэтому
# 600 с не хватало: guard решал, что «перебор не завершился», и лез в путь руками.
RESCAN_WAIT=1200    # сколько ждать, пока autotune переберёт стратегии
# Сколько ждать чужой flock в --autostart. Прогон guard может занять до
# RESCAN_WAIT (20 мин перебора), поэтому 120 с не хватало: автозапуск молча
# выходил, и VPN после входа не поднимался вовсе. Ждём с повторами, суммарно
# чуть больше RESCAN_WAIT; таймаут юнита (install.sh) выставлен под это же.
AUTOSTART_LOCK_WAIT=1260
# `omavpn heal` перебирает все ноды профиля (14 шт., до ~400 с); при 240 с его
# убивали на середине, троттл не записывался и следующий тик начинал заново.
HEAL_TIMEOUT=420
MAX_NODES=5         # сколько нод перебрать за один прогон
CURL_T=8            # таймаут одной HTTP-проверки, с (в --status урезается)
ROUTE_T=20          # таймаут `omavpn --json route list`, с (в --status урезается)
# YouTube: «обход формально жив, а видео не идёт» — самая частая поломка
# (стратегия числовая, страница отдаётся, CDN молчит). Пробу и перевод группы
# делает omavpn (`youtube check` / `youtube proxy`): вторая копия пробы в bash
# уже расходилась с первой — guard считал живым то, что аудит называл мёртвым.
# Бюджет пробы считается явно: три запроса по 6 с (YOUTUBE_PROBE_TIMEOUT в
# omavpn) + до 4 с запаса на каждый (TLS, редиректы, чтение тела) = 30 с, плюс
# старт python и systemctl. 45 с было впритык: timeout убивал проверку на
# середине, и проба вечно отвечала unknown.
YT_T=75             # таймаут `omavpn --json youtube check`, с (3×(6+4) + запас)
YT_CONFIRM_GAP=10   # пауза между двумя подтверждающими пробами возврата, с
# Возвраты YouTube — свой лимит: общий (COOLDOWN/switches_last_hour) про лечение
# VPN, и три возврата выедали его целиком.
YT_RETURN_COOLDOWN=900
YT_RETURN_HISTORY="$STATE_DIR/yt-switches"
YT_LAST_RETURN="$STATE_DIR/yt-last-return"
YT_REASON="аудит: обход не пропускает YouTube"
YT_REASON_BACK="аудит: обход снова пропускает YouTube"
# Так причину называла прежняя версия guard'а. Считаем её своей: иначе уже
# стоящий `youtube.com proxy` не расширяется до группы и не снимается возвратом
# (omavpn считает её своей тем же правилом).
YT_REASON_LEGACY="аудит: guard — обход не тянет"
# Разбор одного ответа `youtube check` переиспользуется несколько секунд:
# health_ok_quiet зовётся пачкой, а полная проба — до 75 с.
YT_PROBE_TTL=120

# --- churn tg-ws-proxy -----------------------------------------------------
# Прокси под Telegram живёт неделями и на мёртвом пуле Cloudflare копит
# дескрипторы и сокеты в CLOSE-WAIT: peer соединение закрыл, приложение свой
# конец — нет. Пользовательская проба при этом проходит (трафик уходит в
# H2-fallback), поэтому `broken_services_quiet` деградацию не видит, и раньше
# процесс доходил до сотен fd и тысяч ошибок в час. Метрики — те же, что в
# bin/bypass-status; здесь считаются локально, чтобы не звать статус (он тянет
# живые пробы и стоит секунды).
TG_CONF="$HOME_DIR/.config/TgWsProxy/config.json"
TG_LOG="$(dirname "$TG_CONF")/proxy.log"
TG_CHURN_FD=300              # дескрипторов у процесса
TG_CHURN_CLOSE_WAIT=40       # сокетов в CLOSE-WAIT (утечка)
TG_CHURN_SYN_SENT=20         # соединений в SYN-SENT (ретраи на мёртвые узлы)
TG_CHURN_ERRORS=20           # строк с «failed» в минуту
TG_CHURN_WINDOW=300          # окно подсчёта ошибок, с
TG_CHURN_TAIL=1048576        # читаем хвост лога (1 МиБ; файл ротируется на 5 МБ)
TG_CHURN_COOLDOWN=1800       # базовый интервал между перезапусками, с
TG_CHURN_BACKOFF_MAX=21600   # потолок паузы: 6 ч (1800 → 3600 → 7200 → 14400 → 21600)
TG_CHURN_MAX_HOUR=3          # больше трёх перезапусков в час не делаем
TG_CHURN_CF_WAIT=21600       # после выключения cfproxy не трогаем флаг 6 ч
TG_CHURN_LAST="$STATE_DIR/tg-churn-last"        # когда перезапускали последний раз
TG_CHURN_HISTORY="$STATE_DIR/tg-churn-history"  # метки всех перезапусков (для лимита в час)
TG_CHURN_STREAK="$STATE_DIR/tg-churn-streak"    # перезапусков подряд без возврата в норму
TG_CHURN_CF="$STATE_DIR/tg-churn-cfoff"         # до какого времени cfproxy не трогаем
# 1 — tg-ws-proxy уже перезапускался в этом прогоне. Второй перезапуск ничего
# не добавит, а Telegram не успеет переподключиться: churn-шаг и лечение
# Telegram не должны дублировать друг друга.
TG_RESTARTED=0

# 1 — VPN трогать нельзя (нет cap_net_admin / нет sing-box в tun-режиме).
# Ставится в cmd_check. При этом guard НЕ выходит: Telegram чинится локальным
# прокси, перебор стратегий zapret идёт как обычно — раньше `return 1` до всей
# логики означал, что в такой машине не лечилось вообще ничего.
VPN_BLOCKED=0

YT_DOMAINS="youtube.com
youtu.be
ytimg.com
ggpht.com
googlevideo.com
youtube-nocookie.com
youtubekids.com
youtubegaming.com
youtubeeducation.com
youtubemusic.com
ytstatic.com
youtube.googleapis.com
youtubei.googleapis.com"

mkdir -p -m 700 "$STATE_DIR" 2>/dev/null || { echo "omavpn-guard: нет каталога состояния" >&2; exit 1; }
chmod 700 "$STATE_DIR" 2>/dev/null || true
umask 077

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || return 0
    local n
    n=$(wc -l <"$LOG" 2>/dev/null || echo 0)
    if [ "${n:-0}" -gt 800 ]; then
        tail -n 400 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
    fi
}

# Уведомление пользователю. Одинаковый текст — не чаще раза в час.
notify() {
    local msg="$1" last_file="$STATE_DIR/last_notify" last_msg last_ts
    last_msg=$(head -1 "$last_file" 2>/dev/null)
    last_ts=$(sed -n '2p' "$last_file" 2>/dev/null || echo 0)
    if [ "$msg" = "$last_msg" ] && [ $(( $(now) - ${last_ts:-0} )) -lt 3600 ]; then
        return 0
    fi
    printf '%s\n%s\n' "$msg" "$(now)" >"$last_file" 2>/dev/null
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Обходы" -u normal "Обходы" "$msg" >/dev/null 2>&1
}

now() { date +%s; }

# Внутренний дедлайн прогона: юнит разрешает 4200 с (install.sh), но лучше
# закончить самим и записать состояние (бэкофф/лог), чем быть убитым systemd на
# середине лечения. Долгие циклы (перебор нод, ожидание rescan) сверяются с ним.
GUARD_START=$(now)
GUARD_DEADLINE=${GUARD_DEADLINE:-3900}
# Переменную можно задать снаружи (тесты), но мусор («10m», пусто) не должен
# превращать сравнение в ошибку арифметики: только цифры, иначе умолчание.
case "${GUARD_DEADLINE:-}" in
    ""|*[!0-9]*) GUARD_DEADLINE=3900 ;;
esac
guard_expired() { [ $(( $(now) - GUARD_START )) -ge "$GUARD_DEADLINE" ]; }

# --- состояние -------------------------------------------------------------

tun_up() { ip link show omavpn0 >/dev/null 2>&1; }

runtime_field() {
    [ -f "$VPN_STATE" ] || { echo ""; return; }
    jq -r ".$1 // empty" "$VPN_STATE" 2>/dev/null
}

# Режим VPN: tun (по умолчанию) или proxy. Читаем state.json, а до первого
# запуска — настройки omavpn: в proxy TUN не поднимается вообще, и всё, что
# считает «VPN = omavpn0», в этом режиме врёт.
vpn_mode() {
    local m
    m=$(runtime_field mode)
    [ -n "$m" ] || m=$(jq -r '.mode // empty' "$VPN_SETTINGS" 2>/dev/null)
    case "$m" in
        proxy) echo proxy ;;
        *)     echo tun ;;
    esac
}

# Живой ли ИМЕННО туннельный xray. `pgrep -x xray` ловит и временный Xray из
# `omavpn probe`, и чужой ручной запуск: тогда связка «TUN есть + чужой xray
# жив» считалась консистентной, а настоящий туннельный xray мог быть мёртв.
# Сверяем PID из xray.pid (его пишет сам omavpn при запуске): процесс есть и в
# его командной строке есть "xray".
xray_up() {
    local pid
    # Нет файла — нет и туннельного xray; без этой проверки `<file` печатает
    # ошибку оболочки в journal (guard работает под systemd).
    [ -r "$XRAY_PID_FILE" ] || return 1
    pid=$(tr -d '[:space:]' <"$XRAY_PID_FILE" 2>/dev/null)
    case "${pid:-}" in ''|*[!0-9]*) return 1 ;; esac
    [ -d "/proc/$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'xray'
}

# Свежая запись «sing-box не нашёл default interface» = туннель собран без
# outbound. Это защита от гонки после сна: интерфейс есть, правила TUN стоят, а
# трафик не идёт. Старые записи из истории (mtime лога старше 5 минут) не
# считаем — иначе одна авария ломала бы статус навсегда.
tun_route_lost() {
    local mtime
    [ -f "$SINGBOX_LOG" ] || return 1
    mtime=$(stat -c %Y "$SINGBOX_LOG" 2>/dev/null) || return 1
    [ $(( $(now) - mtime )) -le 300 ] || return 1
    tail -n 50 "$SINGBOX_LOG" 2>/dev/null | grep -q 'missing default interface'
}

VPNTRAFFIC_TS=0
VPNTRAFFIC_OK=0

# Реальный выход через туннель: сам по себе поднятый omavpn0 ничего не
# доказывает. 17.11.2026 sing-box после сна не нашёл default interface —
# интерфейс был, весь трафик висел, а guard считал VPN живым и лечил YouTube
# вместо VPN. В режиме tun проба идёт обычным запросом (без SOCKS), как у
# пользователя, — через sing-box. В proxy-режиме TUN нет, мерить можно только
# SOCKS. На «YouTube/Discord идут мимо VPN» это не влияет: проверяется выход
# целиком (xray + нода + sing-box), а не маршрут конкретного домена.
#
# Один запрос текущим путём (TUN либо SOCKS) → HTTP-код (000 — не ответил).
vpn_http_probe() {
    if [ "$(vpn_mode)" = "proxy" ]; then
        curl -4 -s -o /dev/null -w '%{http_code}' --max-time "$VPN_PROBE_T" \
            --socks5-hostname "127.0.0.1:$VPN_SOCKS_PORT" "$VPN_PROBE_URL" 2>/dev/null
    else
        curl -4 --noproxy '*' -s -o /dev/null -w '%{http_code}' \
            --max-time "$VPN_PROBE_T" "$VPN_PROBE_URL" 2>/dev/null
    fi
}

vpn_traffic_ok() {
    local ts code i=0
    ts=$(now)
    # TTL-кэш: vpn_alive зовётся и в wait_vpn (цикл по секунде), и из svc_*;
    # без кэша один прогон стоил бы десятки секунд.
    if [ "${VPNTRAFFIC_TS:-0}" -gt 0 ] \
        && [ $(( ts - VPNTRAFFIC_TS )) -lt "$VPN_PROBE_TTL" ]; then
        [ "$VPNTRAFFIC_OK" = 1 ]
        return
    fi
    # Две попытки: одиночный обрыв не должен выглядеть мёртвым VPN.
    while [ "$i" -lt 2 ]; do
        i=$((i + 1))
        code=$(vpn_http_probe)
        case "${code:-000}" in
            2??) break ;;
            *)   [ "$i" -lt 2 ] && sleep 1 ;;
        esac
    done
    VPNTRAFFIC_TS=$ts
    case "${code:-000}" in
        2??) VPNTRAFFIC_OK=1 ;;
        *)   VPNTRAFFIC_OK=0 ;;
    esac
    [ "$VPNTRAFFIC_OK" = 1 ]
}

# Сброс кэша: после подъёма/перезапуска VPN старый «мёртв» не должен мешать.
vpn_traffic_reset() {
    VPNTRAFFIC_TS=0
    VPNTRAFFIC_OK=0
}

# Жив ли VPN. В режиме tun признак — интерфейс omavpn0 И реальный трафик:
# флаг running в state.json ставится при запуске и сам не снимается, а пустой
# TUN без outbound раньше выглядел полностью здоровым. В режиме proxy TUN нет
# по определению: там живой VPN — это записанный running=true и живой процесс
# xray. Раньше живость проверялась только по `ip link show omavpn0`, и guard
# каждые 10 минут зря делал `omavpn on` (off+on — реальный обрыв) и слал
# «туннель не поднялся».
vpn_alive() {
    if tun_up; then
        tun_route_lost && return 1
        vpn_traffic_ok && return 0
        return 1
    fi
    [ "$(vpn_mode)" = "proxy" ] || return 1
    [ "$(runtime_field running)" = "true" ] || return 1
    xray_up
}

wait_vpn() {
    local i
    for i in $(seq 1 "$TUN_WAIT"); do
        vpn_alive && return 0
        sleep 1
    done
    return 1
}

# intent: включён ли VPN по воле пользователя.
# omavpn пишет running=false и при ошибке запуска, и в переходные моменты,
# поэтому живой VPN = «включён», а непустой last_error = «упало, не выключали».
intent_read() {
    local err prev
    if [ ! -f "$VPN_STATE" ]; then
        cat "$INTENT_FILE" 2>/dev/null || echo on
        return
    fi
    err=$(runtime_field last_error)
    prev=$(cat "$INTENT_FILE" 2>/dev/null || echo "on")

    if vpn_alive; then
        echo on
        return
    fi
    # Процесс умер, но VPN не выключали: `running=true` остаётся только после
    # `omavpn on`, а намеренный `off` пишет `running=false`. Без этой проверки
    # в режиме proxy падение xray выглядело бы как «пользователь выключил VPN».
    if [ "$(runtime_field running)" = "true" ]; then
        echo "$prev"
        return
    fi
    if [ -n "$err" ]; then
        echo "$prev"
        return
    fi
    echo off
}

intent_update() {
    local want
    want=$(intent_read)
    printf '%s\n' "$want" >"$INTENT_FILE" 2>/dev/null
    echo "$want"
}

# Состояние прав sing-box: ok | nobin (нет бинаря) | nocaps (нет cap_net_admin).
# Разные причины — разные сообщения: «нет бинаря» лечится переустановкой, а не
# setcap, и раньше оба случая валили guard целиком.
caps_state() {
    [ -x "$SB_BIN" ] || { echo nobin; return; }
    # без getcap (нет libcap) не можем судить — не блокируем работу
    command -v getcap >/dev/null 2>&1 || { echo ok; return; }
    if getcap "$SB_BIN" 2>/dev/null | grep -q cap_net_admin; then
        echo ok
    else
        echo nocaps
    fi
}

caps_ok() { [ "$(caps_state)" = "ok" ]; }

# Нужен ли TUN для текущего режима. В proxy sing-box не запускается вовсе,
# поэтому отсутствие caps там не поломка: раньше guard из-за него не лечил даже
# Telegram (прокси caps не нужны).
tun_needed() { [ "$(vpn_mode)" != "proxy" ]; }

# Установлен ли tg-ws-proxy вообще. Если компонента нет, Telegram не считаем
# сломанным (иначе guard будет зря включать VPN и слать тревоги).
tg_installed() {
    command -v tg-ws-proxy >/dev/null 2>&1 && return 0
    systemctl --user cat "$(tg_unit)" >/dev/null 2>&1
}

# Есть ли домены сервиса в direct-списке (= идут мимо VPN).
service_in_direct() {
    local list="$1" dom
    [ -f "$SINGBOX_CFG" ] || return 1
    while IFS= read -r dom; do
        [ -n "$dom" ] || continue
        if python3 - "$SINGBOX_CFG" "$dom" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    dom = sys.argv[2]
    for rule in d.get("route", {}).get("rules", []):
        if rule.get("outbound") != "direct":
            continue
        doms = rule.get("domain_suffix") or rule.get("domain") or []
        if dom in doms:
            sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(2)
PY
        then
            return 0
        fi
    done <<<"$list"
    return 1
}

json_field() { # $1 JSON, $2 имя поля -> значение или пусто
    # has(), а не `// empty`: `//` считает false отсутствующим значением, и
    # changed=false неотличим от «поля нет».
    printf '%s' "$1" | jq -r --arg f "$2" \
        'if type == "object" and has($f) then (.[$f] | tostring) else empty end' 2>/dev/null
}

json_actions() { # $1 JSON -> действия одной строкой
    printf '%s' "$1" | jq -r '((.actions // []) | join("; "))' 2>/dev/null
}

# Путь домена по правилам omavpn: `route list` проходит их в том же порядке, что
# и sing-box (override/always-proxy → direct-правило → final=proxy), поэтому
# ответ совпадает с конфигом. Правка direct_domains.txt тут ничего не решает:
# видео YouTube подмешивается встроенным BUILTIN_DIRECT_DOMAINS, стоит в
# direct-правиле ПЕРЕД файлом, и раньше guard «переводил YouTube на VPN»
# правкой файла, которая ни на что не влияла.
route_path_of() { # $1 домен -> direct|proxy|"" (спросить не удалось)
    local out
    out=$(timeout "$ROUTE_T" "$OMAVPN" --json route list 2>/dev/null) || return 0
    printf '%s' "$out" | jq -r --arg d "$1" \
        'first(.routes[]? | select(.domain == $d) | .path) // empty' 2>/dev/null || true
}

path_now() {
    local p
    p=$(route_path_of youtube.com)
    [ -n "$p" ] && { echo "$p"; return; }
    # omavpn не ответил — грубая оценка по собранному конфигу sing-box
    if service_in_direct "$YT_DOMAINS"; then echo "direct"; return; fi
    [ -f "$SINGBOX_CFG" ] && echo "vpn" || echo unknown
}

# --- сеть и autotune -------------------------------------------------------

current_ssid() {
    nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1 | sed 's/\\:/:/g'
}

# Логика ключа сети повторяет netkey() из zapret-autotune один в один,
# иначе на кабеле и на нестандартных сетях решение autotune не читается.
wan_iface() {
    ip -o route show default 2>/dev/null | awk '{
        d="";
        for (i=1;i<=NF;i++) if ($i=="dev") d=$(i+1);
        if (d!="" && d!="omavpn0" && d!="tailscale0" && d !~ /^tun/) { print d; exit }
    }'
}

net_key() {
    local iface ssid gw mac key
    iface=$(wan_iface)
    [ -n "$iface" ] || iface="unknown"
    ssid=""
    case "$iface" in
        wl*|wlan*|wlp*) ssid=$(iwgetid -r "$iface" 2>/dev/null || true) ;;
    esac
    [ -n "$ssid" ] || ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$iface" 2>/dev/null | cut -d: -f2-)
    if [ -n "$ssid" ] && [ "$iface" != "unknown" ]; then
        key="wifi-$ssid"
    else
        gw=$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')
        mac=$(ip neigh show "$gw" 2>/dev/null | awk '/lladdr/{print $5; exit}')
        key="net-$iface-${mac:-$gw}"
    fi
    printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_'
}

autotune_mode() {
    local key f v
    key=$(net_key)
    [ -n "$key" ] || { echo unknown; return; }
    f="$AUTOTUNE_DIR/$key.strategy"
    if [ -r "$f" ]; then
        v=$(head -c 32 "$f" 2>/dev/null | tr -d '[:space:]')
        [ -n "$v" ] && { echo "$v"; return; }
    fi
    echo unknown
}

autotune_lastscan() {
    local key f v
    key=$(net_key)
    [ -n "$key" ] || { echo 0; return; }
    f="$AUTOTUNE_DIR/$key.lastscan"
    # Пустой файл (autotune ещё не писал отметку) давал пустую строку, и
    # сравнение «изменился ли lastscan» срабатывало как «перебор завершился».
    v=$(cat "$f" 2>/dev/null | tr -d '[:space:]')
    echo "${v:-0}"
}

zapret_active() { systemctl is-active --quiet zapret.service 2>/dev/null; }

# Идёт ли перебор стратегий прямо сейчас (автотюн ходит под своим flock).
autotune_running() { systemctl is-active --quiet zapret-autotune.service 2>/dev/null; }

# Перебор идёт или только что закончился. Во время перебора zapret
# перезапускается каждые ~20 секунд, и проверки guard видят «всё сломано»:
# так он набирал ложные неудачи и уходил в паузу на 30 минут сразу после
# удачного подбора. Пока идёт подбор (или прошло меньше 30 секунд после
# последней пробы), проверку пропускаем, счётчик неудач не трогаем.
autotune_testing() {
    autotune_running && return 0
    local probe="$AUTOTUNE_DIR/probe.json" ts
    [ -f "$probe" ] || return 1
    ts=$(stat -c %Y "$probe" 2>/dev/null || echo 0)
    [ $(( $(now) - ts )) -le 30 ]
}

request_rescan() {
    # Свой перебор уже идёт — второй запрос только сбил бы его и добавил
    # guard'у ложное «перебор не начался».
    if autotune_running; then
        log "autotune уже перебирает стратегии — жду его результат"
        return 0
    fi
    mkdir -p "$(dirname "$RESCAN_REQUEST")" 2>/dev/null
    rm -f "$RESCAN_REQUEST" 2>/dev/null
    printf '%s\n' "$(now)" >"$RESCAN_REQUEST" 2>/dev/null || return 1
    log "запросил перебор стратегий zapret"
    return 0
}

wait_rescan_result() {
    local before deadline retried=0
    before=$(autotune_lastscan)
    deadline=$(( $(now) + RESCAN_WAIT ))
    while [ "$(now)" -lt "$deadline" ]; do
        # Причина выхода важна для лога: «не завершился за 20 мин» при выходе по
        # внутреннему дедлайну (например, после 5 минут) — прямая ложь.
        if guard_expired; then
            log "внутренний дедлайн прогона ($GUARD_DEADLINE с) — перебор не дождался, выхожу"
            return 1
        fi
        sleep 20
        if [ "$(autotune_lastscan)" != "$before" ] && [ "$(autotune_lastscan)" != "0" ]; then
            log "autotune закончил перебор (режим $(autotune_mode))"
            sleep 3
            health_ok_quiet && return 0
            return 1
        fi
        if [ "$retried" = "0" ] && [ "$(now)" -gt $(( deadline - RESCAN_WAIT + 90 )) ]; then
            retried=1
            log "перебор не начался — повторяю запрос"
            request_rescan >/dev/null 2>&1
        fi
    done
    log "перебор не завершился за $((RESCAN_WAIT / 60)) мин"
    return 1
}

# --- проверки сервисов -----------------------------------------------------
# Каждая проверка пробуется дважды: одиночный обрыв curl не должен выглядеть
# сломанным сервисом — после него guard 10 минут перебирает стратегии и включает
# VPN, который человек только что выключил.

http_code() { # $1 url -> HTTP-код (000 — не ответил)
    local code="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        code=$(curl -4 -s -o /dev/null -w '%{http_code}' --max-time "$CURL_T" "$1" 2>/dev/null)
        [ -n "$code" ] && [ "$code" != "000" ] && break
        [ "$i" -lt "$tries" ] && sleep 1
    done
    printf '%s' "${code:-000}"
}

http_body() { # $1 url, $2 лимит байт; 1 — тело не пришло
    local body="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        # -L: YouTube отвечает 302 на региональные/согласительные редиректы,
        # без перехода по ним тело пустое и страница «не открывается».
        body=$(curl -4 -s -L --max-time "$CURL_T" "$1" 2>/dev/null | head -c "${2:-150000}")
        [ -n "$body" ] && { printf '%s' "$body"; return 0; }
        [ "$i" -lt "$tries" ] && sleep 1
    done
    return 1
}

http_meta() { # $1 url -> "код content-type размер"
    local out="" i=0 tries=${HTTP_TRIES:-2}
    while [ "$i" -lt "$tries" ]; do
        i=$((i + 1))
        # -L: favicon YouTube отдаёт 302 на CDN; без перехода код был бы 302 и
        # проверка «картинка отдаётся картинкой» ложно проваливалась.
        out=$(curl -4 -s -L -o /dev/null -w '%{http_code} %{content_type} %{size_download}' \
            --max-time "$CURL_T" "$1" 2>/dev/null)
        case "${out%% *}" in 2??|3??) break ;; esac
        [ "$i" -lt "$tries" ] && sleep 1
    done
    printf '%s' "$out"
}

svc_youtube_ok() {
    local code ctype size body img rest
    code=$(http_code https://www.youtube.com/)
    { [ "$code" = "200" ] || [ "$code" = "302" ]; } || return 1
    body=$(http_body https://www.youtube.com/) || return 1
    grep -qiE 'ytimg|youtube' <<<"$body" || return 1
    # CDN превью — generate_204 на самом i.ytimg.com. Раньше здесь стоял жёсткий
    # id видео (dQw4w9WgXcQ/hqdefault.jpg): если видео удалят, guard считал бы
    # YouTube сломанным по кругу и лечил несуществующую поломку. generate_204
    # от конкретного видео не зависит и проверяет то же самое: DNS + TLS + ответ CDN.
    code=$(http_code https://i.ytimg.com/generate_204)
    { [ "$code" = "204" ] || [ "$code" = "200" ]; } || return 1
    # ...и что картинки реально отдаются картинками (favicon — вечный image/*).
    img=$(http_meta https://www.youtube.com/favicon.ico)
    code=${img%% *}
    rest=${img#* }
    ctype=${rest%% *}
    size=${rest##* }
    [ "$code" = "200" ] && [ "${size:-0}" -gt 500 ] 2>/dev/null && [[ "${ctype:-}" == image/* ]] || return 1
    code=$(http_code https://redirector.googlevideo.com/generate_204)
    { [ "$code" = "204" ] || [ "$code" = "200" ]; } || return 1
    # Служебный API YouTube (youtubei.googleapis.com) блокируют наглухо: страница
    # и картинки открываются, а плеер висит по 10 с на каждом запросе. Успех —
    # любой HTTP-ответ (TLS-соединение и ответ состоялись): 405/400 норма,
    # 000 — таймаут/обрыв. Домен всегда идёт через VPN (ALWAYS_PROXY_DOMAINS),
    # поэтому проверять его напрямую бессмысленно: при выключенном VPN и в
    # режиме «proxy» (без TUN) он недоступен по определению — и guard каждые
    # 10 минут «лечил» бы несуществующую поломку (rescan zapret + включение VPN).
    vpn_alive || return 0
    code=$(http_code https://youtubei.googleapis.com/youtubei/v1/player)
    [ -n "$code" ] && [ "$code" != "000" ]
}

svc_discord_ok() {
    [ "$(http_code https://discord.com/api/v9/gateway)" = "200" ] || return 1
    [ "$(http_code https://discord.com/)" = "200" ]
}

svc_telegram_ok() {
    local code unit
    unit=$(tg_unit)
    # Юнит активен — норма. Если прокси жив, но запущен вне systemd (старое
    # поведение обновлятора), сервис всё равно работает: не считаем это
    # поломкой, иначе guard лечит Telegram по кругу.
    if ! systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        pgrep -x tg-ws-proxy >/dev/null 2>&1 || return 1
    fi
    code=$(http_code https://api.telegram.org/)
    [ "$code" = "200" ] || [ "$code" = "302" ] || return 1
    [ "$(http_code https://web.telegram.org/)" = "200" ]
}

# Список сломанных сервисов через пробел.
broken_services_quiet() {
    local broken=""
    svc_youtube_ok || broken="$broken youtube"
    svc_discord_ok || broken="$broken discord"
    if tg_installed; then
        svc_telegram_ok || broken="$broken telegram"
    fi
    echo "${broken# }"
}

health_ok_quiet() {
    [ -z "$(broken_services_quiet)" ] || return 1
    # Пробы выше меряют ТЕКУЩИЙ путь: пока страница открывается через proxy, они
    # говорят «всё работает», хотя видео-домены сидят на мёртвом direct и группа
    # в VPN не переведена. Поэтому YouTube проверяется ещё и по прямому пути.
    yt_path_ok_quiet
}

# --- VPN -------------------------------------------------------------------

vpn_up() {
    vpn_alive && return 0
    timeout 90 "$OMAVPN" on >/dev/null 2>&1
    vpn_traffic_reset
    wait_vpn
}

vpn_restart() {
    timeout 90 "$OMAVPN" restart >/dev/null 2>&1
    vpn_traffic_reset
    wait_vpn || vpn_up
}

vpn_consistent() {
    vpn_alive || return 0
    xray_up
}

# Статус omavpn — один раз на прогон. `omavpn --json status` прогоняет все
# проверки сервисов и складывает их результаты в probe.results (десятки КБ), а
# try_nodes запрашивал его дважды подряд: два тяжёлых прогона на тик и два разных
# снимка (orig из одного, node_count из другого). Кэш — в переменной, поэтому
# функция обязана вызываться в текущей оболочке, а не в $(…).
VPN_STATUS_JSON=""
VPN_STATUS_LOADED=0
vpn_status_load() {
    [ "$VPN_STATUS_LOADED" = 1 ] && return 0
    VPN_STATUS_JSON=$(timeout 20 "$OMAVPN" --json status 2>/dev/null)
    VPN_STATUS_LOADED=1
    return 0
}

# Восстановление исходного выбора после перебора нод. Живёт отдельно от
# try_nodes, потому что вызывается ещё и из trap: прогон могут убить по TERM
# (таймаут юнита, reset) посреди теста ноды — и тогда в настройках останется
# случайная нода, с которой guard продолжил бы работу.
TRY_NODES_ORIG=""
TRY_NODES_ACTIVE=0

restore_node() { # $1 — индекс (>=0) или -1 (авто)
    local idx="$1"
    case "${idx:-}" in ''|*[!0-9-]*) return 0 ;; esac
    if [ "$idx" = "-1" ]; then
        log "возвращаю авто-выбор сервера"
    else
        log "возвращаю прежнюю ноду $idx"
    fi
    timeout 90 "$OMAVPN" node "$idx" >/dev/null 2>&1
    wait_vpn >/dev/null 2>&1 || vpn_up >/dev/null 2>&1
}

try_nodes_guard_exit() {
    [ "$TRY_NODES_ACTIVE" = 1 ] || return 0
    TRY_NODES_ACTIVE=0
    local orig="$TRY_NODES_ORIG"
    TRY_NODES_ORIG=""
    log "перебор нод прерван — восстанавливаю исходный выбор ($orig)"
    restore_node "$orig"
}
# По сигналу восстанавливаем выбор и выходим: без exit обработчик вернул бы
# управление в середину перебора, и следующая же итерация снова сменила бы ноду
# (уже после восстановления). EXIT-ловушка нужна для штатного выхода и для
# `omavpn reset`/таймаута юнита (SIGTERM).
trap 'try_nodes_guard_exit; exit 143' TERM
trap 'try_nodes_guard_exit; exit 130' INT
trap 'try_nodes_guard_exit; exit 129' HUP
trap 'try_nodes_guard_exit' EXIT

try_nodes() {
    local orig node_count node tries=0 switched=0
    vpn_status_load
    orig=$(printf '%s' "$VPN_STATUS_JSON" | jq -r '.node_index // -1' 2>/dev/null)
    node_count=$(printf '%s' "$VPN_STATUS_JSON" | jq -r '.nodes | length' 2>/dev/null)
    [ -n "$orig" ] || orig=-1
    [ -n "$node_count" ] || node_count=0
    [ "$node_count" -gt 0 ] || return 1
    # Одна нода: перебирать нечего, а `omavpn node 0` всё равно перезапустил бы
    # туннель (choose() при включённом VPN делает on) — то есть лишний обрыв.
    if [ "$node_count" -le 1 ]; then
        log "в профиле одна нода — альтернатив для перебора нет"
        return 1
    fi

    TRY_NODES_ORIG="$orig"
    TRY_NODES_ACTIVE=1
    for node in $(seq 0 $(( node_count - 1 ))); do
        [ "$node" = "$orig" ] && continue
        # Дедлайн проверяем ДО инкремента: иначе истёкший бюджет на первой же
        # итерации всё равно приводил к «попытке» и лишнему восстановлению ноды
        # (то есть к перезапуску туннеля, которого уже не на что тратить).
        if guard_expired; then
            log "внутренний дедлайн прогона — прекращаю перебор нод"
            break
        fi
        [ "$tries" -ge "$MAX_NODES" ] && break
        tries=$((tries + 1))
        log "пробую ноду $node"
        timeout 90 "$OMAVPN" node "$node" >/dev/null 2>&1
        switched=1
        wait_vpn || vpn_up
        if health_ok_quiet; then
            # Успех: выбранная нода и должна остаться — прежнюю не возвращаем.
            TRY_NODES_ACTIVE=0
            TRY_NODES_ORIG=""
            log "помогла нода $node"
            return 0
        fi
    done
    TRY_NODES_ACTIVE=0
    TRY_NODES_ORIG=""          # восстановление уже сделано/не нужно — trap не должен повторять
    # Восстанавливаем только если нода реально менялась: при истёкшем дедлайне
    # (или MAX_NODES=0) перебора не было, и `omavpn node` — лишний обрыв.
    [ "$switched" = 1 ] || return 1
    restore_node "$orig"
    return 1
}

# --- крайняя мера: ручная смена пути ---------------------------------------

switches_last_hour() {
    local cutoff cnt ts
    cutoff=$(( $(now) - 3600 ))
    cnt=0
    [ -f "$SWITCH_HISTORY" ] || { echo 0; return; }
    while read -r ts; do
        [ -n "$ts" ] || continue
        [ "$ts" -ge "$cutoff" ] 2>/dev/null && cnt=$((cnt + 1))
    done <"$SWITCH_HISTORY"
    echo "$cnt"
}

note_switch() {
    date +%s >>"$SWITCH_HISTORY" 2>/dev/null
    tail -n 20 "$SWITCH_HISTORY" >"$SWITCH_HISTORY.tmp" 2>/dev/null && mv "$SWITCH_HISTORY.tmp" "$SWITCH_HISTORY" 2>/dev/null
    # метка последней ручной смены пути: раньше её ставил только set_path, и
    # после перехода на `omavpn route set` кулдаун COOLDOWN перестал работать
    date +%s >"$LAST_SWITCH" 2>/dev/null
}

can_switch() {
    [ -f "$LAST_SWITCH" ] || return 0
    local last
    last=$(cat "$LAST_SWITCH" 2>/dev/null)
    last=${last:-0}
    case "$last" in *[!0-9]*|"") last=0 ;; esac
    [ $(( $(now) - last )) -ge "$COOLDOWN" ]
}

direct_file_settled() {
    [ -f "$DIRECT_FILE" ] || return 0
    local age
    age=$(( $(now) - $(stat -c %Y "$DIRECT_FILE" 2>/dev/null || echo 0) ))
    [ "$age" -ge 60 ]
}

# route_force <домен> <proxy|direct> <причина>
# Крайняя мера — оверрайд маршрута через сам omavpn, а не правка
# direct_domains.txt: видео YouTube подмешивается встроенным
# BUILTIN_DIRECT_DOMAINS, который стоит в direct-правиле ПЕРЕД файлом, поэтому
# правка файла ни на что не влияла и `path_now` продолжал говорить «direct».
# Оверрайд proxy ставится в правило proxy — оно первое, и его ничего не перебивает.
# Возврат: 0 — путь изменён, 2 — уже такой, 1 — ошибка.
route_force() {
    local dom="$1" path="$2" reason="$3" out rc changed
    out=$(timeout 60 "$OMAVPN" --json route set "$dom" "$path" \
        --reason "$reason" --no-restart 2>/dev/null)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "route set $dom $path: ошибка (код $rc)"
        return 1
    fi
    changed=$(json_field "$out" changed)
    case "$changed" in
        true)  return 0 ;;
        false) return 2 ;;
        *)     log "route set $dom $path: непонятный ответ omavpn"
               return 1 ;;
    esac
}

# --- YouTube: проба обхода и группа доменов ---------------------------------
# «Обход не пропускает YouTube» — единственное основание уводить группу доменов
# в туннель. Признак берётся не из факта «страница не открылась»: при живом
# обходе и мёртвой ноде виноват туннель, и уводить в него видео — вредить.
# Проверку делает omavpn: там же живут BUILTIN_DIRECT_DOMAINS, поэтому список
# группы не дублируется (дубль уже расходился: оверрайд одного youtube.com
# оставлял googlevideo/ytimg в мёртвом обходе).

yt_probe() { # JSON `omavpn --json youtube check` ("" — спросить не удалось)
    timeout "$YT_T" "$OMAVPN" --json youtube check 2>/dev/null
}

# Последний разбор `youtube check`: глобалы, а не echo. Одному ответу нужно три
# факта (состояние прямого пути, сколько доменов группы ещё не в VPN, причина), и
# три отдельных прогона по 75 с недопустимы.
YT_PROBE_JSON=""
YT_PROBE_STATE="unknown"
YT_PROBE_GROUP_DIRECT=0
YT_PROBE_REASON=""
YT_PROBE_AT=0

yt_probe_reset() { # забыть разбор: состояние маршрутов изменилось
    YT_PROBE_JSON=""
    YT_PROBE_STATE="unknown"
    YT_PROBE_GROUP_DIRECT=0
    YT_PROBE_REASON=""
    YT_PROBE_AT=0
}

# 0 — ответ получен и разобран, 1 — спросить не удалось.
yt_probe_run() {
    local now_t direct probed strategy n
    now_t=$(now)
    if [ -n "$YT_PROBE_JSON" ] && [ $(( now_t - YT_PROBE_AT )) -lt "$YT_PROBE_TTL" ]; then
        return 0
    fi
    YT_PROBE_JSON=$(yt_probe)
    YT_PROBE_STATE=unknown
    YT_PROBE_GROUP_DIRECT=0
    YT_PROBE_REASON=""
    YT_PROBE_AT=$now_t
    [ -n "$YT_PROBE_JSON" ] || return 1
    direct=$(json_field "$YT_PROBE_JSON" direct_ok)
    probed=$(json_field "$YT_PROBE_JSON" probed)
    strategy=$(json_field "$YT_PROBE_JSON" strategy_ok)
    case "$direct:$probed:$strategy" in
        true:true:*)  YT_PROBE_STATE=ok ;;
        false:true:*) YT_PROBE_STATE=bad ;;
    esac
    n=$(printf '%s' "$YT_PROBE_JSON" | jq -r '(.group_direct // []) | length' 2>/dev/null)
    case "$n" in
        ''|*[!0-9]*) n=0 ;;
        *)           YT_PROBE_GROUP_DIRECT=$n ;;
    esac
    YT_PROBE_REASON=$(json_field "$YT_PROBE_JSON" reason)
    return 0
}

# ok — обход проверен и пропускает; bad — проверен и не пропускает;
# unknown — проверить не удалось (обход выключен автотюном, нет интерфейса,
# проба не подтвердила, что шла мимо TUN). Переводить группу можно только на
# bad: на unknown решение было бы догадкой.
yt_direct_state() {
    yt_probe_run >/dev/null 2>&1
    echo "$YT_PROBE_STATE"
}

# 0 — обход проверен и НЕ пропускает YouTube, а группа ещё не вся в VPN.
# Это и есть основание для перевода группы в туннель.
yt_group_needs_vpn() {
    yt_probe_run || return 1
    [ "$YT_PROBE_STATE" = "bad" ] || return 1
    [ "$YT_PROBE_GROUP_DIRECT" -gt 0 ] || return 1
    return 0
}

# YouTube в порядке: группа целиком в VPN (и пробы текущего пути прошли) либо
# обход реально пропускает видео. Отдельно от svc_youtube_ok, который меряет
# только текущий путь: «страница через proxy открылась» не значит, что видео не
# сидит на мёртвом direct.
yt_path_ok_quiet() {
    yt_probe_run || return 0     # не спросили — не выдумываем проблему
    [ "$YT_PROBE_GROUP_DIRECT" -eq 0 ] && return 0
    [ "$YT_PROBE_STATE" = "ok" ]
}

# yt_group_to_vpn — 0 переведено, 2 уже в VPN, 1 ошибка (как route_force)
yt_group_to_vpn() {
    local out rc changed
    out=$(timeout 60 "$OMAVPN" --json youtube proxy --reason "$YT_REASON" --no-restart 2>/dev/null)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "youtube proxy: ошибка (код $rc)"
        return 1
    fi
    changed=$(json_field "$out" changed)
    case "$changed" in
        true)  return 0 ;;
        false) return 2 ;;
        *)     log "youtube proxy: непонятный ответ omavpn"
               return 1 ;;
    esac
}

# yt_group_to_direct — снимает только свои оверрайды (причина с префиксом
# аудита), ручной `route set youtube.com proxy` остаётся человеку.
yt_group_to_direct() {
    local out rc changed
    out=$(timeout 60 "$OMAVPN" --json youtube direct --reason "$YT_REASON_BACK" --no-restart 2>/dev/null)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "youtube direct: ошибка (код $rc)"
        return 1
    fi
    changed=$(json_field "$out" changed)
    case "$changed" in
        true)  return 0 ;;
        false) return 2 ;;
        *)     log "youtube direct: непонятный ответ omavpn"
               return 1 ;;
    esac
}

yt_our_overrides() { # сколько доменов группы уведено в VPN нашим оверрайдом
    local out n
    out=$(timeout "$ROUTE_T" "$OMAVPN" --json route list 2>/dev/null) || { echo 0; return 0; }
    # Legacy-причина — тоже наша: иначе стоящий с прежней версии guard'а
    # `youtube.com proxy` не снимался бы возвратом и не считался своим.
    n=$(printf '%s' "$out" | jq -r --arg p "$YT_REASON" --arg l "$YT_REASON_LEGACY" \
        '[.overrides[]? | select(.path == "proxy" and (((.reason // "") | startswith($p)) or ((.reason // "") | startswith($l))))] | length' \
        2>/dev/null)
    case "$n" in
        ''|*[!0-9]*) echo 0 ;;
        *)           echo "$n" ;;
    esac
}

# Возвраты YouTube считаются отдельно от смен пути VPN: раньше они тратили
# общий бюджет switches_last_hour/can_switch, и три возврата съедали лимит —
# настоящее лечение VPN после этого упиралось в «3+ раза за час» и не
# применялось. Файлы лежат рядом с остальным состоянием guard.
yt_returns_last_hour() {
    local cutoff cnt ts
    cutoff=$(( $(now) - 3600 ))
    cnt=0
    [ -f "$YT_RETURN_HISTORY" ] || { echo 0; return 0; }
    while read -r ts; do
        [ -n "$ts" ] || continue
        [ "$ts" -ge "$cutoff" ] 2>/dev/null && cnt=$((cnt + 1))
    done <"$YT_RETURN_HISTORY"
    echo "$cnt"
}

yt_can_return() {
    [ -f "$YT_LAST_RETURN" ] || return 0
    local last
    last=$(cat "$YT_LAST_RETURN" 2>/dev/null)
    last=${last:-0}
    case "$last" in *[!0-9]*|"") last=0 ;; esac
    [ $(( $(now) - last )) -ge "$YT_RETURN_COOLDOWN" ]
}

note_yt_return() {
    date +%s >>"$YT_RETURN_HISTORY" 2>/dev/null
    tail -n 20 "$YT_RETURN_HISTORY" >"$YT_RETURN_HISTORY.tmp" 2>/dev/null \
        && mv "$YT_RETURN_HISTORY.tmp" "$YT_RETURN_HISTORY" 2>/dev/null
    date +%s >"$YT_LAST_RETURN" 2>/dev/null
}

# Авто-возврат: обход снова тянет — снять свои оверрайды группы. Вызывается из
# cmd_check до лечения: возврат нужен и когда всё в порядке (иначе YouTube
# навсегда остался бы в туннеле после одной плохой сети).
yt_maybe_return() {
    local have state rc

    have=$(yt_our_overrides)
    [ "${have:-0}" -gt 0 ] 2>/dev/null || return 0

    # Свои предохранители: кулдаун возврата и не больше трёх возвратов в час.
    # Общий лимит смен пути (can_switch/switches_last_hour) не расходуем — он
    # про лечение VPN, и возвраты YouTube его выедали.
    if ! yt_can_return; then
        log "возврат YouTube: кулдаун возврата — не трогаю"
        return 0
    fi
    if [ "$(yt_returns_last_hour)" -ge 3 ]; then
        log "возврат YouTube: 3+ возврата за час — не воюю"
        return 0
    fi

    # Две успешные пробы подряд с паузой: одиночная врёт (сеть дёргается, автотюн
    # как раз перебрал стратегию), и откат по одной пробе дал бы новые качели.
    state=$(yt_direct_state)
    case "$state" in
        ok) : ;;
        bad) log "возврат YouTube: обход пока не пропускает — остаётся VPN"
             return 0 ;;
        *)   log "возврат YouTube: прямой путь не проверен ($state) — остаётся VPN"
             return 0 ;;
    esac
    sleep "$YT_CONFIRM_GAP"
    state=$(yt_direct_state)
    if [ "$state" != "ok" ]; then
        log "возврат YouTube: повторная проба не прошла ($state) — остаётся VPN"
        return 0
    fi

    yt_group_to_direct
    rc=$?
    case "$rc" in
        0) note_yt_return
           if vpn_alive; then vpn_restart; fi
           log "YouTube возвращён на обход: снято оверрайдов группы $have" ;;
        1) log "возврат YouTube: omavpn не снял оверрайды" ;;
        *) log "возврат YouTube: своих оверрайдов не нашлось — снимать нечего" ;;
    esac
    return 0
}

# --- лечение ---------------------------------------------------------------

restart_tg() {
    if [ "${TG_RESTARTED:-0}" = 1 ]; then
        # Прокси уже перезапускался в этом прогоне (шаг churn): второй раз не
        # трогаем, только проверяем результат — иначе Telegram получал два
        # обрыва подряд, а второй перезапуск не лечил ничего нового.
        log "tg-ws-proxy уже перезапущен в этом прогоне — повторно не трогаю"
        svc_telegram_ok
        return $?
    fi
    log "перезапускаю tg-ws-proxy"
    TG_RESTARTED=1
    local unit
    unit=$(tg_unit)
    systemctl --user restart "$unit" >/dev/null 2>&1 \
        || systemctl --user enable --now "$unit" >/dev/null 2>&1
    sleep 5
    svc_telegram_ok
}

# Метрики деградации: «fd CLOSE-WAIT SYN-SENT ошибок/мин». Код 1 — прокси не
# запущен, считать нечего. PyInstaller держит два процесса с одним именем
# (загрузчик и рабочий), поэтому fd суммируем по всем, а сокеты ищем по любому
# из PID'ов: у рабочего их десятки, у загрузчика — ни одного.
tgws_churn_state() {
    local pids p fd=0 pattern="" cut line errs=0 socks cw syn
    pids=$(pgrep -x tg-ws-proxy 2>/dev/null | tr '\n' ' ')
    [ -n "${pids// /}" ] || return 1
    for p in $pids; do
        fd=$(( fd + $(ls /proc/"$p"/fd 2>/dev/null | wc -l) ))
        pattern="${pattern}${pattern:+|}pid=${p},"
    done
    # `pid=` в фильтре, а не имя процесса: имя в выводе ss может быть обрезано.
    socks=$(ss -tanp 2>/dev/null | grep -E -- "$pattern" 2>/dev/null)
    cw=$(printf '%s\n' "$socks" | grep -c '^CLOSE-WAIT' 2>/dev/null || true)
    syn=$(printf '%s\n' "$socks" | grep -c '^SYN-SENT' 2>/dev/null || true)
    # Ошибки: «failed» (пул Cloudflare не отвечает) и «no fallback available»
    # (WS-пул пуст, TCP-fallback недоступен — соединение рвётся, а процесс жив).
    # Формат «2026-11-18 11:31:03 WARNING …» фиксированной ширины, поэтому
    # сравнение строк совпадает с хронологией и `date -d` на каждую строку не
    # нужен. Нет лога — ноль, а не ошибка.
    if [ -f "$TG_LOG" ]; then
        cut=$(LC_ALL=C date -d "-$TG_CHURN_WINDOW seconds" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
        if [ -n "$cut" ]; then
            while IFS= read -r line; do
                [ "${#line}" -ge 19 ] || continue
                [[ "${line:0:19}" < "$cut" ]] && continue
                [[ "${line,,}" == *failed* || "${line,,}" == *"no fallback available"* ]] \
                    && errs=$((errs + 1))
            done < <(tail -c "$TG_CHURN_TAIL" "$TG_LOG" 2>/dev/null)
        fi
    fi
    printf '%s %s %s %s\n' "$fd" "${cw:-0}" "${syn:-0}" $(( errs * 60 / TG_CHURN_WINDOW ))
}

# Причины деградации одной строкой; пусто — метрики в норме.
tgws_churn_reasons() { # $1 fd, $2 close_wait, $3 syn_sent, $4 ошибок/мин
    local reasons=""
    [ "${1:-0}" -gt "$TG_CHURN_FD" ] && reasons="$reasons fd=$1>$TG_CHURN_FD"
    [ "${2:-0}" -gt "$TG_CHURN_CLOSE_WAIT" ] && reasons="$reasons close-wait=$2>$TG_CHURN_CLOSE_WAIT"
    [ "${3:-0}" -gt "$TG_CHURN_SYN_SENT" ] && reasons="$reasons syn-sent=$3>$TG_CHURN_SYN_SENT"
    [ "${4:-0}" -gt "$TG_CHURN_ERRORS" ] && reasons="$reasons ошибок=$4/мин>$TG_CHURN_ERRORS"
    printf '%s' "${reasons# }"
}

tgws_churn_streak() {
    local s
    s=$(cat "$TG_CHURN_STREAK" 2>/dev/null || echo 0)
    case "$s" in *[!0-9]*|"") echo 0 ;; *) echo "$s" ;; esac
}

# Пауза перед следующим перезапуском: 1800 с и дальше вдвое, потолок — 6 ч.
# Счётчик растёт, пока метрики не вернутся в норму: одна и та же поломка не
# должна перезапускать прокси каждые полчаса бесконечно.
tgws_churn_wait() { # $1 — сколько перезапусков подряд уже сделано
    local s=${1:-0} shift_by delay
    [ "$s" -gt 0 ] || s=1
    shift_by=$(( s - 1 ))
    [ "$shift_by" -gt 4 ] && shift_by=4
    delay=$(( TG_CHURN_COOLDOWN << shift_by ))
    [ "$delay" -gt "$TG_CHURN_BACKOFF_MAX" ] && delay=$TG_CHURN_BACKOFF_MAX
    echo "$delay"
}

tgws_churn_hour_count() {
    local cutoff cnt ts
    cutoff=$(( $(now) - 3600 ))
    cnt=0
    [ -f "$TG_CHURN_HISTORY" ] || { echo 0; return; }
    while read -r ts; do
        [ -n "$ts" ] || continue
        [ "$ts" -ge "$cutoff" ] 2>/dev/null && cnt=$((cnt + 1))
    done <"$TG_CHURN_HISTORY"
    echo "$cnt"
}

# Отметка «перезапуск сделан»: счётчик подряд, метка времени и история за час.
tgws_churn_note() {
    local s
    s=$(( $(tgws_churn_streak) + 1 ))
    [ "$s" -gt 6 ] && s=6
    printf '%s\n' "$s" >"$TG_CHURN_STREAK" 2>/dev/null
    date +%s >>"$TG_CHURN_HISTORY" 2>/dev/null
    tail -n 20 "$TG_CHURN_HISTORY" >"$TG_CHURN_HISTORY.tmp" 2>/dev/null \
        && mv "$TG_CHURN_HISTORY.tmp" "$TG_CHURN_HISTORY" 2>/dev/null
    date +%s >"$TG_CHURN_LAST" 2>/dev/null
}

# Метрики в норме: счётчик подряд-деградаций сбрасываем (пауза снова базовая).
tgws_churn_ok() {
    [ "$(tgws_churn_streak)" = 0 ] && return 0
    printf '0\n' >"$TG_CHURN_STREAK" 2>/dev/null
    log "tg-ws-proxy пришёл в норму — счётчик перезапусков сброшен"
}

# Перезапуск прокси с запасным путём: systemd, при отказе — pkill + start.
tgws_restart() {
    local unit
    unit=$(tg_unit)
    TG_RESTARTED=1
    if systemctl --user restart "$unit" >/dev/null 2>&1; then
        sleep 5
        return 0
    fi
    log "systemctl restart $unit не удался — перезапускаю через pkill"
    pkill -x tg-ws-proxy >/dev/null 2>&1
    sleep 1
    systemctl --user start "$unit" >/dev/null 2>&1 || return 1
    sleep 4
    return 0
}

tgws_cfproxy_on() {
    [ -f "$TG_CONF" ] || return 1
    [ "$(jq -r '.cfproxy // false' "$TG_CONF" 2>/dev/null)" = "true" ]
}

# Можно ли трогать флаг cfproxy: после своего выключения не трогаем 6 ч, чтобы
# не спорить с человеком, который вернул его руками.
tgws_cf_allowed() {
    local next
    [ -f "$TG_CHURN_CF" ] || return 0
    next=$(cat "$TG_CHURN_CF" 2>/dev/null || echo 0)
    case "$next" in *[!0-9]*|"") return 0 ;; esac
    [ "$(now)" -ge "$next" ]
}

# cfproxy=false с бэкапом конфига. Мёртвый пул Cloudflare — источник шторма:
# каждый запрос идёт в неотвечающий узел, повторяется и оставляет сокеты.
# Правим копию и проверяем jq, чтобы не оставить Telegram без прокси вовсе.
tgws_cf_disable() {
    local bak
    bak="$TG_CONF.bak-$(date '+%Y%m%d-%H%M%S')"
    cp -p "$TG_CONF" "$bak" 2>/dev/null \
        || { log "не удалось сделать бэкап $TG_CONF — cfproxy не трогаю"; return 1; }
    if jq '.cfproxy = false' "$TG_CONF" >"$TG_CONF.tmp" 2>/dev/null \
        && jq -e '.cfproxy == false' "$TG_CONF.tmp" >/dev/null 2>&1; then
        mv "$TG_CONF.tmp" "$TG_CONF" 2>/dev/null \
            && chmod 600 "$TG_CONF" 2>/dev/null
        printf '%s\n' "$(( $(now) + TG_CHURN_CF_WAIT ))" >"$TG_CHURN_CF" 2>/dev/null
        log "cfproxy выключен (бэкап $bak): пул Cloudflare мёртв, а каждый ретрай в него — лишний сокет"
        return 0
    fi
    rm -f "$TG_CONF.tmp" 2>/dev/null
    log "не удалось выставить cfproxy=false — конфиг не меняю (бэкап $bak)"
    return 1
}

# Шаг лечения «churn»: процесс жив и формально работает, но копит ресурсы.
# Зовётся из cmd_check до лечения Telegram, поэтому срабатывает и в прогоне,
# где `broken_services_quiet` пуст (Telegram уходит в H2-fallback).
# Возврат: 0 — метрики в норме или мера применена, 1 — деградация осталась.
tgws_churn_fix() {
    local state fd cw syn per_min reasons last hour wait_sec after

    tg_installed || return 0
    guard_expired && { log "дедлайн прогона — churn-шаг отложен"; return 1; }
    state=$(tgws_churn_state) || return 0        # прокси не запущен — не наше дело
    read -r fd cw syn per_min <<<"$state"

    reasons=$(tgws_churn_reasons "$fd" "$cw" "$syn" "$per_min")
    if [ -z "$reasons" ]; then
        tgws_churn_ok
        return 0
    fi
    log "tg-ws-proxy деградирует: $reasons (fd $fd, ошибок $per_min/мин за $((TG_CHURN_WINDOW / 60)) мин)"

    last=$(cat "$TG_CHURN_LAST" 2>/dev/null || echo 0)
    case "$last" in *[!0-9]*|"") last=0 ;; esac
    wait_sec=$(tgws_churn_wait "$(tgws_churn_streak)")
    if [ "$last" -gt 0 ] && [ $(( $(now) - last )) -lt "$wait_sec" ]; then
        log "перезапуск tg-ws-proxy на паузе ещё $(( (wait_sec - $(now) + last) / 60 )) мин (бэкофф $((wait_sec / 60)) мин)"
        return 1
    fi

    hour=$(tgws_churn_hour_count)

    # Два перезапуска за час не помогли — виноват не процесс, а мёртвый пул
    # Cloudflare: выключаем cfproxy (Telegram остаётся на H2/прямом WS).
    if [ "$hour" -ge 2 ] && tgws_cfproxy_on; then
        if ! tgws_cf_allowed; then
            log "cfproxy включали после нашего выключения — до $(date -d "@$(cat "$TG_CHURN_CF" 2>/dev/null)" '+%F %T' 2>/dev/null) флаг не трогаю"
        elif tgws_cf_disable; then
            tgws_restart || log "прокси после смены cfproxy не перезапустился"
            tgws_churn_note
            notify "tg-ws-proxy: отключил пул Cloudflare (cfproxy) — перезапуски не помогали. Вернуть: cfproxy=true в ~/.config/TgWsProxy/config.json"
            after=$(tgws_churn_state 2>/dev/null || echo "? ? ? ?")
            log "после выключения cfproxy: fd/close-wait/syn-sent/ошибки = $after (ошибки считаются за окно, часть — до перезапуска)"
            return 0
        fi
    fi

    if [ "$hour" -ge "$TG_CHURN_MAX_HOUR" ]; then
        log "перезапусков tg-ws-proxy за час уже $hour (лимит $TG_CHURN_MAX_HOUR) — оставляю как есть"
        notify "tg-ws-proxy повторно деградирует: $reasons. Перезапуски не помогают — нужен разбор руками."
        return 1
    fi

    tgws_churn_note
    log "перезапускаю tg-ws-proxy (перезапусков за час: $((hour + 1)))"
    notify "tg-ws-proxy накапливал ресурсы ($reasons): перезапустил"
    if ! tgws_restart; then
        log "tg-ws-proxy не перезапустился (systemctl и pkill не помогли)"
        return 1
    fi
    after=$(tgws_churn_state 2>/dev/null || echo "? ? ? ?")
    log "после перезапуска: fd/close-wait/syn-sent/ошибки = $after (ошибки — за окно $((TG_CHURN_WINDOW / 60)) мин, часть до перезапуска)"
    return 0
}

# Разбор ответа `omavpn --json heal`. Раньше вывод уходил в /dev/null, и шаг
# «heal не помог» одинаково выглядел и при reason=throttled (VPN не трогали —
# не чаще раза в 10 минут), и при dead-ноде: guard шёл дальше по лечению,
# считая, что мера применена и не сработала.
heal_vpn() {
    local out rc reason errf tail_out
    errf="$STATE_DIR/heal.err"
    out=$(timeout "$HEAL_TIMEOUT" "$OMAVPN" --json heal 2>"$errf")
    rc=$?
    if [ "$rc" -ne 0 ]; then
        # Раньше любой ненулевой код назывался «таймаутом»: настоящая ошибка
        # (например, не собрался конфиг) выглядела как исчерпанный бюджет, и по
        # логу нельзя было понять, что чинить. 124 — единственный код timeout(1).
        tail_out=$( { printf '%s' "$out"; tail -c 300 "$errf" 2>/dev/null; } \
            | tr '\n' ' ' | tr -s ' ' | cut -c1-300 )
        rm -f "$errf"
        if [ "$rc" -eq 124 ]; then
            log "omavpn heal: таймаут $HEAL_TIMEOUT с — не успел за бюджет"
        else
            log "omavpn heal: ошибка, код $rc${tail_out:+ — $tail_out}"
        fi
        return 1
    fi
    rm -f "$errf"
    reason=$(json_field "$out" reason)
    case "$reason" in
        "")        log "omavpn heal выполнен: $(json_actions "$out")" ;;
        throttled) log "omavpn heal на паузе (не чаще раза в 10 мин) — иду дальше"; return 1 ;;
        vpn_off)   log "omavpn heal: VPN выключен и не запущен"; return 1 ;;
        deadline)  log "omavpn heal упёрся в дедлайн перебора нод: $(json_actions "$out")"; return 1 ;;
        *)         log "omavpn heal: причина «$reason» $(json_actions "$out")" ;;
    esac
    return 0
}

heal() {
    local mode broken svc fixed=0 path_vpn

    mode=$(autotune_mode)
    path_vpn=$(vpn_mode)
    log "лечение: путь $(path_now), режим VPN $path_vpn, autotune=$mode, zapret=$(zapret_active && echo on || echo off)"

    if [ "$VPN_BLOCKED" = 1 ]; then
        # VPN не поднять (нет caps/sing-box): не выходим, лечим остальное.
        log "VPN-шаги пропущены: (нет cap_net_admin/sing-box)"
    elif ! vpn_alive; then
        if vpn_up; then log "VPN поднят"; else log "VPN не поднимается"; return 1; fi
    fi

    # --- YouTube: сначала прямой путь, потом всё остальное -------------------
    # Пробы ниже (`broken_services_quiet`) идут по ТЕКУЩЕМУ маршруту: пока
    # страница открывается через proxy, они отвечают «всё уже работает», и heal
    # выходил, не переведя видео-домены в туннель (15:53:50 → 15:54:03: группа
    # так и осталась на direct). Здесь решение принимается по прямому пути:
    # обход не пропускает YouTube — вся группа идёт в VPN, и результат
    # проверяется пробами через туннель, а не флагами.
    if [ "$VPN_BLOCKED" = 0 ] && yt_group_needs_vpn; then
        if ! can_switch; then
            # Тот же COOLDOWN, что у прежней крайней меры: не дёргаем путь чаще
            # раза в 15 минут. Сам перевод идемпотентен, так что ожидание ничего
            # не ломает — оверрайды останутся до следующего прогона.
            log "обход не пропускает YouTube, но смена пути на кулдауне — жду следующего прогона"
        else
            log "обход не пропускает YouTube (${YT_PROBE_REASON:-прямой путь не отвечает}) — перевожу группу доменов в VPN"
            # Возврат кода, а не stdout: функция пишет в лог сама, а результат
            # отдаёт кодом (0 — переведено, 2 — уже в VPN, 1 — ошибка).
            yt_group_to_vpn
            case $? in
                0) note_switch ;;
                2) log "группа YouTube уже целиком в VPN" ;;
                *) log "не удалось записать оверрайды группы — продолжаю общим лечением" ;;
            esac
            yt_probe_reset          # маршруты изменились — разбор ответа устарел
            # Один перезапуск на пачку: оверрайды ставились с --no-restart.
            vpn_restart
            # Успех — это два проверенных факта: группа действительно в туннеле
            # (по правилам, а не по нашему намерению) и YouTube через него
            # работает. Иначе «группа переведена» было бы обещанием, а не фактом.
            if ! yt_probe_run; then
                log "группа записана, но состояние маршрутов не подтвердилось — продолжаю общим лечением"
            elif [ "$YT_PROBE_GROUP_DIRECT" -ne 0 ]; then
                log "в туннель ушло не всё ($YT_PROBE_GROUP_DIRECT дом. группы ещё на direct) — продолжаю общим лечением"
            elif svc_youtube_ok; then
                log "обход не пропускает YouTube — группа переведена в VPN, YouTube работает"
                fixed=1
                return 0
            else
                log "через VPN YouTube тоже не работает — иду общим лечением (ноды/перебор)"
            fi
        fi
    fi

    broken=$(broken_services_quiet)
    [ -n "$broken" ] || { log "всё уже работает"; return 0; }

    # Telegram — своя логика: локальный прокси, VPN только как последнее средство
    if [[ " $broken " == *" telegram "* ]]; then
        if restart_tg; then
            broken=$(broken_services_quiet)
            log "помог перезапуск tg-ws-proxy${broken:+, осталось: $broken}"
            [ -z "$broken" ] && return 0
        else
            log "tg-ws-proxy не ожил — проверю через VPN"
            [ "$VPN_BLOCKED" = 1 ] || vpn_up
        fi
    fi

    # Общие меры для YouTube/Discord. VPN-шаги (heal_vpn, ноды, подъём VPN,
    # оверрайд с перезапуском) при VPN_BLOCKED пропускаются: их нечем выполнить,
    # а перебор стратегий zapret и запрос rescan — можно и нужно.
    if [[ " $broken " == *" youtube "* || " $broken " == *" discord "* ]]; then
        if [ "$VPN_BLOCKED" = 1 ]; then
            log "VPN-шаги пропущены — лечу обходом (zapret)"
        else
            heal_vpn
            wait_vpn
            if health_ok_quiet; then log "помогло: omavpn heal"; return 0; fi
        fi

        if [ "$mode" = "vpn" ]; then
            if [ "$VPN_BLOCKED" = 1 ]; then
                log "autotune считает, что нужен VPN, а VPN поднять нечем — только перебор"
                request_rescan && wait_rescan_result && { log "помог перебор стратегий"; return 0; }
            else
                log "autotune считает, что нужен VPN — перебираю ноды"
                try_nodes && return 0
            fi
        else
            log "autotune в режиме стратегии $mode — прошу перебор"
            if request_rescan; then
                wait_rescan_result && { log "помог перебор стратегий"; return 0; }
            fi
            if [ "$VPN_BLOCKED" = 0 ]; then
                log "перебор не помог — пробую VPN"
                if vpn_up && try_nodes; then return 0; fi
            fi
        fi

        # Крайняя мера: увести сломанный сервис в VPN оверрайдом маршрута.
        # Дедлайн проверяем ДО пробы обхода (до 75 с): после долгого
        # wait_rescan_result её не хватало, прогон вылезал за бюджет и
        # mark_fail записывал неудачу за «не успели», а не за «не помогло».
        if guard_expired; then
            log "крайняя мера: внутренний дедлайн прогона ($GUARD_DEADLINE с) — оверрайд не ставлю"
        elif [ "$VPN_BLOCKED" = 1 ]; then
            log "крайняя мера (оверрайд в VPN) недоступна: VPN не поднять"
        elif [ "$(switches_last_hour)" -ge 3 ]; then
            log "путь переключался 3+ раза за час — не воюю с autotune"
        elif ! can_switch; then
            log "ручная смена пути на кулдауне"
        elif ! direct_file_settled; then
            log "autotune только что писал direct_domains — не вмешиваюсь"
        else
            for svc in $broken; do
                case "$svc" in
                    youtube)
                        # Группа, а не youtube.com: видео-домены (googlevideo,
                        # ytimg…) стоят в direct-правиле встроенным списком, и
                        # оверрайд одного youtube.com их не вытаскивал — страница
                        # шла через VPN, видео продолжало упираться в мёртвый
                        # обход. Признак — проверенный прямой путь, а не сам факт
                        # «страница не открылась»: при живой сети и мёртвой ноде
                        # виноват туннель, и уводить в него видео нельзя.
                        case "$(yt_direct_state)" in
                            bad)
                                yt_group_to_vpn
                                case $? in
                                    0) note_switch; fixed=1
                                       log "YouTube переведён на VPN целиком (группа доменов)" ;;
                                    2) log "YouTube уже целиком идёт через VPN — переключать нечего" ;;
                                    *) : ;;
                                esac
                                ;;
                            ok)
                                log "YouTube: обход пропускает — сломан туннель, группу не перевожу"
                                ;;
                            *)
                                log "YouTube: прямой путь не проверен — группу не перевожу"
                                ;;
                        esac
                        ;;
                    discord)
                        if [ "$(route_path_of discord.com)" = "direct" ]; then
                            route_force discord.com proxy "аудит: guard — обход не тянет"
                            case $? in
                                0) note_switch; fixed=1
                                   log "Discord переведён на VPN (route override)" ;;
                                2) log "Discord уже идёт через VPN — переключать нечего" ;;
                                *) : ;;
                            esac
                        fi
                        ;;
                esac
            done
            if [ "$fixed" = "1" ]; then
                # оверрайды ставились с --no-restart: один перезапуск на пачку
                vpn_restart
                health_ok_quiet && return 0
            fi
        fi
    fi

    log "лечение не помогло: $(broken_services_quiet)"
    return 1
}

# --- бэкофф ----------------------------------------------------------------

streak() {
    local s
    s=$(cat "$STREAK_FILE" 2>/dev/null || echo 0)
    case "$s" in *[!0-9]*|"") echo 0 ;; *) echo "$s" ;; esac
}

in_backoff() {
    [ -f "$NEXT_TRY_FILE" ] || return 1
    local next_try
    next_try=$(cat "$NEXT_TRY_FILE" 2>/dev/null || echo 0)
    [ "$(now)" -lt "${next_try:-0}" ]
}

mark_fail() {
    local s delay
    s=$(( $(streak) + 1 ))
    [ "$s" -gt 10 ] && s=10
    printf '%s\n' "$s" >"$STREAK_FILE"
    if [ "$s" -ge 3 ]; then
        delay=$(( 900 * (1 << (s - 3)) ))
        [ "$delay" -gt "$MAX_BACKOFF" ] && delay=$MAX_BACKOFF
        printf '%s\n' "$(( $(now) + delay ))" >"$NEXT_TRY_FILE"
        log "неудач подряд: $s — пауза $((delay / 60)) мин"
        [ "$s" -eq 3 ] && notify "Обходы не работают: $(broken_services_quiet). Автолечение не помогло."
    fi
}

mark_ok() {
    printf '0\n' >"$STREAK_FILE"
    rm -f "$NEXT_TRY_FILE"
}

reset_on_net_change() {
    local key prev
    key=$(net_key)
    prev=$(cat "$LAST_NET_FILE" 2>/dev/null || echo "")
    if [ "$key" != "$prev" ]; then
        printf '%s\n' "$key" >"$LAST_NET_FILE" 2>/dev/null
        if [ -n "$prev" ]; then
            rm -f "$NEXT_TRY_FILE" 2>/dev/null
            printf '0\n' >"$STREAK_FILE" 2>/dev/null
            log "сеть сменилась ($prev → $key) — счётчик неудач сброшен"
        fi
    fi
}

# --- режимы ----------------------------------------------------------------

cmd_autostart() {
    local want
    want=$(intent_read)
    if [ "$want" = "on" ] && ! vpn_alive; then
        log "автозапуск: VPN был включён — поднимаю"
        vpn_up || { log "автозапуск: поднять VPN не удалось"; notify "VPN не поднялся при входе"; }
    fi
    # caps нужны только TUN: в режиме proxy sing-box не запускается, и ругаться
    # «VPN не поднимется без пароля» там не за что.
    if tun_needed; then
        case "$(caps_state)" in
            nocaps)
                log "ВНИМАНИЕ: у sing-box нет cap_net_admin"
                notify "У sing-box нет cap_net_admin: VPN не поднимется без пароля" ;;
            nobin)
                log "ВНИМАНИЕ: нет $SB_BIN — TUN поднимать нечем"
                notify "Нет sing-box ($SB_BIN): VPN не поднимется" ;;
        esac
    fi
}

cmd_status() {
    # --status зовут для отладки, а не для лечения: одна попытка на запрос и
    # таймаут 4 с (было 8 с и без повторов — ответ шёл около минуты).
    CURL_T=4
    HTTP_TRIES=1
    # `route list` в статусе — 5 с, а не 20: иначе «быстрый» вывод подвисал до
    # ~25 с и «без блокировки» (без общего flock) читалось как «мгновенно».
    ROUTE_T=5
    printf '{"vpn_alive":%s,"tun_up":%s,"mode":"%s","intent":"%s","path":"%s","autotune":"%s","zapret":%s,"caps_ok":%s,"caps":"%s","streak":%s,"broken":"%s"}\n' \
        "$(vpn_alive && echo true || echo false)" \
        "$(tun_up && echo true || echo false)" \
        "$(vpn_mode)" \
        "$(intent_read)" \
        "$(path_now)" \
        "$(autotune_mode)" \
        "$(zapret_active && echo true || echo false)" \
        "$(caps_ok && echo true || echo false)" \
        "$(caps_state)" \
        "$(streak)" \
        "$(broken_services_quiet)"
}

cmd_check() {
    local want broken caps

    reset_on_net_change
    want=$(intent_update)

    # Перебор стратегий временно останавливает zapret и перезапускает VPN:
    # проверки в этот момент видят «сломано всё» и копят ложные неудачи.
    # Пропускаем прогон целиком — ни лечения, ни паузы.
    if autotune_testing; then
        log "идёт перебор стратегий zapret — проверку пропускаю"
        return 0
    fi

    # caps нужны только для TUN. В режиме proxy их отсутствие — не поломка:
    # Telegram (локальный прокси) и VPN через socks работают и без них.
    # Выходить из прогона нельзя: раньше `return 1` здесь отменял вообще всё
    # лечение, хотя перезапуск tg-ws-proxy и перебор стратегий zapret caps не
    # требуют. Теперь помечаем VPN-шаги запрещёнными и идём дальше.
    caps=$(caps_state)
    VPN_BLOCKED=0
    if [ "$caps" != "ok" ] && tun_needed; then
        VPN_BLOCKED=1
        case "$caps" in
            nobin)
                log "нет $SB_BIN — TUN поднять нечем (переустанови omavpn); VPN-шаги пропускаю"
                notify "VPN не поднимется: не найден sing-box" ;;
            *)
                log "нет cap_net_admin у sing-box — нужен sudo setcap; VPN-шаги пропускаю"
                notify "VPN не может подняться: у sing-box нет cap_net_admin" ;;
        esac
    fi

    # Бэкофф действует и при want=on с мёртвым VPN. Раньше из этого правила
    # делали исключение, и полное лечение (heal + ноды + перезапуск) шло каждые
    # 10 минут без роста паузы: одна и та же поломка молотила бесконечно, а
    # журнал пух. Счётчик при этом сбрасывается при смене сети, так что первый
    # прогон после входа паузы не ждёт.
    if in_backoff; then
        log "пауза после неудач — пропускаю до $(date -d "@$(cat "$NEXT_TRY_FILE")" '+%F %T' 2>/dev/null)"
        return 0
    fi

    if [ "$want" = "on" ] && [ "$VPN_BLOCKED" = 0 ]; then
        if ! vpn_consistent; then
            log "VPN числится живым, но xray мёртв — перезапускаю"
            vpn_restart
        fi
        if ! vpn_alive; then
            log "VPN должен быть включён, но не отвечает (режим $(vpn_mode)) — поднимаю"
            vpn_up || log "VPN не поднялся"
        fi
    fi

    # Накопление ресурсов tg-ws-proxy. Стоит ДО проверки сломанных сервисов:
    # деградация видна только по счётчикам (fd, CLOSE-WAIT, ошибки в логе), а
    # проба Telegram при этом проходит — трафик уходит в H2-fallback, и раньше
    # процесс доходил до сотен fd, оставаясь «рабочим». guard_expired проверяется
    # внутри шага, второй раз здесь не нужен.
    tgws_churn_fix

    # Авто-возврат YouTube на обход: если наши оверрайды группы стоят, а обход
    # снова тянет — снять их. Стоит до проверки сломанных сервисов: возврат нужен
    # и в прогоне, где всё работает, иначе YouTube остался бы в туннеле навсегда
    # после одной плохой сети. Провал сервисов лечится ниже, но сначала — возврат:
    # лечить то, что и так должно уйти из туннеля, незачем.
    yt_maybe_return

    broken=$(broken_services_quiet)
    if [ -z "$broken" ] && [ "$VPN_BLOCKED" = 0 ] && yt_group_needs_vpn; then
        # Пробы по текущему пути прошли, а обход YouTube не пропускает: видео
        # пойдёт по мёртвому direct. Это поломка, а не «всё в порядке» — иначе
        # правило не срабатывало ровно в этом сценарии.
        broken="youtube"
        log "прямой путь YouTube не работает (${YT_PROBE_REASON:-проба}) — лечение нужно, хотя пробы проходят"
    fi
    if [ -z "$broken" ]; then
        mark_ok
        log "всё в порядке (путь $(path_now), autotune $(autotune_mode), режим $(vpn_mode))"
        return 0
    fi

    if [ "$want" = "off" ] && ! vpn_alive; then
        # VPN выключен пользователем: сначала чиним каждый сервис по его природе,
        # VPN — только если обход действительно не тянет.
        log "VPN выключен, не работают:$broken — чиню без VPN"
        if [[ " $broken " == *" telegram "* ]] && restart_tg; then
            broken=$(broken_services_quiet)
            [ -z "$broken" ] && { mark_ok; log "Telegram поднялся перезапуском прокси"; return 0; }
        fi
        if [[ " $broken " == *" youtube "* || " $broken " == *" discord "* ]]; then
            if request_rescan && wait_rescan_result; then
                mark_ok
                log "обход починился без VPN"
                return 0
            fi
        fi
        # Перед включением VPN проверяем ещё раз: за время перебора (до 20 мин)
        # сеть могла ожить сама, и поднимать туннель вопреки выключению не за что.
        broken=$(broken_services_quiet)
        if [ -z "$broken" ]; then
            mark_ok
            log "сервисы заработали сами — VPN не трогаю"
            return 0
        fi
        log "обход не тянет (не работают:$broken) — поднимаю VPN"
        if [ "$VPN_BLOCKED" = 1 ]; then
            log "VPN-шаги запрещены (нет cap_net_admin/sing-box) — поднять нечем"
            mark_fail
            return 1
        fi
        if vpn_up && health_ok_quiet; then
            mark_ok
            notify "Обход в этой сети не справляется, включил VPN"
            return 0
        fi
        mark_fail
        return 1
    fi

    # Дедлайн проверяем ДО лога: `path_now` — это `omavpn route list` (до 20 с),
    # и на исчерпанном бюджете он тратил бы время впустую. Путь всё равно
    # напишет heal(); здесь достаточно режима.
    if guard_expired; then
        log "внутренний дедлайн прогона ($GUARD_DEADLINE с) — лечение откладываю (не работают:$broken)"
        # Это не «всё хорошо»: иначе каждый тик снова упирался бы в дедлайн.
        mark_fail
        return 1
    fi
    # Диагностика: при want=on heal запускается сразу, и в логе раньше не было
    # видно, что именно сломано — только «лечение не помогло» в конце.
    log "не работают:$broken — запускаю лечение (режим $(vpn_mode))"
    if heal; then
        mark_ok
        return 0
    fi

    mark_fail
    return 1
}

# --- точка входа -----------------------------------------------------------

if [ "${1:-}" = "--status" ]; then
    cmd_status
    exit 0
fi

exec 9>"$LOCK"
if [ "${1:-}" = "--autostart" ]; then
    # Ждём лок с повторами до AUTOSTART_LOCK_WAIT: прогон guard может идти до
    # RESCAN_WAIT (20 мин), и раньше автозапуск отваливался через 120 с молча —
    # VPN после входа так и не поднимался.
    deadline=$(( $(now) + AUTOSTART_LOCK_WAIT ))
    until flock -w 30 9; do
        if [ "$(now)" -ge "$deadline" ]; then
            log "автозапуск: лок занят дольше $((AUTOSTART_LOCK_WAIT / 60)) мин — пропуск"
            notify "VPN не поднят при входе: другой прогон держит блокировку"
            exit 0
        fi
        log "автозапуск: лок занят, жду (до $(( (deadline - $(now)) / 60 )) мин)"
    done
else
    if ! flock -n 9; then
        log "пропуск: идёт другой прогон"
        exit 0
    fi
fi

case "${1:-}" in
    --autostart) cmd_autostart ;;
    *)           cmd_check ;;
esac
