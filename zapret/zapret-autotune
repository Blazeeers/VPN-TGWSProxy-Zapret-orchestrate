  chmod 644 "$GOOGLE" "$ULIST"
}

# --- сеть -------------------------------------------------------------------
wan_iface() {
  ip -o route show default 2>/dev/null | awk '{
    d="";
    for (i=1;i<=NF;i++) if ($i=="dev") d=$(i+1);
    if (d!="" && d!="omavpn0" && d!="tailscale0" && d !~ /^tun/) { print d; exit }
  }'
}

netkey() {
  local iface ssid gw mac key
  iface="$(wan_iface)"
  [ -n "$iface" ] || iface="unknown"
  ssid=""
  case "$iface" in
    wl*|wlan*|wlp*) ssid="$(iwgetid -r "$iface" 2>/dev/null || true)" ;;
  esac
  [ -n "$ssid" ] || ssid="$(nmcli -t -f GENERAL.CONNECTION device show "$iface" 2>/dev/null | cut -d: -f2-)"
  if [ -n "$ssid" ] && [ "$iface" != "unknown" ]; then
    key="wifi-${ssid}"
  else
    gw="$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')"
    mac="$(ip neigh show "$gw" 2>/dev/null | awk '/lladdr/{print $5; exit}')"
    key="net-${iface}-${mac:-$gw}"
  fi
  printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_'
}

set_wan() {
  local w; w="$(wan_iface)"
  [ -n "$w" ] || return 1
  python3 - "$CFG" "$w" <<'PY'
import re, sys
cfg, wan = sys.argv[1], sys.argv[2]
t = open(cfg).read()
if re.search(r'^#?\s*IFACE_WAN=', t, re.M):
    t = re.sub(r'^#?\s*IFACE_WAN=.*$', f'IFACE_WAN="{wan}"', t, count=1, flags=re.M)
else:
    t += f'\nIFACE_WAN="{wan}"\n'
open(cfg, 'w').write(t)
PY
  log "WAN=$w"
}

# --- проверки ---------------------------------------------------------------
ok_url() {
  local code
  for _ in 1 2; do
    code="$(curl -4 -s -o /dev/null -w '%{http_code}' --max-time 8 "$1" 2>/dev/null)"
    case "$code" in 2??|3??) return 0 ;; esac
  done
  return 1
}
test_targets() { ok_url https://www.youtube.com/ && ok_url https://discord.com/; }

# --- изолированный пробник --------------------------------------------------
probe_uid() {
  [ -n "$PROBE_UID" ] || PROBE_UID="$(id -u "$PROBE_USER" 2>/dev/null || true)"
  printf '%s' "$PROBE_UID"
}
probe_setup() {
  local uid; uid="$(probe_uid)"
  [ -n "$uid" ] || return 1
  if ! ip rule show 2>/dev/null | grep -q "uidrange $uid-$uid"; then
    ip rule add uidrange "$uid-$uid" lookup main pref "$PROBE_RULE_PREF" 2>/dev/null || return 1
  fi
  PROBE_ACTIVE=1
  return 0
}
probe_teardown() {
  [ "$PROBE_ACTIVE" = 1 ] || return 0
  local uid; uid="$(probe_uid)"
  [ -n "$uid" ] && ip rule del uidrange "$uid-$uid" lookup main pref "$PROBE_RULE_PREF" 2>/dev/null || true
  PROBE_ACTIVE=0
}
probe_ok_url() {
  local code
  for _ in 1 2; do
    code="$(runuser -u "$PROBE_USER" -- env HOME=/tmp "$CURL_BIN" -4 -s -o /dev/null \
      -w '%{http_code}' --max-time 8 "$1" 2>/dev/null)"
    case "$code" in 2??|3??) return 0 ;; esac
  done
  return 1
}
probe_test_targets() { probe_ok_url https://www.youtube.com/ && probe_ok_url https://discord.com/; }
probe_youtube_direct() { probe_ok_url https://www.youtube.com/; }
probe_discord_direct() { probe_ok_url https://discord.com/; }
probe_show_ips() {
  local host_ip probe_ip
  host_ip="$(curl -s --max-time 12 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p')"
  probe_ip="$(runuser -u "$PROBE_USER" -- env HOME=/tmp "$CURL_BIN" -s --max-time 12 \
    https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p')"
  echo "host  IP: ${host_ip:-?}   (VPN)"
  echo "probe IP: ${probe_ip:-?}   (напрямую)"
  if [ -n "$host_ip" ] && [ -n "$probe_ip" ] && [ "$host_ip" != "$probe_ip" ]; then
    echo "изоляция: OK (адреса различаются)"
  else
    echo "изоляция: НЕ подтверждена (проверь правила/маршрут)"
  fi
}

# Состояние подбора для виджета: <кэш>/probe.json (читает bypass-status).
probe_state_write() { # $1 индекс, $2 всего, $3 стратегия, $4 изолированно(1/0), $5 текст
  python3 - "$PROBE_STATE" "$1" "$2" "$3" "$4" "${5:-}" <<'PY' 2>/dev/null || true
import json, sys, time
path, index, total, strategy, isolated, text = sys.argv[1:7]
json.dump({"active": True, "index": int(index), "total": int(total),
           "strategy": strategy, "isolated": isolated == "1", "text": text,
           "updated": time.time()}, open(path, "w"), ensure_ascii=False)
PY
  chmod 644 "$PROBE_STATE" 2>/dev/null || true
}
probe_state_clear() { rm -f "$PROBE_STATE" 2>/dev/null || true; }

# Периодическая перепроверка обхода в режиме vpn.
scan_due() { # $1 ключ сети; 0 = пора перепроверять
  local f="$CACHE/$1.lastscan" now last
  now="$(date +%s)"
  last="$(cat "$f" 2>/dev/null || echo 0)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $((now - last)) -ge "$RETRY_SECONDS" ]
}
mark_scan() { # $1 ключ сети
  date +%s > "$CACHE/$1.lastscan" 2>/dev/null || true
  chmod 644 "$CACHE/$1.lastscan" 2>/dev/null || true
}

# --- zapret -----------------------------------------------------------------
hosts_for() { # $1 сервисы -> "--hostlist=... --hostlist=..."
  local h=""
  case "$1" in *youtube*) h="$h --hostlist=$GOOGLE" ;; esac
  case "$1" in *discord*) h="$h --hostlist=$ULIST" ;; esac
  printf '%s' "$h"
}
build_opt() { # $1 кандидат, $2 сервисы ("youtube discord" | "youtube" | "discord")
  local h; h="$(hosts_for "$2")"
  cat <<EOF
--filter-tcp=443 $h $1 --new
--filter-tcp=80 --dpi-desync=fake,multisplit --dpi-desync-split-pos=method+2 --dpi-desync-fooling=md5sig $h --new
--filter-udp=443 $h --dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fake-quic=$F/quic_initial_www_google_com.bin
EOF
}

# set_opt <полный NFQWS_OPT>; return 0 если изменено, 1 если уже так
set_opt() {
  local optf rc
  optf="$(mktemp /tmp/zapret-autotune.opt.XXXXXX)"
  printf '%s\n' "$1" > "$optf"
  python3 - "$CFG" "$optf" <<'PY'
import re, sys
cfg, optf = sys.argv[1], sys.argv[2]
opt = open(optf).read().strip()
t = open(cfg).read()
m = re.search(r'NFQWS_OPT="(.*?)"', t, re.S)
cur = m.group(1).strip() if m else ""
if cur == opt:
    sys.exit(3)
if m:
    t = t[:m.start()] + 'NFQWS_OPT="' + opt + '"' + t[m.end():]
else:
    t = t.rstrip() + '\nNFQWS_OPT="' + opt + '"\n'
open(cfg, 'w').write(t)
PY
  rc=$?; rm -f "$optf"
  [ "$rc" = 3 ] && return 1
  return 0
}

activate() {
  systemctl restart zapret.service >/dev/null 2>&1
  sleep 2
  systemctl is-active --quiet zapret.service
}

ensure_zapret_on() {
  systemctl is-active --quiet zapret.service || activate
}

zapret_off() { systemctl stop zapret.service >/dev/null 2>&1 || true; }

# --- omavpn -----------------------------------------------------------------
full_direct() {
  [ -n "$USER_NAME" ] || return 0
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" python3 - "$OMAVPN" <<'PY' 2>/dev/null
import importlib.machinery, importlib.util, sys
p = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("omavpn", p)
spec = importlib.util.spec_from_loader("omavpn", loader)
m = importlib.util.module_from_spec(spec); loader.exec_module(m)
print("\n".join(m.DEFAULT_DIRECT_DOMAINS))
PY
}

# Запись в файл пользователя выполняется от его UID (runuser): root не должен
# следовать по пользовательской симлинк-ссылке и менять владельца её цели.
user_write() { # stdin -> файл $1, от имени $USER_NAME
  [ -n "$USER_NAME" ] || return 1
  runuser -u "$USER_NAME" -- tee "$1" >/dev/null
}
user_remove() {
  [ -n "$USER_NAME" ] || return 0
  runuser -u "$USER_NAME" -- rm -f -- "$1" 2>/dev/null || true
}

# ensure_direct <содержимое>; ставит DIRECT_CHANGED
ensure_direct() {
  local content="$1" cur=""
  [ -n "$USER_NAME" ] || return 0
  cur="$(runuser -u "$USER_NAME" -- cat "$DIRECT_FILE" 2>/dev/null)"
  if [ "$cur" = "$content" ]; then DIRECT_CHANGED=0; return 0; fi
  printf '%s\n' "$content" | user_write "$DIRECT_FILE"
  DIRECT_CHANGED=1
}
ensure_direct_all() {
  local content; content="$(full_direct)"
  if [ -n "$content" ]; then
    ensure_direct "$content"
  elif [ -f "$DIRECT_FILE" ]; then
    user_remove "$DIRECT_FILE"; DIRECT_CHANGED=1
  else
    DIRECT_CHANGED=0
  fi
}
ensure_direct_min() { ensure_direct "max.ru"; }

# Какие сервисы выводим напрямую: "youtube" и/или "discord".
direct_domains_for() {
  local out="max.ru"
  case "$1" in *youtube*) out="$out
$(cat "$GOOGLE" 2>/dev/null)";; esac
  case "$1" in *discord*) out="$out
$(cat "$ULIST" 2>/dev/null)";; esac
  printf '%s\n' "$out"
}
set_direct() { ensure_direct "$(direct_domains_for "$1")"; }

# Кэш: стратегия + какие сервисы обрабатывает zapret + какие идут напрямую.
cache_set() { # $1 ключ, $2 стратегия, $3 сервисы zapret, $4 сервисы напрямую
  printf '%s\n' "$2" > "$CACHE/$1.strategy"
  printf '%s\n' "$3" > "$CACHE/$1.services"
  printf '%s\n' "$4" > "$CACHE/$1.direct"
  chmod 644 "$CACHE/$1.strategy" "$CACHE/$1.services" "$CACHE/$1.direct" 2>/dev/null || true
}
cache_services() { cat "$CACHE/$1.services" 2>/dev/null || echo "youtube discord"; }
cache_direct() {
  local f="$CACHE/$1.direct"
  if [ -f "$f" ]; then cat "$f"
  elif [ "$(cat "$CACHE/$1.strategy" 2>/dev/null)" = "vpn" ]; then echo ""
  else echo "youtube discord"; fi
}

omavpn_running() {
  [ -n "$USER_NAME" ] && [ -x "$OMAVPN" ] || return 1
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" XDG_RUNTIME_DIR="/run/user/$UID_N" \
    "$OMAVPN" --json status 2>/dev/null | grep -q '"running": *true'
}
omavpn_restart() {
  [ -n "$USER_NAME" ] && [ -x "$OMAVPN" ] || return 0
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" XDG_RUNTIME_DIR="/run/user/$UID_N" \
    "$OMAVPN" restart >/dev/null 2>&1 || true
}
omavpn_start() {
  [ -n "$USER_NAME" ] && [ -x "$OMAVPN" ] || return 1
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" XDG_RUNTIME_DIR="/run/user/$UID_N" \
    "$OMAVPN" on >/dev/null 2>&1 || true
}
omavpn_off() {
  [ -n "$USER_NAME" ] && [ -x "$OMAVPN" ] || return 0
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" XDG_RUNTIME_DIR="/run/user/$UID_N" \
    "$OMAVPN" off >/dev/null 2>&1 || true
}
apply_direct_change() {
  [ "$DIRECT_CHANGED" = 1 ] && omavpn_running && omavpn_restart
}
ensure_vpn() {
  if omavpn_running; then
    apply_direct_change
  elif [ "$AUTO_VPN" = 1 ]; then
    log "поднимаю VPN (omavpn on)"
    omavpn_start
    sleep 5
  fi
}

# --- стратегии (порядок = приоритет) ---------------------------------------
STRATEGIES=(
  "--dpi-desync=multisplit --dpi-desync-split-pos=sniext+1"
  "--dpi-desync=multisplit --dpi-desync-split-pos=host+1"
  "--dpi-desync=multisplit --dpi-desync-split-pos=1"
  "--dpi-desync=multisplit --dpi-desync-split-pos=midsld"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=sniext"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=sniext+3"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=midsld-1"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=1,midsld"
  "--dpi-desync=fake,multisplit --dpi-desync-split-pos=sniext+1 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake,multisplit --dpi-desync-split-pos=host+1 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake,multisplit --dpi-desync-split-pos=1 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake,multidisorder --dpi-desync-split-pos=1,midsld --dpi-desync-fooling=badseq,md5sig"
  "--dpi-desync=fake,multidisorder --dpi-desync-split-pos=sniext --dpi-desync-fooling=md5sig"
  "--dpi-desync=hostfakesplit --dpi-desync-hostfakesplit-midhost=midsld"
  "--dpi-desync=hostfakesplit --dpi-desync-hostfakesplit-mod=altorder=1"
  "--dpi-desync=fake,hostfakesplit --dpi-desync-hostfakesplit-midhost=midsld --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake --dpi-desync-ttl=1 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake --dpi-desync-ttl=3 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake --dpi-desync-ttl=7 --dpi-desync-fooling=md5sig"
  "--dpi-desync=fake --dpi-desync-fooling=md5sig --dpi-desync-fake-tls=$F/tls_clienthello_www_google_com.bin"
  "--dpi-desync=fake --dpi-desync-fooling=badseq --dpi-desync-fake-tls=$F/tls_clienthello_www_google_com.bin"
  "--dpi-desync=fakeddisorder --dpi-desync-fooling=md5sig"
  "--dpi-desync=fakedsplit --dpi-desync-fooling=md5sig"
  "--dpi-desync=multisplit --dpi-desync-split-pos=sniext+1 --dpi-desync-split-seqovl=1"
  "--dpi-desync=multisplit --dpi-desync-split-pos=2 --dpi-desync-split-seqovl=336 --dpi-desync-split-seqovl-pattern=$F/tls_clienthello_iana_org.bin"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=2 --dpi-desync-split-seqovl=1"
  "--dpi-desync=multisplit --dpi-desync-split-pos=1 --dpi-desync-split-seqovl=568 --dpi-desync-split-seqovl-pattern=$F/tls_clienthello_www_google_com.bin"
  "--dpi-desync=multidisorder --dpi-desync-split-pos=1 --dpi-desync-fooling=badseq"
)

run_scan() {
  local key="$1" cf="$2" i use_probe=0 total="${#STRATEGIES[@]}" yt_ok=0 dc_ok=0 winner="" direct=""
  probe_state_clear

  if probe_setup; then
    use_probe=1
    log "пробник: изолированный режим (uidrange $PROBE_USER -> main)"
  else
    log "пробник: недоступен ($PROBE_USER / ip rule) — перебор как раньше"
  fi

  # На время подбора держим сервисы в VPN, чтобы не ломать интернет.
  set_direct ""
  apply_direct_change
  ensure_vpn
  sleep 1

  if [ "$use_probe" = 1 ]; then
    probe_state_write 0 0 "проверка сети" 1 ""
    zapret_off
    probe_youtube_direct && yt_ok=1
    probe_discord_direct && dc_ok=1
    log "прямая проверка: youtube=$yt_ok discord=$dc_ok"

    if [ "$yt_ok" = 1 ] && [ "$dc_ok" = 1 ]; then
      log "сеть чистая: youtube и discord открываются напрямую -> zapret выключен"
      cache_set "$key" off "" "youtube discord"
      set_direct "youtube discord"; apply_direct_change; probe_teardown; probe_state_clear
      return 0
    fi

    if [ "$yt_ok" = 1 ]; then
      log "youtube работает напрямую; zapret нужен только для discord"
      set_direct "youtube"; apply_direct_change
      for i in "${!STRATEGIES[@]}"; do
        log "пробую[$i] (только discord): ${STRATEGIES[$i]}"
        probe_state_write "$i" "$total" "${STRATEGIES[$i]}" 1 ""
        if set_opt "$(build_opt "${STRATEGIES[$i]}" discord)"; then activate; else ensure_zapret_on; fi
        if probe_discord_direct; then winner="$i"; break; fi
      done
      if [ -n "$winner" ]; then
        log "стратегия для discord найдена: индекс $winner"
        cache_set "$key" "$winner" discord "youtube discord"
        set_direct "youtube discord"; apply_direct_change
      else
        log "для discord стратегия не найдена -> discord через VPN, youtube напрямую"
        zapret_off
        cache_set "$key" vpn "" "youtube"
        set_direct "youtube"; apply_direct_change
      fi
      probe_teardown; probe_state_clear
      return 0
    fi

    for i in "${!STRATEGIES[@]}"; do
      log "пробую[$i]: ${STRATEGIES[$i]}"
      probe_state_write "$i" "$total" "${STRATEGIES[$i]}" 1 ""
      if set_opt "$(build_opt "${STRATEGIES[$i]}" "youtube discord")"; then activate; else ensure_zapret_on; fi
      if probe_youtube_direct && probe_discord_direct; then winner="$i"; break; fi
    done
    if [ -n "$winner" ]; then
      log "рабочая стратегия найдена: индекс $winner (${STRATEGIES[$winner]})"
      cache_set "$key" "$winner" "youtube discord" "youtube discord"
      set_direct "youtube discord"; apply_direct_change
    else
      log "ни одна стратегия не сработала -> обход недоступен"
      zapret_off
      direct=""
      [ "$dc_ok" = 1 ] && direct="discord"
      cache_set "$key" vpn "" "$direct"
      set_direct "$direct"; apply_direct_change
    fi
    probe_teardown; probe_state_clear
    return 0
  fi

  # --- запасной перебор без изоляции (как было) ---
  ensure_direct_all
  apply_direct_change
  probe_state_write 0 0 "проверка сети" 0 ""
  zapret_off
  if test_targets; then
    log "сеть чистая: без обхода всё открывается -> zapret выключен"
    cache_set "$key" off "" "youtube discord"
    probe_state_clear
    return 0
  fi
  for i in "${!STRATEGIES[@]}"; do
    log "пробую[$i]: ${STRATEGIES[$i]}"
    probe_state_write "$i" "$total" "${STRATEGIES[$i]}" 0 ""
    if set_opt "$(build_opt "${STRATEGIES[$i]}" "youtube discord")"; then activate; else ensure_zapret_on; fi
    if test_targets; then
      log "рабочая стратегия найдена: индекс $i (${STRATEGIES[$i]})"
      cache_set "$key" "$i" "youtube discord" "youtube discord"
      probe_state_clear
      return 0
    fi
  done
  log "ни одна стратегия не сработала -> Discord/YouTube через VPN"
  zapret_off
  set_direct ""
  ensure_vpn
  if omavpn_running && test_targets; then
    log "VPN поднят — цели открываются"
  else
    log "VPN не поднялся или цели не открылись (проверь профиль/ноду omavpn)"
  fi
  cache_set "$key" vpn "" ""
  probe_state_clear
  return 0
}

apply_cached() { # $1 = стратегия из кэша, $2 = ключ сети; return 0 если ок
  local strat="$1" key="$2" optf svc direct
  svc="$(cache_services "$key")"
  direct="$(cache_direct "$key")"
  case "$strat" in
    off)
      set_direct "$direct"; apply_direct_change; zapret_off; test_targets ;;
    vpn)
      zapret_off; set_direct "$direct"; apply_direct_change; ensure_vpn
      if omavpn_running && test_targets; then log "vpn-режим: цели открываются"; else log "vpn-режим: цели не открылись"; fi
      return 0 ;;
    custom)
      optf="$CACHE/$key.opt"
      [ -s "$optf" ] || return 1
      set_direct "$direct"; apply_direct_change
      if set_opt "$(cat "$optf")"; then activate; else ensure_zapret_on; fi
      test_targets ;;
    ''|*[!0-9]*)
      return 1 ;;
    *)
      set_direct "$direct"; apply_direct_change
      if set_opt "$(build_opt "${STRATEGIES[$strat]}" "$svc")"; then activate; else ensure_zapret_on; fi
      test_targets ;;
  esac
}

run() {
  local force="${1:-}" tries=0
  while ! set_wan; do
    tries=$((tries + 1))
    if [ "$tries" -ge 3 ]; then
      log "нет физического WAN — пропуск запуска"
      return 0
    fi
    sleep 3
  done
  write_lists
  mkdir -p "$CACHE"
  local key cf strat
  key="$(netkey)"
  case "$key" in
    ""|*unknown*) log "ключ сети не определён ($key) — пропуск"; return 0 ;;
  esac
  cf="$CACHE/$key.strategy"
  log "сеть: $key"
  if [ -s "$cf" ] && [ "$force" != "force" ]; then
    strat="$(cat "$cf")"
    log "кэш: strategy=$strat, проверяю"
    if [ "$strat" = "vpn" ] && scan_due "$key"; then
      log "vpn-режим: пора перепроверить обход (${RETRY_SECONDS}s) -> переподбор"
    elif apply_cached "$strat" "$key"; then
      log "кэш работает"
      return 0
    else
      log "кэш перестал работать -> переподбор"
    fi
  fi
  run_scan "$key" "$cf"
  mark_scan "$key"
}

main() {
  if [ "${ZAPRET_AUTOTUNE_SOURCE:-0}" = 1 ]; then
    return 0 2>/dev/null || exit 0
  fi
  if [ "$(id -u)" -ne 0 ]; then
    echo "zapret-autotune: нужен root (sudo zapret-autotune ${1:-run})" >&2
    exit 1
  fi
  exec 9>"$LOCK" || exit 1
  flock -n 9 || { log "уже выполняется, пропуск"; exit 0; }
  trap 'probe_teardown; probe_state_clear' EXIT

  case "${1:-run}" in
    run)     run normal ;;
    rescan)  run force ;;
    show)    ls -1 "$CACHE" 2>/dev/null | sed 's/\.strategy$//' | while read -r k; do printf '%-40s %s\n' "$k" "$(cat "$CACHE/$k.strategy" 2>/dev/null)"; done ;;
    tune-wan) write_lists; set_wan ;;
    probe-selftest)
      write_lists
      if probe_setup; then
        echo "=== probe self-test: host и probe IP должны отличаться (host — VPN, probe — напрямую) ==="
        probe_show_ips
      else
        echo "probe setup failed: нет пользователя '$PROBE_USER' или не удалось добавить ip rule"
        exit 1
      fi
      ;;
    *) echo "Использование: zapret-autotune {run|rescan|show|tune-wan|probe-selftest}"; exit 2 ;;
  esac
}

main "$@"
