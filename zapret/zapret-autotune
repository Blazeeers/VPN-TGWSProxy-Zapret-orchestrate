#!/usr/bin/env bash
# zapret-autotune — автоматический подбор и применение стратегии обхода zapret
# под текущую сеть. Для каждой сети стратегия кэшируется. Если ни одна не
# работает — Discord/YouTube убираются из direct-списка omavpn и идут через VPN.
#
# Команды:
#   zapret-autotune run      — применить/подобрать для текущей сети (по умолчанию)
#   zapret-autotune rescan   — принудительно переподобрать для текущей сети
#   zapret-autotune show     — показать кэш сетей
#   zapret-autotune tune-wan — только выставить IFACE_WAN под текущую сеть
#
# Устанавливается установщиком zapret-autotune-install.sh. Запускается от root
# сервисом zapret-autotune.service (по смене сети и по таймеру).
set -uo pipefail

CONF=/etc/zapret-autotune.conf
CACHE=/var/lib/zapret-autotune
LOG=/var/log/zapret-autotune.log
CFG=/opt/zapret/config
F=/opt/zapret/files/fake
GOOGLE=/opt/zapret/ipset/list-google.txt
ULIST=/opt/zapret/ipset/zapret-hosts-user.txt
LOCK=/run/zapret-autotune.lock

# --- конфиг установки -------------------------------------------------------
if [ -f "$CONF" ]; then . "$CONF"; fi
USER_NAME="${USER_NAME:-}"
USER_HOME="${USER_HOME:-}"
AUTO_VPN="${AUTO_VPN:-1}"
UID_N=""
[ -n "$USER_NAME" ] && UID_N="$(id -u "$USER_NAME" 2>/dev/null || echo)"
OMAVPN="$USER_HOME/.local/bin/omavpn"
DIRECT_FILE="$USER_HOME/.config/omavpn/direct_domains.txt"
DIRECT_CHANGED=0

# Изолированный пробник: отдельный системный пользователь, чей трафик уходит
# напрямую (ip rule uidrange -> main). Боевой трафик при этом не трогается:
# пока идёт подбор, Discord/YouTube держим в VPN, а кандидатов проверяем
# только трафиком probe-пользователя.
PROBE_USER="${PROBE_USER:-zapret-probe}"
PROBE_RULE_PREF="${PROBE_RULE_PREF:-100}"
PROBE_UID=""
PROBE_ACTIVE=0
CURL_BIN="$(command -v curl 2>/dev/null || echo /usr/bin/curl)"
PROBE_STATE="$CACHE/probe.json"
# Как часто в режиме vpn перепроверять, не появился ли рабочий обход (сек).
RETRY_SECONDS="${RETRY_SECONDS:-1800}"

log() { echo "$(date '+%F %T') $*" | tee -a "$LOG" 2>/dev/null; }

# --- списки доменов ---------------------------------------------------------
